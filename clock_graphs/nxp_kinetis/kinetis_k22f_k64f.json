{
  "schema": 1,
  "id": "kinetis_k22f_k64f",
  "title": "Kinetis K22F/K64F MCG clock tree",
  "vendor": "NXP",
  "source": "K22F (K22P121M120SF7RM), K64F (K64P144M120SF5RM) reference manuals",
  "devices": ["^MK22F", "^MK64F"],
  "fosc": "core",
  "inputs": {
    "osc0": {"label": "OSC0 frequency", "default": 8000000, "min": 3000000, "max": 32000000}
  },
  "settings": ["MCG_C2.EREFS", "OSC_CR.ERCLKEN"],
  "nodes": [
    {
      "id": "osc0",
      "label": "OSC0",
      "kind": "source",
      "x": 0,
      "y": 0,
      "input": "osc0",
      "tooltip": "System oscillator (crystal or external clock, 3-32 MHz)."
    },
    {
      "id": "irc_slow",
      "label": "Slow IRC 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "Slow IRC 32.768 kHz", "mul": 32768}
      ]
    },
    {
      "id": "irc_fast",
      "label": "Fast IRC 4 MHz",
      "kind": "source",
      "x": 0,
      "y": 5,
      "options": [
        {"id": "on", "label": "Fast IRC 4 MHz", "mul": 4000000}
      ]
    },
    {
      "id": "fcrdiv",
      "label": "FCRDIV",
      "kind": "divider",
      "x": 1,
      "y": 5,
      "options": [
        {"id": "1", "label": "/1", "from": "irc_fast", "set": {"MCG_SC.FCRDIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "irc_fast", "set": {"MCG_SC.FCRDIV": "00000002"}, "div": 2},
        {"id": "4", "label": "/4", "from": "irc_fast", "set": {"MCG_SC.FCRDIV": "00000004"}, "div": 4},
        {"id": "8", "label": "/8", "from": "irc_fast", "set": {"MCG_SC.FCRDIV": "00000006"}, "div": 8},
        {"id": "16", "label": "/16", "from": "irc_fast", "set": {"MCG_SC.FCRDIV": "00000008"}, "div": 16},
        {"id": "32", "label": "/32", "from": "irc_fast", "set": {"MCG_SC.FCRDIV": "0000000A"}, "div": 32},
        {"id": "64", "label": "/64", "from": "irc_fast", "set": {"MCG_SC.FCRDIV": "0000000C"}, "div": 64},
        {"id": "128", "label": "/128", "from": "irc_fast", "set": {"MCG_SC.FCRDIV": "0000000E"}, "div": 128}
      ]
    },
    {
      "id": "mcgirclk",
      "label": "MCGIRCLK",
      "kind": "mux",
      "x": 2,
      "y": 4,
      "options": [
        {"id": "slow", "label": "Slow IRC", "from": "irc_slow", "set": {"MCG_C2.IRCS": "00000000"}},
        {"id": "fast", "label": "Fast IRC", "from": "fcrdiv", "set": {"MCG_C2.IRCS": "00000001"}}
      ]
    },
    {
      "id": "rtc32k",
      "label": "RTC oscillator 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 1,
      "options": [
        {"id": "on", "label": "RTC oscillator 32.768 kHz", "mul": 32768}
      ]
    },
    {
      "id": "irc48m",
      "label": "IRC48M 48 MHz",
      "kind": "source",
      "x": 0,
      "y": 2,
      "options": [
        {"id": "on", "label": "IRC48M 48 MHz", "mul": 48000000}
      ]
    },
    {
      "id": "oscsel",
      "label": "External reference (OSCSEL)",
      "kind": "mux",
      "x": 1,
      "y": 1,
      "options": [
        {"id": "osc0", "label": "OSC0", "from": "osc0", "set": {"MCG_C7.OSCSEL": "00000000"}},
        {"id": "rtc", "label": "RTC 32 kHz", "from": "rtc32k", "set": {"MCG_C7.OSCSEL": "00000001"}},
        {"id": "irc48m", "label": "IRC48M", "from": "irc48m", "set": {"MCG_C7.OSCSEL": "00000002"}}
      ]
    },
    {
      "id": "frdiv",
      "label": "FRDIV",
      "kind": "divider",
      "x": 2,
      "y": 2,
      "options": [
        {"id": "low0", "label": "/1", "from": "oscsel", "div": 1, "set": {"MCG_C1.FRDIV": "00000000"}, "when": "sel.oscsel == 'rtc'"},
        {"id": "high0", "label": "/32", "from": "oscsel", "div": 32, "set": {"MCG_C1.FRDIV": "00000000"}, "when": "sel.oscsel != 'rtc'"},
        {"id": "low1", "label": "/2", "from": "oscsel", "div": 2, "set": {"MCG_C1.FRDIV": "00000008"}, "when": "sel.oscsel == 'rtc'"},
        {"id": "high1", "label": "/64", "from": "oscsel", "div": 64, "set": {"MCG_C1.FRDIV": "00000008"}, "when": "sel.oscsel != 'rtc'"},
        {"id": "low2", "label": "/4", "from": "oscsel", "div": 4, "set": {"MCG_C1.FRDIV": "00000010"}, "when": "sel.oscsel == 'rtc'"},
        {"id": "high2", "label": "/128", "from": "oscsel", "div": 128, "set": {"MCG_C1.FRDIV": "00000010"}, "when": "sel.oscsel != 'rtc'"},
        {"id": "low3", "label": "/8", "from": "oscsel", "div": 8, "set": {"MCG_C1.FRDIV": "00000018"}, "when": "sel.oscsel == 'rtc'"},
        {"id": "high3", "label": "/256", "from": "oscsel", "div": 256, "set": {"MCG_C1.FRDIV": "00000018"}, "when": "sel.oscsel != 'rtc'"},
        {"id": "low4", "label": "/16", "from": "oscsel", "div": 16, "set": {"MCG_C1.FRDIV": "00000020"}, "when": "sel.oscsel == 'rtc'"},
        {"id": "high4", "label": "/512", "from": "oscsel", "div": 512, "set": {"MCG_C1.FRDIV": "00000020"}, "when": "sel.oscsel != 'rtc'"},
        {"id": "low5", "label": "/32", "from": "oscsel", "div": 32, "set": {"MCG_C1.FRDIV": "00000028"}, "when": "sel.oscsel == 'rtc'"},
        {"id": "high5", "label": "/1024", "from": "oscsel", "div": 1024, "set": {"MCG_C1.FRDIV": "00000028"}, "when": "sel.oscsel != 'rtc'"},
        {"id": "low6", "label": "/64", "from": "oscsel", "div": 64, "set": {"MCG_C1.FRDIV": "00000030"}, "when": "sel.oscsel == 'rtc'"},
        {"id": "high6", "label": "/1280", "from": "oscsel", "div": 1280, "set": {"MCG_C1.FRDIV": "00000030"}, "when": "sel.oscsel != 'rtc'"},
        {"id": "low7", "label": "/128", "from": "oscsel", "div": 128, "set": {"MCG_C1.FRDIV": "00000038"}, "when": "sel.oscsel == 'rtc'"},
        {"id": "high7", "label": "/1536", "from": "oscsel", "div": 1536, "set": {"MCG_C1.FRDIV": "00000038"}, "when": "sel.oscsel != 'rtc'"}
      ]
    },
    {
      "id": "fllref",
      "label": "FLL reference",
      "kind": "mux",
      "x": 3,
      "y": 3,
      "options": [
        {"id": "irc", "label": "Slow IRC", "from": "irc_slow", "set": {"MCG_C1.IREFS": "00000004"}},
        {"id": "ext", "label": "External / FRDIV", "from": "frdiv", "set": {"MCG_C1.IREFS": "00000000"}}
      ],
      "min": 31250,
      "max": 39063,
      "tooltip": "FLL reference: 31.25-39.0625 kHz."
    },
    {
      "id": "fll",
      "label": "FLL (DRS, DMX32)",
      "kind": "multiplier",
      "x": 4,
      "y": 3,
      "options": [
        {"id": "640", "label": "x640", "from": "fllref", "mul": 640, "set": {"MCG_C4.DRST_DRS": "00000000", "MCG_C4.DMX32": "00000000"}},
        {"id": "732", "label": "x732", "from": "fllref", "mul": 732, "set": {"MCG_C4.DRST_DRS": "00000000", "MCG_C4.DMX32": "00000080"}},
        {"id": "1280", "label": "x1280", "from": "fllref", "mul": 1280, "set": {"MCG_C4.DRST_DRS": "00000020", "MCG_C4.DMX32": "00000000"}},
        {"id": "1464", "label": "x1464", "from": "fllref", "mul": 1464, "set": {"MCG_C4.DRST_DRS": "00000020", "MCG_C4.DMX32": "00000080"}}
      ]
    },
    {
      "id": "prdiv",
      "label": "PLL /PRDIV",
      "kind": "divider",
      "x": 3,
      "y": 1,
      "range": {"from": "oscsel", "op": "div", "min": 1, "max": 25, "field": "MCG_C5.PRDIV0|MCG_C5.PRDIV", "lsb": 0, "scale": 1, "offset": -1},
      "min": 2000000,
      "max": 4000000,
      "tooltip": "PLL reference: 2-4 MHz."
    },
    {
      "id": "pll",
      "label": "PLL xVDIV",
      "kind": "multiplier",
      "x": 4,
      "y": 1,
      "range": {"from": "prdiv", "op": "mul", "min": 24, "max": 55, "field": "MCG_C6.VDIV0|MCG_C6.VDIV", "lsb": 0, "scale": 1, "offset": -24},
      "min": 48000000,
      "max": 120000000,
      "enable": {"field": "MCG_C5.PLLCLKEN0|MCG_C5.PLLCLKEN", "on": "00000040", "off": "00000000", "auto": "both"}
    },
    {
      "id": "mcgout",
      "label": "MCGOUTCLK",
      "kind": "mux",
      "x": 6,
      "y": 2,
      "options": [
        {"id": "pll", "label": "PLL (PEE)", "from": "pll", "set": {"MCG_C1.CLKS": "00000000", "MCG_C6.PLLS": "00000040"}},
        {"id": "fll", "label": "FLL (FEI/FEE)", "from": "fll", "set": {"MCG_C1.CLKS": "00000000", "MCG_C6.PLLS": "00000000"}},
        {"id": "irc", "label": "Internal reference (FBI)", "from": "mcgirclk", "set": {"MCG_C1.CLKS": "00000040", "MCG_C6.PLLS": "00000000"}},
        {"id": "ext", "label": "External reference (FBE)", "from": "oscsel", "set": {"MCG_C1.CLKS": "00000080", "MCG_C6.PLLS": "00000000"}}
      ]
    },
    {
      "id": "core",
      "label": "Core/system (OUTDIV1)",
      "kind": "divider",
      "x": 7,
      "y": 0,
      "range": {"from": "mcgout", "op": "div", "min": 1, "max": 16, "field": "SIM_CLKDIV1.OUTDIV1", "lsb": 28, "scale": 1, "offset": -1},
      "max": 120000000,
      "consumer": true
    },
    {
      "id": "bus",
      "label": "Bus (OUTDIV2)",
      "kind": "divider",
      "x": 7,
      "y": 1,
      "range": {"from": "mcgout", "op": "div", "min": 1, "max": 16, "field": "SIM_CLKDIV1.OUTDIV2", "lsb": 24, "scale": 1, "offset": -1},
      "max": 60000000,
      "consumer": true
    },
    {
      "id": "flexbus",
      "label": "FlexBus (OUTDIV3)",
      "kind": "divider",
      "x": 7,
      "y": 2,
      "range": {"from": "mcgout", "op": "div", "min": 1, "max": 16, "field": "SIM_CLKDIV1.OUTDIV3", "lsb": 20, "scale": 1, "offset": -1},
      "tooltip": "FlexBus clock: at most 50 MHz when the FlexBus is used."
    },
    {
      "id": "flash",
      "label": "Flash (OUTDIV4)",
      "kind": "divider",
      "x": 7,
      "y": 3,
      "range": {"from": "mcgout", "op": "div", "min": 1, "max": 16, "field": "SIM_CLKDIV1.OUTDIV4", "lsb": 16, "scale": 1, "offset": -1},
      "max": 25000000,
      "consumer": true
    },
    {
      "id": "pllfllsel",
      "label": "Peripheral clock (PLLFLLSEL)",
      "kind": "mux",
      "x": 7,
      "y": 5,
      "options": [
        {"id": "fll", "label": "MCGFLLCLK", "from": "fll", "set": {"SIM_SOPT2.PLLFLLSEL": "00000000"}},
        {"id": "pll", "label": "MCGPLLCLK", "from": "pll", "set": {"SIM_SOPT2.PLLFLLSEL": "00010000"}},
        {"id": "irc48m", "label": "IRC48M", "from": "irc48m", "set": {"SIM_SOPT2.PLLFLLSEL": "00030000"}}
      ]
    }
  ],
  "derive": [
    {"field": "MCG_MODE.MCGMODE", "cases": [{"when": "sel.mcgout == 'pll'", "value": "00000007"}, {"when": "sel.mcgout == 'fll' && sel.fllref == 'irc'", "value": "00000000"}, {"when": "sel.mcgout == 'fll'", "value": "00000003"}, {"when": "sel.mcgout == 'irc'", "value": "00000001"}], "default": "00000004"},
    {"field": "MCG_C2.RANGE", "cases": [{"when": "in.osc0 > 8000000", "value": "00000020"}], "default": "00000010"}
  ],
  "constraints": [
    {"expr": "f.core >= f.bus && f.bus >= f.flash", "message": "The core clock must be at least the bus clock, and the bus clock at least the flash clock."},
    {"expr": "sel.mcgout != 'pll' || in.osc0 >= 3000000 || sel.oscsel != 'osc0'", "message": "The PLL reference needs OSC0 at 3 MHz or more."}
  ],
  "variants": [
    {"devices": ["^MK22FN128V"], "limits": {"core": {"max": 100000000}, "pll": {"max": 100000000}, "bus": {"max": 50000000}}}
  ]
}
