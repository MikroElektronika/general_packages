{
  "schema": 1,
  "id": "fm3",
  "title": "FM3 clock tree",
  "vendor": "Infineon",
  "source": "FM3 peripheral manual (clock); MB9A/MB9B data sheets",
  "devices": ["^CY9AF", "^CY9BF[1-5][12]", "^CY9BF6", "^CY9BFD"],
  "fosc": "hclk",
  "inputs": {
    "mosc": {"label": "Main oscillator frequency", "default": 4000000, "min": 4000000, "max": 48000000}
  },
  "settings": ["CSW_TMR.MOWT", "PSW_TMR.POWT", "CSW_TMR.SOWT", "SWC_PSR.SWDS", "TTC_PSR.TTC", "APBC1_PSR.APBC1EN", "APBC2_PSR.APBC2EN"],
  "nodes": [
    {
      "id": "hcr",
      "label": "High-speed CR 4 MHz",
      "kind": "source",
      "x": 0,
      "y": 2,
      "options": [
        {"id": "on", "label": "High-speed CR 4 MHz", "mul": 4000000}
      ],
      "tooltip": "Internal high-speed CR oscillator, factory trimmed by the startup code."
    },
    {
      "id": "mosc",
      "label": "Main oscillator",
      "kind": "source",
      "x": 0,
      "y": 0,
      "input": "mosc",
      "enable": {"field": "SCM_CTL.MOSCE", "on": "00000002", "off": "00000000", "auto": "both"},
      "tooltip": "Main crystal oscillator (4-48 MHz). Its frequency is not stored in the definition."
    },
    {
      "id": "pllin",
      "label": "PLL input",
      "kind": "mux",
      "x": 1,
      "y": 1,
      "options": [
        {"id": "mosc", "label": "Main oscillator", "from": "mosc", "set": {"PSW_TMR.PINC": "00000000"}},
        {"id": "hcr", "label": "High-speed CR", "from": "hcr", "set": {"PSW_TMR.PINC": "00000010"}}
      ]
    },
    {
      "id": "pllk",
      "label": "PLL /K",
      "kind": "divider",
      "x": 2,
      "y": 1,
      "range": {"from": "pllin", "op": "div", "min": 1, "max": 16, "field": "PLL_CTL1.PLLK", "lsb": 4, "scale": 1, "offset": -1},
      "min": 4000000,
      "max": 16000000,
      "tooltip": "PLL input after K: 4-16 MHz."
    },
    {
      "id": "pll",
      "label": "CLKPLL xN",
      "kind": "multiplier",
      "x": 3,
      "y": 1,
      "range": {"from": "pllk", "op": "mul", "min": 1, "max": 64, "field": "PLL_CTL2.PLLN", "lsb": 0, "scale": 1, "offset": -1},
      "enable": {"field": "SCM_CTL.PLLE", "on": "00000010", "off": "00000000", "auto": "both"}
    },
    {
      "id": "vco",
      "label": "PLL macro xM",
      "kind": "multiplier",
      "x": 4,
      "y": 0,
      "range": {"from": "pll", "op": "mul", "min": 1, "max": 16, "field": "PLL_CTL1.PLLM", "lsb": 0, "scale": 1, "offset": -1},
      "optional": true,
      "tooltip": "PLL macro oscillation clock = CLKPLL x M (feedback divider M)."
    },
    {
      "id": "lcr",
      "label": "Low-speed CR 100 kHz",
      "kind": "source",
      "x": 0,
      "y": 3,
      "options": [
        {"id": "on", "label": "Low-speed CR 100 kHz", "mul": 100000}
      ]
    },
    {
      "id": "sosc",
      "label": "Sub oscillator 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "Sub oscillator 32.768 kHz", "mul": 32768}
      ],
      "enable": {"field": "SCM_CTL.SOSCE", "on": "00000008", "off": "00000000", "auto": "both"}
    },
    {
      "id": "master",
      "label": "Master clock (RCS)",
      "kind": "mux",
      "x": 5,
      "y": 2,
      "options": [
        {"id": "hcr", "label": "High-speed CR", "from": "hcr", "set": {"SCM_CTL.RCS": "00000000"}},
        {"id": "mosc", "label": "Main oscillator", "from": "mosc", "set": {"SCM_CTL.RCS": "00000020"}},
        {"id": "pll", "label": "Main PLL", "from": "pll", "set": {"SCM_CTL.RCS": "00000040"}},
        {"id": "lcr", "label": "Low-speed CR", "from": "lcr", "set": {"SCM_CTL.RCS": "00000080"}},
        {"id": "sosc", "label": "Sub oscillator", "from": "sosc", "set": {"SCM_CTL.RCS": "000000A0"}}
      ]
    },
    {
      "id": "hclk",
      "label": "HCLK (BSR)",
      "kind": "divider",
      "x": 6,
      "y": 2,
      "options": [
        {"id": "1", "label": "/1", "from": "master", "set": {"BSC_PSR.BSR": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "master", "set": {"BSC_PSR.BSR": "00000001"}, "div": 2},
        {"id": "3", "label": "/3", "from": "master", "set": {"BSC_PSR.BSR": "00000002"}, "div": 3},
        {"id": "4", "label": "/4", "from": "master", "set": {"BSC_PSR.BSR": "00000003"}, "div": 4},
        {"id": "6", "label": "/6", "from": "master", "set": {"BSC_PSR.BSR": "00000004"}, "div": 6},
        {"id": "8", "label": "/8", "from": "master", "set": {"BSC_PSR.BSR": "00000005"}, "div": 8},
        {"id": "16", "label": "/16", "from": "master", "set": {"BSC_PSR.BSR": "00000006"}, "div": 16}
      ],
      "consumer": true
    },
    {
      "id": "pclk0",
      "label": "PCLK0 (APB0)",
      "kind": "divider",
      "x": 7,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "hclk", "set": {"APBC0_PSR.APBC0": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hclk", "set": {"APBC0_PSR.APBC0": "00000001"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hclk", "set": {"APBC0_PSR.APBC0": "00000002"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hclk", "set": {"APBC0_PSR.APBC0": "00000003"}, "div": 8}
      ],
      "consumer": true
    },
    {
      "id": "pclk1",
      "label": "PCLK1 (APB1)",
      "kind": "divider",
      "x": 7,
      "y": 2,
      "options": [
        {"id": "1", "label": "/1", "from": "hclk", "set": {"APBC1_PSR.APBC1": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hclk", "set": {"APBC1_PSR.APBC1": "00000001"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hclk", "set": {"APBC1_PSR.APBC1": "00000002"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hclk", "set": {"APBC1_PSR.APBC1": "00000003"}, "div": 8}
      ],
      "consumer": true
    },
    {
      "id": "pclk2",
      "label": "PCLK2 (APB2)",
      "kind": "divider",
      "x": 7,
      "y": 3,
      "options": [
        {"id": "1", "label": "/1", "from": "hclk", "set": {"APBC2_PSR.APBC2": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hclk", "set": {"APBC2_PSR.APBC2": "00000001"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hclk", "set": {"APBC2_PSR.APBC2": "00000002"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hclk", "set": {"APBC2_PSR.APBC2": "00000003"}, "div": 8}
      ],
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "sel.master != 'pll' || sel.pllin != 'mosc' || in.mosc >= 4000000", "message": "The PLL needs a main oscillator of 4 MHz or more."}
  ],
  "variants": [
    {"devices": ["^CY9AF1[245]", "^CY9AF34", "^CY9AF4", "^CY9AF[AB]"], "limits": {"hclk": {"max": 40000000}, "pll": {"max": 40000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 75000000 && f.vco <= 150000000)", "message": "PLL macro clock (CLKPLL x M) must be 75-150 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.05 <= 40000000", "message": "From the high-speed CR, CLKPLL must stay 5 % below 40 MHz: the trimmed CR can be that much faster than nominal."}]},
    {"devices": ["^CY9AF[13]1[12][LMN]", "^CY9AF[13]1[3-6]"], "limits": {"hclk": {"max": 40000000}, "pll": {"max": 40000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 200000000 && f.vco <= 300000000)", "message": "PLL macro clock (CLKPLL x M) must be 200-300 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.05 <= 40000000", "message": "From the high-speed CR, CLKPLL must stay 5 % below 40 MHz: the trimmed CR can be that much faster than nominal."}]},
    {"devices": ["^CY9AF[13]1[12]K"], "limits": {"hclk": {"max": 42000000}, "pll": {"max": 42000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 200000000 && f.vco <= 300000000)", "message": "PLL macro clock (CLKPLL x M) must be 200-300 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.05 <= 42000000", "message": "From the high-speed CR, CLKPLL must stay 5 % below 42 MHz: the trimmed CR can be that much faster than nominal."}]},
    {"devices": ["^CY9BF[1-5]1", "^CY9BF2", "^CY9BF6", "^CY9BFD"], "limits": {"hclk": {"max": 144000000}, "pll": {"max": 144000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 200000000 && f.vco <= 300000000)", "message": "PLL macro clock (CLKPLL x M) must be 200-300 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.05 <= 144000000", "message": "From the high-speed CR, CLKPLL must stay 5 % below 144 MHz: the trimmed CR can be that much faster than nominal."}]},
    {"devices": ["^CY9BF[1-5]2[1-4]"], "limits": {"hclk": {"max": 72000000}, "pll": {"max": 72000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 75000000 && f.vco <= 150000000)", "message": "PLL macro clock (CLKPLL x M) must be 75-150 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.05 <= 72000000", "message": "From the high-speed CR, CLKPLL must stay 5 % below 72 MHz: the trimmed CR can be that much faster than nominal."}]},
    {"devices": ["^CY9BF[1-5]2[89]"], "limits": {"hclk": {"max": 60000000}, "pll": {"max": 60000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 75000000 && f.vco <= 150000000)", "message": "PLL macro clock (CLKPLL x M) must be 75-150 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.05 <= 60000000", "message": "From the high-speed CR, CLKPLL must stay 5 % below 60 MHz: the trimmed CR can be that much faster than nominal."}]}
  ]
}
