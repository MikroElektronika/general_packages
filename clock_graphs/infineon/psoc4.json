{
  "schema": 1,
  "id": "psoc4",
  "title": "PSOC 4 clock tree",
  "vendor": "Infineon",
  "source": "PSOC 4 architecture/registers technical reference manuals (SRSS, EXCO); mtb-pdl-cat2 cy_sysclk",
  "devices": ["^CY8C4"],
  "fosc": "sysclk",
  "inputs": {
    "extclk": {"label": "EXTCLK frequency", "default": 24000000, "min": 1000000, "max": 48000000}
  },
  "settings": ["?EXCO_ECO_CONFIG.CLOAD", "?EXCO_ECO_CONFIG.ESR", "?EXCO_ECO_CONFIG.DRIVE"],
  "nodes": [
    {
      "id": "imo",
      "label": "IMO",
      "kind": "source",
      "x": 0,
      "y": 0,
      "tooltip": "Internal main oscillator, factory trimmed (24-48 MHz in 4 MHz steps; 24 MHz only on the 24 MHz grades).",
      "options": [
        {"id": "24", "label": "24 MHz", "mul": 24000000, "set": {"CLK_IMO_SELECT.FREQ": "00000000"}},
        {"id": "28", "label": "28 MHz", "mul": 28000000, "set": {"CLK_IMO_SELECT.FREQ": "00000001"}},
        {"id": "32", "label": "32 MHz", "mul": 32000000, "set": {"CLK_IMO_SELECT.FREQ": "00000002"}},
        {"id": "36", "label": "36 MHz", "mul": 36000000, "set": {"CLK_IMO_SELECT.FREQ": "00000003"}},
        {"id": "40", "label": "40 MHz", "mul": 40000000, "set": {"CLK_IMO_SELECT.FREQ": "00000004"}},
        {"id": "44", "label": "44 MHz", "mul": 44000000, "set": {"CLK_IMO_SELECT.FREQ": "00000005"}},
        {"id": "48", "label": "48 MHz", "mul": 48000000, "set": {"CLK_IMO_SELECT.FREQ": "00000006"}}
      ]
    },
    {
      "id": "extclk",
      "label": "EXTCLK",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "extclk",
      "tooltip": "External clock on the EXTCLK pin (P0.6)."
    },
    {
      "id": "eco",
      "label": "ECO crystal",
      "kind": "source",
      "x": 0,
      "y": 3,
      "tooltip": "External crystal oscillator (4-33 MHz). Load capacitance, ESR and drive level are set below.",
      "options": [
        {"id": "4", "label": "4 MHz", "mul": 4000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000004"}},
        {"id": "5", "label": "5 MHz", "mul": 5000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000005"}},
        {"id": "6", "label": "6 MHz", "mul": 6000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000006"}},
        {"id": "7", "label": "7 MHz", "mul": 7000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000007"}},
        {"id": "8", "label": "8 MHz", "mul": 8000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000008"}},
        {"id": "9", "label": "9 MHz", "mul": 9000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000009"}},
