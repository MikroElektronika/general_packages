        {"id": "15", "label": "15 MHz", "mul": 15000000, "set": {"EXCO_ECO_CONFIG.FREQ": "0000000F"}},
        {"id": "16", "label": "16 MHz", "mul": 16000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000010"}},
        {"id": "17", "label": "17 MHz", "mul": 17000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000011"}},
        {"id": "18", "label": "18 MHz", "mul": 18000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000012"}},
        {"id": "19", "label": "19 MHz", "mul": 19000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000013"}},
        {"id": "20", "label": "20 MHz", "mul": 20000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000014"}},
        {"id": "21", "label": "21 MHz", "mul": 21000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000015"}},
        {"id": "22", "label": "22 MHz", "mul": 22000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000016"}},
        {"id": "23", "label": "23 MHz", "mul": 23000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000017"}},
        {"id": "24", "label": "24 MHz", "mul": 24000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000018"}},
        {"id": "25", "label": "25 MHz", "mul": 25000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000019"}},
        {"id": "26", "label": "26 MHz", "mul": 26000000, "set": {"EXCO_ECO_CONFIG.FREQ": "0000001A"}},
