        {"id": "29", "label": "29 MHz", "mul": 29000000, "set": {"EXCO_ECO_CONFIG.FREQ": "0000001D"}},
        {"id": "30", "label": "30 MHz", "mul": 30000000, "set": {"EXCO_ECO_CONFIG.FREQ": "0000001E"}},
        {"id": "31", "label": "31 MHz", "mul": 31000000, "set": {"EXCO_ECO_CONFIG.FREQ": "0000001F"}},
        {"id": "32", "label": "32 MHz", "mul": 32000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000020"}},
        {"id": "33", "label": "33 MHz", "mul": 33000000, "set": {"EXCO_ECO_CONFIG.FREQ": "00000021"}}
      ]
    },
    {
      "id": "pllref",
      "label": "PLL reference",
      "kind": "mux",
      "x": 1,
      "y": 3,
      "options": [
        {"id": "eco", "label": "ECO", "from": "eco", "set": {"EXCO_CLK_SELECT.REF_SEL": "00000000"}},
        {"id": "imo", "label": "IMO", "from": "imo", "set": {"EXCO_CLK_SELECT.REF_SEL": "00000002"}},
        {"id": "imo2", "label": "IMO", "from": "imo", "set": {"EXCO_CLK_SELECT.REF_SEL": "00000004"}}
      ]
    },
    {
      "id": "pllq",
      "label": "PLL /Q",
      "kind": "divider",
      "x": 2,
      "y": 3,
      "range": {"from": "pllref", "op": "div", "min": 1, "max": 64, "field": "EXCO_PLL_CONFIG.REFERENCE_DIV", "lsb": 8, "scale": 1, "offset": -1},
      "min": 1000000,
      "max": 3000000,
      "tooltip": "PLL phase detector input: 1-3 MHz."
    },
    {
      "id": "pllvco",
      "label": "PLL xP",
      "kind": "multiplier",
      "x": 3,
      "y": 3,
      "range": {"from": "pllq", "op": "mul", "min": 8, "max": 255, "field": "EXCO_PLL_CONFIG.FEEDBACK_DIV", "lsb": 0, "scale": 1, "offset": 0},
      "min": 22500000,
      "max": 104000000,
      "tooltip": "PLL VCO: 22.5-104 MHz."
    },
    {
      "id": "pllout",
      "label": "PLL output",
      "kind": "divider",
      "x": 4,
      "y": 3,
      "options": [
        {"id": "1", "label": "/1", "from": "pllvco", "set": {"EXCO_PLL_CONFIG.OUTPUT_DIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "pllvco", "set": {"EXCO_PLL_CONFIG.OUTPUT_DIV": "00004000"}, "div": 2},
        {"id": "4", "label": "/4", "from": "pllvco", "set": {"EXCO_PLL_CONFIG.OUTPUT_DIV": "00008000"}, "div": 4},
        {"id": "8", "label": "/8", "from": "pllvco", "set": {"EXCO_PLL_CONFIG.OUTPUT_DIV": "0000C000"}, "div": 8}
      ]
    },
    {
      "id": "exco",
      "label": "EXCO",
      "kind": "mux",
      "x": 5,
      "y": 2,
      "options": [
        {"id": "pll", "label": "PLL", "from": "pllout", "set": {"EXCO_PLL_CONFIG.ENABLE": "80000000"}},
        {"id": "eco", "label": "ECO", "from": "eco", "set": {"EXCO_PLL_CONFIG.ENABLE": "00000000"}}
      ]
    },
    {
      "id": "hfsel",
      "label": "HFCLK source",
      "kind": "mux",
      "x": 6,
      "y": 1,
      "options": [
        {"id": "imo", "label": "IMO", "from": "imo", "set": {"CLK_SELECT.HFCLK_SEL": "00000000"}},
        {"id": "ext", "label": "EXTCLK", "from": "extclk", "set": {"CLK_SELECT.HFCLK_SEL": "00000001"}},
        {"id": "exco", "label": "EXCO (ECO / PLL)", "from": "exco", "set": {"CLK_SELECT.HFCLK_SEL": "00000002"}}
      ]
    },
    {
      "id": "hfclk",
      "label": "HFCLK",
      "kind": "divider",
      "x": 7,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "hfsel", "set": {"CLK_SELECT.HFCLK_DIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hfsel", "set": {"CLK_SELECT.HFCLK_DIV": "00000004"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hfsel", "set": {"CLK_SELECT.HFCLK_DIV": "00000008"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hfsel", "set": {"CLK_SELECT.HFCLK_DIV": "0000000C"}, "div": 8}
      ],
      "max": 48000000,
      "consumer": true
    },
    {
      "id": "sysclk",
      "label": "SYSCLK (CPU)",
      "kind": "divider",
      "x": 8,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "hfclk", "set": {"CLK_SELECT.SYSCLK_DIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hfclk", "set": {"CLK_SELECT.SYSCLK_DIV": "00000040"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hfclk", "set": {"CLK_SELECT.SYSCLK_DIV": "00000080"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hfclk", "set": {"CLK_SELECT.SYSCLK_DIV": "000000C0"}, "div": 8}
      ],
      "max": 48000000,
      "consumer": true
    }
  ],
  "variants": [
    {"devices": ["^CY8C402", "^CY8C412", "^CY8C472", "^CY8C4149AZI-S5[78]", "^CY8C4149AZI-S568"], "limits": {"hfclk": {"max": 24000000}, "sysclk": {"max": 24000000}}}
  ]
}
