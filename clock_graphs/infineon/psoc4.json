        {"id": "11", "label": "11 MHz", "mul": 11000000, "set": {"EXCO_ECO_CONFIG.FREQ": "0000000B"}},
        {"id": "12", "label": "12 MHz", "mul": 12000000, "set": {"EXCO_ECO_CONFIG.FREQ": "0000000C"}},
        {"id": "13", "label": "13 MHz", "mul": 13000000, "set": {"EXCO_ECO_CONFIG.FREQ": "0000000D"}},
