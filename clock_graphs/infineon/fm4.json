{
  "schema": 1,
  "id": "fm4",
  "title": "FM4 clock tree",
  "vendor": "Infineon",
  "source": "FM4 peripheral manual (clock); S6E2C/G/D/H and MB9B160-560 data sheets",
  "devices": ["^S6E2", "^CY9BF[1-5]6"],
  "fosc": "hclk",
  "inputs": {
    "mosc": {"label": "Main oscillator frequency", "default": 4000000, "min": 4000000, "max": 48000000}
  },
  "settings": ["csw_tmr.mowt", "psw_tmr.powt"],
  "nodes": [
    {
      "id": "hcr",
      "label": "High-speed CR 4 MHz",
      "kind": "source",
      "x": 0,
      "y": 2,
      "options": [
        {"id": "on", "label": "High-speed CR 4 MHz", "mul": 4000000}
      ],
      "tooltip": "Internal high-speed CR oscillator, factory trimmed by the startup code."
    },
    {
      "id": "mosc",
      "label": "Main oscillator",
      "kind": "source",
      "x": 0,
      "y": 0,
      "input": "mosc",
      "tooltip": "Main crystal oscillator (4-48 MHz). Its frequency is not stored in the definition."
    },
    {
      "id": "pllin",
      "label": "PLL input",
      "kind": "mux",
      "x": 1,
      "y": 1,
      "options": [
        {"id": "mosc", "label": "Main oscillator", "from": "mosc", "set": {"psw_tmr.pinc": "00000000"}},
        {"id": "hcr", "label": "High-speed CR", "from": "hcr", "set": {"psw_tmr.pinc": "00000010"}}
      ]
    },
    {
      "id": "pllk",
      "label": "PLL /K",
      "kind": "divider",
      "x": 2,
      "y": 1,
      "range": {"from": "pllin", "op": "div", "min": 1, "max": 16, "field": "pll_ctl1.pllk", "lsb": 4, "scale": 1, "offset": -1},
      "min": 4000000,
      "max": 16000000,
      "tooltip": "PLL input after K: 4-16 MHz."
    },
    {
      "id": "pll",
      "label": "CLKPLL xN",
      "kind": "multiplier",
      "x": 3,
      "y": 1,
      "range": {"from": "pllk", "op": "mul", "min": 1, "max": 64, "field": "pll_ctl2.plln", "lsb": 0, "scale": 1, "offset": -1}
    },
    {
      "id": "vco",
      "label": "PLL macro xM",
      "kind": "multiplier",
      "x": 4,
      "y": 0,
      "range": {"from": "pll", "op": "mul", "min": 1, "max": 16, "field": "pll_ctl1.pllm", "lsb": 0, "scale": 1, "offset": -1},
      "optional": true,
      "tooltip": "PLL macro oscillation clock = CLKPLL x M (feedback divider M)."
    },
    {
      "id": "master",
      "label": "Master clock (RCS)",
      "kind": "mux",
      "x": 5,
      "y": 2,
      "options": [
        {"id": "hcr", "label": "High-speed CR", "from": "hcr", "set": {"scm_ctl.rcs": "00000000"}},
        {"id": "mosc", "label": "Main oscillator", "from": "mosc", "set": {"scm_ctl.rcs": "00000020"}},
        {"id": "pll", "label": "Main PLL", "from": "pll", "set": {"scm_ctl.rcs": "00000040"}}
      ]
    },
    {
      "id": "hclk",
      "label": "HCLK (BSR)",
      "kind": "divider",
      "x": 6,
      "y": 2,
      "options": [
        {"id": "1", "label": "/1", "from": "master", "set": {"bsc_psr.bsr": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "master", "set": {"bsc_psr.bsr": "00000001"}, "div": 2},
        {"id": "3", "label": "/3", "from": "master", "set": {"bsc_psr.bsr": "00000002"}, "div": 3},
        {"id": "4", "label": "/4", "from": "master", "set": {"bsc_psr.bsr": "00000003"}, "div": 4},
        {"id": "6", "label": "/6", "from": "master", "set": {"bsc_psr.bsr": "00000004"}, "div": 6},
        {"id": "8", "label": "/8", "from": "master", "set": {"bsc_psr.bsr": "00000005"}, "div": 8},
        {"id": "16", "label": "/16", "from": "master", "set": {"bsc_psr.bsr": "00000006"}, "div": 16}
      ],
      "consumer": true
    },
    {
      "id": "pclk0",
      "label": "PCLK0 (APB0)",
      "kind": "divider",
      "x": 7,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "hclk", "set": {"apbc0_psr.apbc0": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hclk", "set": {"apbc0_psr.apbc0": "00000001"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hclk", "set": {"apbc0_psr.apbc0": "00000002"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hclk", "set": {"apbc0_psr.apbc0": "00000003"}, "div": 8}
      ],
      "consumer": true
    },
    {
      "id": "pclk1",
      "label": "PCLK1 (APB1)",
      "kind": "divider",
      "x": 7,
      "y": 2,
      "options": [
        {"id": "1", "label": "/1", "from": "hclk", "set": {"apbc1_psr.apbc1": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hclk", "set": {"apbc1_psr.apbc1": "00000001"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hclk", "set": {"apbc1_psr.apbc1": "00000002"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hclk", "set": {"apbc1_psr.apbc1": "00000003"}, "div": 8}
      ],
      "consumer": true
    },
    {
      "id": "pclk2",
      "label": "PCLK2 (APB2)",
      "kind": "divider",
      "x": 7,
      "y": 3,
      "options": [
        {"id": "1", "label": "/1", "from": "hclk", "set": {"apbc2_psr.apbc2": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hclk", "set": {"apbc2_psr.apbc2": "00000001"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hclk", "set": {"apbc2_psr.apbc2": "00000002"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hclk", "set": {"apbc2_psr.apbc2": "00000003"}, "div": 8}
      ],
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "sel.master != 'pll' || sel.pllin != 'mosc' || in.mosc >= 4000000", "message": "The PLL needs a main oscillator of 4 MHz or more."}
  ],
  "variants": [
    {"devices": ["^S6E2C"], "limits": {"hclk": {"max": 200000000}, "pll": {"max": 200000000}, "pclk0": {"max": 100000000}, "pclk1": {"max": 200000000}, "pclk2": {"max": 100000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 190000000 && f.vco <= 400000000)", "message": "PLL macro clock (CLKPLL x M) must be 190-400 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.03 <= 200000000", "message": "From the high-speed CR, CLKPLL must stay 3 % below 200 MHz: the trimmed CR can be that much faster than nominal."}]},
    {"devices": ["^S6E2G"], "limits": {"hclk": {"max": 180000000}, "pll": {"max": 180000000}, "pclk0": {"max": 90000000}, "pclk1": {"max": 180000000}, "pclk2": {"max": 90000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 190000000 && f.vco <= 400000000)", "message": "PLL macro clock (CLKPLL x M) must be 190-400 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.03 <= 180000000", "message": "From the high-speed CR, CLKPLL must stay 3 % below 180 MHz: the trimmed CR can be that much faster than nominal."}]},
    {"devices": ["^S6E2D"], "limits": {"hclk": {"max": 160000000}, "pll": {"max": 160000000}, "pclk0": {"max": 80000000}, "pclk1": {"max": 160000000}, "pclk2": {"max": 80000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 190000000 && f.vco <= 400000000)", "message": "PLL macro clock (CLKPLL x M) must be 190-400 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.03 <= 160000000", "message": "From the high-speed CR, CLKPLL must stay 3 % below 160 MHz: the trimmed CR can be that much faster than nominal."}]},
    {"devices": ["^S6E2H", "^CY9BF"], "limits": {"hclk": {"max": 160000000}, "pll": {"max": 160000000}, "pclk0": {"max": 80000000}, "pclk1": {"max": 160000000}, "pclk2": {"max": 80000000}}, "constraints": [{"expr": "sel.master != 'pll' || (f.vco >= 190000000 && f.vco <= 320000000)", "message": "PLL macro clock (CLKPLL x M) must be 190-320 MHz."}, {"expr": "sel.master != 'pll' || sel.pllin != 'hcr' || f.pll * 1.03 <= 160000000", "message": "From the high-speed CR, CLKPLL must stay 3 % below 160 MHz: the trimmed CR can be that much faster than nominal."}]}
  ]
}
