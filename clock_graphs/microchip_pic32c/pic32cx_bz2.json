      "label": "FRC 8 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "FRC 8 MHz", "mul": 8000000}
      ],
      "tooltip": "Internal fast RC oscillator."
