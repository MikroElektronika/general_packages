{
  "schema": 1,
  "id": "pic_usb_pic18f13k50",
  "title": "PIC USB clock tree (3x/4x PLL) (PIC18F13K50, PIC18F14K50, PIC18LF13K50 and 1 more)",
  "vendor": "Microchip",
  "source": "PIC16F145x/PIC18 USB data sheets (Oscillator sections); fuse values from the Microchip DFP EDC files",
  "devices": ["^PIC18F13K50$", "^PIC18F14K50$", "^PIC18LF13K50$", "^PIC18LF14K50$"],
  "fosc": "sysclk",
  "inputs": {
    "ext": {"label": "External frequency", "default": 12000000, "min": 1, "max": 48000000},
    "intosc": {"label": "Internal oscillator frequency", "default": 16000000, "min": 31000, "max": 16000000}
  },
  "settings": ["CONFIG1L.USBDIV", "CONFIG1H.PCLKEN", "CONFIG1H.FCMEN", "CONFIG1H.IESO"],
  "nodes": [
    {
      "id": "ext",
      "label": "External oscillator / clock",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext"
    },
    {
      "id": "intosc",
      "label": "Internal oscillator (set by your code)",
      "kind": "source",
      "x": 0,
      "y": 3,
      "input": "intosc",
      "tooltip": "The internal oscillator frequency is chosen at runtime (OSCCON.IRCF): 16 MHz (HFINTOSC) feeds the 3x PLL."
    },
    {
      "id": "primary",
      "label": "Oscillator (FOSC)",
      "kind": "mux",
      "x": 1,
      "y": 1,
      "options": [
        {"id": "ecclkouth", "label": "EC, CLKOUT function on OSC2 (high)", "set": {"CONFIG1H.FOSC": "00000004"}, "from": "ext"},
        {"id": "ecclkoutl", "label": "EC, CLKOUT function on OSC2 (low)", "set": {"CONFIG1H.FOSC": "0000000C"}, "from": "ext"},
        {"id": "ecclkoutm", "label": "EC, CLKOUT function on OSC2 (medium)", "set": {"CONFIG1H.FOSC": "0000000A"}, "from": "ext"},
        {"id": "ech", "label": "EC (high)", "set": {"CONFIG1H.FOSC": "00000005"}, "from": "ext"},
        {"id": "ecl", "label": "EC (low)", "set": {"CONFIG1H.FOSC": "0000000D"}, "from": "ext"},
        {"id": "ecm", "label": "EC (medium)", "set": {"CONFIG1H.FOSC": "0000000B"}, "from": "ext"},
        {"id": "erc", "label": "External RC oscillator", "set": {"CONFIG1H.FOSC": "00000007"}, "from": "ext"},
        {"id": "ercclkout", "label": "External RC oscillator, CLKOUT function on OSC2", "set": {"CONFIG1H.FOSC": "00000003"}, "from": "ext"},
        {"id": "hs", "label": "HS oscillator", "set": {"CONFIG1H.FOSC": "00000002"}, "from": "ext"},
        {"id": "irc", "label": "Internal RC oscillator", "set": {"CONFIG1H.FOSC": "00000008"}, "from": "intosc"},
        {"id": "ircclkout", "label": "Internal RC oscillator, CLKOUT function on OSC2", "set": {"CONFIG1H.FOSC": "00000009"}, "from": "intosc"},
        {"id": "lp", "label": "LP oscillator", "set": {"CONFIG1H.FOSC": "00000000"}, "mul": 32768},
        {"id": "xt", "label": "XT oscillator", "set": {"CONFIG1H.FOSC": "00000001"}, "from": "ext"}
      ]
    },
    {
      "id": "pll",
      "label": "PLL (PLLEN)",
      "kind": "multiplier",
      "x": 2,
      "y": 1,
      "max": 48000000,
      "options": [
        {"id": "off", "label": "PLL off (or enabled by your code)", "from": "primary", "set": {"CONFIG1H.PLLEN": "00000000"}},
        {"id": "x4", "label": "x4", "from": "primary", "mul": 4, "set": {"CONFIG1H.PLLEN": "00000010"}}
      ],
      "tooltip": "USB needs 48 MHz from the PLL: 12 MHz x4 or 16 MHz x3."
    },
    {
      "id": "sysclk",
      "label": "CPU clock (CPUDIV)",
      "kind": "divider",
      "x": 3,
      "y": 1,
      "options": [
        {"id": "2", "label": "/2", "from": "pll", "div": 2, "set": {"CONFIG1L.CPUDIV": "00000008"}},
        {"id": "3", "label": "/3", "from": "pll", "div": 3, "set": {"CONFIG1L.CPUDIV": "00000010"}},
        {"id": "4", "label": "/4", "from": "pll", "div": 4, "set": {"CONFIG1L.CPUDIV": "00000018"}},
        {"id": "1", "label": "/1", "from": "pll", "div": 1, "set": {"CONFIG1L.CPUDIV": "00000000"}}
      ],
      "max": 48000000,
      "consumer": true
    },
    {
      "id": "fcy",
      "label": "Instruction clock (Fosc/4)",
      "kind": "output",
      "x": 6,
      "y": 1,
      "options": [
        {"id": "4", "label": "/4", "from": "sysclk", "div": 4}
      ]
    }
  ],
  "constraints": [
    {"expr": "sel.primary != 'hs' || (in.ext >= 4000000)", "message": "HS oscillator: the external frequency must be 4 MHz or more."},
    {"expr": "sel.primary != 'xt' || (in.ext >= 100000 && in.ext <= 4000000)", "message": "XT oscillator: the external frequency must be 0.1-4 MHz."}
  ],
  "symbols": {
    "CONFIG1H.FOSC": {"ECCLKOUTH": "00000004", "ECCLKOUTL": "0000000C", "ECCLKOUTM": "0000000A", "ECH": "00000005", "ECL": "0000000D", "ECM": "0000000B", "ERC": "00000007", "ERCCLKOUT": "00000003", "HS": "00000002", "IRC": "00000008", "IRCCLKOUT": "00000009", "LP": "00000000", "XT": "00000001"},
    "CONFIG1H.PLLEN": {"OFF": "00000000", "ON": "00000010"},
    "CONFIG1L.CPUDIV": {"CLKDIV2": "00000008", "CLKDIV3": "00000010", "CLKDIV4": "00000018", "NOCLKDIV": "00000000"}
  }
}
