{
  "schema": 1,
  "id": "pic_usb_pic18f24k50",
  "title": "PIC USB clock tree (3x/4x PLL) (PIC18F24K50, PIC18F25K50, PIC18F45K50 and 3 more)",
  "vendor": "Microchip",
  "source": "PIC16F145x/PIC18 USB data sheets (Oscillator sections); fuse values from the Microchip DFP EDC files",
  "devices": ["^PIC18F24K50$", "^PIC18F25K50$", "^PIC18F45K50$", "^PIC18LF24K50$", "^PIC18LF25K50$", "^PIC18LF45K50$"],
  "fosc": "sysclk",
  "inputs": {
    "ext": {"label": "External frequency", "default": 12000000, "min": 1, "max": 48000000},
    "intosc": {"label": "Internal oscillator frequency", "default": 16000000, "min": 31000, "max": 16000000}
  },
  "settings": ["CONFIG1L.LS48MHZ", "CONFIG1H.PCLKEN", "CONFIG1H.FCMEN", "CONFIG1H.IESO"],
  "nodes": [
    {
      "id": "ext",
      "label": "External oscillator / clock",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext"
    },
    {
      "id": "intosc",
      "label": "Internal oscillator (set by your code)",
      "kind": "source",
      "x": 0,
      "y": 3,
      "input": "intosc",
      "tooltip": "The internal oscillator frequency is chosen at runtime (OSCCON.IRCF): 16 MHz (HFINTOSC) feeds the 3x PLL."
    },
    {
      "id": "primary",
      "label": "Oscillator (FOSC)",
      "kind": "mux",
      "x": 1,
      "y": 1,
      "options": [
        {"id": "echclko", "label": "EC oscillator, high power 16MHz to 48MHz, clock output on OS", "set": {"CONFIG1H.FOSC": "00000004"}, "from": "ext"},
        {"id": "echio", "label": "EC oscillator, high power 16MHz to 48MHz", "set": {"CONFIG1H.FOSC": "00000005"}, "from": "ext"},
        {"id": "eclclko", "label": "EC oscillator, low power <4MHz, clock output on OSC2", "set": {"CONFIG1H.FOSC": "0000000C"}, "from": "ext"},
        {"id": "eclio", "label": "EC oscillator, low power <4MHz", "set": {"CONFIG1H.FOSC": "0000000D"}, "from": "ext"},
        {"id": "ecmclko", "label": "EC oscillator, medium power 4MHz to 16MHz, clock output on O", "set": {"CONFIG1H.FOSC": "0000000A"}, "from": "ext"},
        {"id": "ecmio", "label": "EC oscillator, medium power 4MHz to 16MHz", "set": {"CONFIG1H.FOSC": "0000000B"}, "from": "ext"},
        {"id": "hsh", "label": "HS oscillator, high power 16MHz to 25MHz", "set": {"CONFIG1H.FOSC": "00000002"}, "from": "ext"},
        {"id": "hsm", "label": "HS oscillator, medium power 4MHz to 16MHz", "set": {"CONFIG1H.FOSC": "00000003"}, "from": "ext"},
        {"id": "intoscclko", "label": "Internal oscillator, clock output on OSC2", "set": {"CONFIG1H.FOSC": "00000009"}, "from": "intosc"},
        {"id": "intoscio", "label": "Internal oscillator", "set": {"CONFIG1H.FOSC": "00000008"}, "from": "intosc"},
        {"id": "lp", "label": "LP oscillator", "set": {"CONFIG1H.FOSC": "00000000"}, "mul": 32768},
        {"id": "rcclko", "label": "External RC oscillator, clock output on OSC2", "set": {"CONFIG1H.FOSC": "00000006"}, "from": "ext"},
        {"id": "rcio", "label": "External RC oscillator", "set": {"CONFIG1H.FOSC": "00000007"}, "from": "ext"},
        {"id": "xt", "label": "XT oscillator", "set": {"CONFIG1H.FOSC": "00000001"}, "from": "ext"}
      ]
    },
    {
      "id": "pll",
      "label": "PLL (CFGPLLEN)",
      "kind": "multiplier",
      "x": 2,
      "y": 1,
      "max": 48000000,
      "options": [
        {"id": "off", "label": "PLL off (or enabled by your code)", "from": "primary", "set": {"CONFIG1L.CFGPLLEN": "00000000"}},
        {"id": "x3", "label": "x3", "from": "primary", "mul": 3, "set": {"CONFIG1L.CFGPLLEN": "00000002", "CONFIG1L.PLLSEL": "00000001"}},
        {"id": "x4", "label": "x4", "from": "primary", "mul": 4, "set": {"CONFIG1L.CFGPLLEN": "00000002", "CONFIG1L.PLLSEL": "00000000"}}
      ],
      "tooltip": "USB needs 48 MHz from the PLL: 12 MHz x4 or 16 MHz x3."
    },
    {
      "id": "sysclk",
      "label": "CPU clock (CPUDIV)",
      "kind": "divider",
      "x": 3,
      "y": 1,
      "options": [
        {"id": "2", "label": "/2", "from": "pll", "div": 2, "set": {"CONFIG1L.CPUDIV": "00000008"}},
        {"id": "3", "label": "/3", "from": "pll", "div": 3, "set": {"CONFIG1L.CPUDIV": "00000010"}},
        {"id": "6", "label": "/6", "from": "pll", "div": 6, "set": {"CONFIG1L.CPUDIV": "00000018"}},
        {"id": "1", "label": "/1", "from": "pll", "div": 1, "set": {"CONFIG1L.CPUDIV": "00000000"}}
      ],
      "max": 48000000,
      "consumer": true
    },
    {
      "id": "fcy",
      "label": "Instruction clock (Fosc/4)",
      "kind": "output",
      "x": 6,
      "y": 1,
      "options": [
        {"id": "4", "label": "/4", "from": "sysclk", "div": 4}
      ]
    }
  ],
  "constraints": [
    {"expr": "sel.primary != 'echclko' || (in.ext >= 16000000 && in.ext <= 48000000)", "message": "EC oscillator: the external frequency must be 16-48 MHz."},
    {"expr": "sel.primary != 'echio' || (in.ext >= 16000000 && in.ext <= 48000000)", "message": "EC oscillator: the external frequency must be 16-48 MHz."},
    {"expr": "sel.primary != 'eclclko' || (in.ext <= 4000000)", "message": "EC oscillator: the external frequency must be 0-4 MHz."},
    {"expr": "sel.primary != 'eclio' || (in.ext <= 4000000)", "message": "EC oscillator: the external frequency must be 0-4 MHz."},
    {"expr": "sel.primary != 'ecmclko' || (in.ext >= 4000000 && in.ext <= 16000000)", "message": "EC oscillator: the external frequency must be 4-16 MHz."},
    {"expr": "sel.primary != 'ecmio' || (in.ext >= 4000000 && in.ext <= 16000000)", "message": "EC oscillator: the external frequency must be 4-16 MHz."},
    {"expr": "sel.primary != 'hsh' || (in.ext >= 16000000 && in.ext <= 25000000)", "message": "HS oscillator: the external frequency must be 16-25 MHz."},
    {"expr": "sel.primary != 'hsm' || (in.ext >= 4000000 && in.ext <= 16000000)", "message": "HS oscillator: the external frequency must be 4-16 MHz."},
    {"expr": "sel.primary != 'xt' || (in.ext >= 100000 && in.ext <= 4000000)", "message": "XT oscillator: the external frequency must be 0.1-4 MHz."}
  ],
  "symbols": {
    "CONFIG1H.FOSC": {"ECHCLKO": "00000004", "ECHIO": "00000005", "ECLCLKO": "0000000C", "ECLIO": "0000000D", "ECMCLKO": "0000000A", "ECMIO": "0000000B", "HSH": "00000002", "HSM": "00000003", "INTOSCCLKO": "00000009", "INTOSCIO": "00000008", "LP": "00000000", "RCCLKO": "00000006", "RCIO": "00000007", "XT": "00000001"},
    "CONFIG1L.CFGPLLEN": {"OFF": "00000000", "ON": "00000002"},
    "CONFIG1L.CPUDIV": {"CLKDIV2": "00000008", "CLKDIV3": "00000010", "CLKDIV6": "00000018", "NOCLKDIV": "00000000"},
    "CONFIG1L.PLLSEL": {"PLL3X": "00000001", "PLL4X": "00000000"}
  }
}
