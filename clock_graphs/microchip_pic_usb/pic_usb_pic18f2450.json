{
  "schema": 1,
  "id": "pic_usb_pic18f2450",
  "title": "PIC18 USB clock tree (96 MHz PLL) (PIC18F2450, PIC18F2455, PIC18F2458 and 17 more)",
  "vendor": "Microchip",
  "source": "PIC16F145x/PIC18 USB data sheets (Oscillator sections); fuse values from the Microchip DFP EDC files",
  "devices": ["^PIC18F2450$", "^PIC18F2455$", "^PIC18F2458$", "^PIC18F2550$", "^PIC18F2553$", "^PIC18F4450$", "^PIC18F4455$", "^PIC18F4458$", "^PIC18F4550$", "^PIC18F4553$", "^PIC18LF2450$", "^PIC18LF2455$", "^PIC18LF2458$", "^PIC18LF2550$", "^PIC18LF2553$", "^PIC18LF4450$", "^PIC18LF4455$", "^PIC18LF4458$", "^PIC18LF4550$", "^PIC18LF4553$"],
  "fosc": "sysclk",
  "inputs": {
    "ext": {"label": "External frequency", "default": 8000000, "min": 1, "max": 48000000},
    "intosc": {"label": "Internal oscillator frequency", "default": 8000000, "min": 31000, "max": 8000000}
  },
  "settings": ["CONFIG1L.USBDIV", "CONFIG1H.FCMEN", "CONFIG1H.IESO"],
  "nodes": [
    {
      "id": "ext",
      "label": "External oscillator / clock",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext"
    },
    {
      "id": "intosc",
      "label": "Internal oscillator (set by your code)",
      "kind": "source",
      "x": 0,
      "y": 3,
      "input": "intosc",
      "tooltip": "The internal oscillator frequency is chosen at runtime (OSCCON.IRCF): enter the frequency your code sets."
    },
    {
      "id": "pllsrc",
      "label": "PLL input",
      "kind": "mux",
      "x": 1,
      "y": 0,
      "options": [
        {"id": "ext", "label": "External oscillator", "from": "ext"}
      ]
    },
    {
      "id": "prediv",
      "label": "PLL prescaler (PLLDIV)",
      "kind": "divider",
      "x": 2,
      "y": 0,
      "tooltip": "Divides the oscillator to the 4 MHz the 96 MHz PLL needs.",
      "options": [
        {"id": "1", "label": "/1", "from": "pllsrc", "div": 1, "set": {"CONFIG1L.PLLDIV": "00000000"}},
        {"id": "10", "label": "/10", "from": "pllsrc", "div": 10, "set": {"CONFIG1L.PLLDIV": "00000006"}},
        {"id": "12", "label": "/12", "from": "pllsrc", "div": 12, "set": {"CONFIG1L.PLLDIV": "00000007"}},
        {"id": "2", "label": "/2", "from": "pllsrc", "div": 2, "set": {"CONFIG1L.PLLDIV": "00000001"}},
        {"id": "3", "label": "/3", "from": "pllsrc", "div": 3, "set": {"CONFIG1L.PLLDIV": "00000002"}},
        {"id": "4", "label": "/4", "from": "pllsrc", "div": 4, "set": {"CONFIG1L.PLLDIV": "00000003"}},
        {"id": "5", "label": "/5", "from": "pllsrc", "div": 5, "set": {"CONFIG1L.PLLDIV": "00000004"}},
        {"id": "6", "label": "/6", "from": "pllsrc", "div": 6, "set": {"CONFIG1L.PLLDIV": "00000005"}}
      ]
    },
    {
      "id": "pll",
      "label": "96 MHz PLL",
      "kind": "multiplier",
      "x": 3,
      "y": 0,
      "options": [
        {"id": "24", "label": "x24", "from": "prediv", "mul": 24}
      ]
    },
    {
      "id": "primary",
      "label": "Oscillator (FOSC)",
      "kind": "mux",
      "x": 4,
      "y": 1,
      "options": [
        {"id": "ecio_ec", "label": "EC oscillator, port function on RA6 (ECIO)", "set": {"CONFIG1H.FOSC": "00000004"}, "from": "ext"},
        {"id": "ecpllio_ec", "label": "EC oscillator, PLL enabled, port function on RA6 (ECPIO)", "set": {"CONFIG1H.FOSC": "00000006"}, "from": "pll", "keeps": ["ext"]},
        {"id": "ecpll_ec", "label": "EC oscillator, PLL enabled, CLKO function on RA6 (ECPLL)", "set": {"CONFIG1H.FOSC": "00000007"}, "from": "pll", "keeps": ["ext"]},
        {"id": "ec_ec", "label": "EC oscillator, CLKO function on RA6 (EC)", "set": {"CONFIG1H.FOSC": "00000005"}, "from": "ext"},
        {"id": "hs", "label": "HS oscillator (HS)", "set": {"CONFIG1H.FOSC": "0000000C"}, "from": "ext"},
        {"id": "hspll_hs", "label": "HS oscillator, PLL enabled (HSPLL)", "set": {"CONFIG1H.FOSC": "0000000E"}, "from": "pll", "keeps": ["ext"]},
        {"id": "intoscio_ec", "label": "Internal oscillator, port function on RA6, EC used by USB (I", "set": {"CONFIG1H.FOSC": "00000008"}, "from": "intosc"},
        {"id": "intosc_ec", "label": "Internal oscillator, CLKO function on RA6, EC used by USB (I", "set": {"CONFIG1H.FOSC": "00000009"}, "from": "intosc"},
        {"id": "intosc_hs", "label": "Internal oscillator, HS oscillator used by USB (INTHS)", "set": {"CONFIG1H.FOSC": "0000000B"}, "from": "intosc"},
        {"id": "intosc_xt", "label": "Internal oscillator, XT used by USB (INTXT)", "set": {"CONFIG1H.FOSC": "0000000A"}, "from": "intosc"},
        {"id": "xtpll_xt", "label": "XT oscillator, PLL enabled (XTPLL)", "set": {"CONFIG1H.FOSC": "00000002"}, "from": "pll", "keeps": ["ext"]},
        {"id": "xt_xt", "label": "XT oscillator (XT)", "set": {"CONFIG1H.FOSC": "00000000"}, "from": "ext"}
      ]
    },
    {
      "id": "sysclk",
      "label": "CPU clock (CPUDIV)",
      "kind": "divider",
      "x": 5,
      "y": 1,
      "options": [
        {"id": "p2", "label": "/2 (PLL)", "from": "primary", "div": 2, "set": {"CONFIG1L.CPUDIV": "00000000"}, "when": "sel.primary == 'ecpllio_ec' || sel.primary == 'ecpll_ec' || sel.primary == 'hspll_hs' || sel.primary == 'xtpll_xt'"},
        {"id": "o1", "label": "/1", "from": "primary", "div": 1, "set": {"CONFIG1L.CPUDIV": "00000000"}, "when": "!(sel.primary == 'ecpllio_ec' || sel.primary == 'ecpll_ec' || sel.primary == 'hspll_hs' || sel.primary == 'xtpll_xt')"},
        {"id": "p3", "label": "/3 (PLL)", "from": "primary", "div": 3, "set": {"CONFIG1L.CPUDIV": "00000008"}, "when": "sel.primary == 'ecpllio_ec' || sel.primary == 'ecpll_ec' || sel.primary == 'hspll_hs' || sel.primary == 'xtpll_xt'"},
        {"id": "o2", "label": "/2", "from": "primary", "div": 2, "set": {"CONFIG1L.CPUDIV": "00000008"}, "when": "!(sel.primary == 'ecpllio_ec' || sel.primary == 'ecpll_ec' || sel.primary == 'hspll_hs' || sel.primary == 'xtpll_xt')"},
        {"id": "p4", "label": "/4 (PLL)", "from": "primary", "div": 4, "set": {"CONFIG1L.CPUDIV": "00000010"}, "when": "sel.primary == 'ecpllio_ec' || sel.primary == 'ecpll_ec' || sel.primary == 'hspll_hs' || sel.primary == 'xtpll_xt'"},
        {"id": "o3", "label": "/3", "from": "primary", "div": 3, "set": {"CONFIG1L.CPUDIV": "00000010"}, "when": "!(sel.primary == 'ecpllio_ec' || sel.primary == 'ecpll_ec' || sel.primary == 'hspll_hs' || sel.primary == 'xtpll_xt')"},
        {"id": "p6", "label": "/6 (PLL)", "from": "primary", "div": 6, "set": {"CONFIG1L.CPUDIV": "00000018"}, "when": "sel.primary == 'ecpllio_ec' || sel.primary == 'ecpll_ec' || sel.primary == 'hspll_hs' || sel.primary == 'xtpll_xt'"},
        {"id": "o4", "label": "/4", "from": "primary", "div": 4, "set": {"CONFIG1L.CPUDIV": "00000018"}, "when": "!(sel.primary == 'ecpllio_ec' || sel.primary == 'ecpll_ec' || sel.primary == 'hspll_hs' || sel.primary == 'xtpll_xt')"}
      ],
      "bypass": "sel.primary == 'intoscio_ec' || sel.primary == 'intosc_ec' || sel.primary == 'intosc_hs' || sel.primary == 'intosc_xt'",
      "tooltip": "CPUDIV divides the primary oscillator and the PLL, not the internal oscillator.",
      "max": 48000000,
      "consumer": true
    },
    {
      "id": "fcy",
      "label": "Instruction clock (Fosc/4)",
      "kind": "output",
      "x": 6,
      "y": 1,
      "options": [
        {"id": "4", "label": "/4", "from": "sysclk", "div": 4}
      ]
    }
  ],
  "constraints": [
    {"expr": "sel.primary != 'hs' || (in.ext >= 4000000)", "message": "HS oscillator (HS): the external frequency must be 4 MHz or more."},
    {"expr": "sel.primary != 'hspll_hs' || (in.ext >= 4000000)", "message": "HS oscillator: the external frequency must be 4 MHz or more."},
    {"expr": "sel.primary != 'xtpll_xt' || (in.ext >= 100000 && in.ext <= 4000000)", "message": "XT oscillator: the external frequency must be 0.1-4 MHz."},
    {"expr": "sel.primary != 'xt_xt' || (in.ext >= 100000 && in.ext <= 4000000)", "message": "XT oscillator (XT): the external frequency must be 0.1-4 MHz."},
    {"expr": "!(sel.primary == 'ecpllio_ec' || sel.primary == 'ecpll_ec' || sel.primary == 'hspll_hs' || sel.primary == 'xtpll_xt') || !(1) || (f.prediv >= 3990000 && f.prediv <= 4010000)", "message": "The 96 MHz PLL needs 4 MHz: choose PLLDIV so that the oscillator / PLLDIV is 4 MHz."}
  ],
  "symbols": {
    "CONFIG1H.FOSC": {"ECIO_EC": "00000004", "ECPLLIO_EC": "00000006", "ECPLL_EC": "00000007", "EC_EC": "00000005", "HS": "0000000C", "HSPLL_HS": "0000000E", "INTOSCIO_EC": "00000008", "INTOSC_EC": "00000009", "INTOSC_HS": "0000000B", "INTOSC_XT": "0000000A", "XTPLL_XT": "00000002", "XT_XT": "00000000"},
    "CONFIG1L.CPUDIV": {"OSC1_PLL2": "00000000", "OSC2_PLL3": "00000008", "OSC3_PLL4": "00000010", "OSC4_PLL6": "00000018"},
    "CONFIG1L.PLLDIV": {"1": "00000000", "10": "00000006", "12": "00000007", "2": "00000001", "3": "00000002", "4": "00000003", "5": "00000004", "6": "00000005"}
  }
}
