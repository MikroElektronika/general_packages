        {"id": "8", "label": "/8", "from": "clock_source", "div": 8, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000300"}},
        {"id": "16", "label": "/16", "from": "clock_source", "div": 16, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000400"}},
        {"id": "32", "label": "/32", "from": "clock_source", "div": 32, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000500"}},
        {"id": "64", "label": "/64", "from": "clock_source", "div": 64, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000600"}}
