      "label": "CLKOUT",
      "kind": "output",
      "x": 4,
      "y": 6,
      "tooltip": "Frequency output on the CLKOUT pin if CLKOUT is enabled. \nMaximum frequency is 16 MHz.",
      "max": 16000000,
      "options": [
        {"id": "value", "label": "CLKOUT ${value}Hz", "from": "clkout_div"}
      ],
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "f.iclk_display > 0", "message": "The system clock source must be greater than 0."},
    {"expr": "(f.iclk_display >= f.pclka_display) && (f.iclk_display >= f.pclkb_display)", "message": "ICLK must not be less than PCLKA or PCLKB"},
    {"expr": "(f.iclk_display >= f.fclk_display)", "message": "ICLK must not be less than FCLK"},
    {"expr": "(f.pclka_display >= f.pclkb_display)", "message": "PCKLA must not be less than PCLKB"},
    {"expr": "(f.pclkd_display >= f.pclka_display) && (f.pclkd_display >= f.pclkb_display)", "message": "PCLKD must not be less than PCLKA or PCLKB"},
    {"expr": "((f.pclkc_display / f.pclkb_display) <= 4) && ((f.pclkb_display / f.pclkc_display) <= 8)", "message": "PCLKB:PCLKC ratio must equal 1:1, 1:2, 1:4, 2:1, 4:1, or 8:1"},
    {"expr": "(f.clkout_display == 4000000) || (f.clkout_source != 8000000)", "message": "CLKOUT divider must be 2 if MOCO is selected as the CLKOUT source"},
    {"expr": "(f.xtal_freq <= 20000000)", "message": "Maximum allowed XTAL frequency for RA4M1 is 20MHz"},
    {"expr": "('disabled' == sel.pll_source) || ((f.pll_display > 0) && ((f.pll_div >= 4000000) && (f.pll_div <= 12500000)))", "message": "PLL Reference Clock after divider must be between 4 and 12.5 MHz"},
    {"expr": "(f.pll_display <= 32000000) || (sel.pll_div != '4')", "message": "PLL frequency should be between 24MHz and 32MHz, when the PLL division factor is '/4'"}
  ]
}
