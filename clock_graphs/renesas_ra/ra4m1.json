        {"id": "2", "label": "/2", "from": "clock_source", "div": 2, "set": {"SYSTEM_SCKDIVCR.FCK": "10000000"}},
        {"id": "4", "label": "/4", "from": "clock_source", "div": 4, "set": {"SYSTEM_SCKDIVCR.FCK": "20000000"}},
        {"id": "8", "label": "/8", "from": "clock_source", "div": 8, "set": {"SYSTEM_SCKDIVCR.FCK": "30000000"}},
        {"id": "16", "label": "/16", "from": "clock_source", "div": 16, "set": {"SYSTEM_SCKDIVCR.FCK": "40000000"}},
        {"id": "32", "label": "/32", "from": "clock_source", "div": 32, "set": {"SYSTEM_SCKDIVCR.FCK": "50000000"}},
        {"id": "64", "label": "/64", "from": "clock_source", "div": 64, "set": {"SYSTEM_SCKDIVCR.FCK": "60000000"}}
      ],
      "default": "2"
    },
