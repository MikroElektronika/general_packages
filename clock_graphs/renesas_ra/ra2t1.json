{
  "schema": 1,
  "id": "ra2t1",
  "title": "Renesas RA2T1 clock tree",
  "vendor": "Renesas",
  "source": "Renesas FSP 6.5.0 (BSD-3-Clause), Renesas##BSP##ra2t1##fsp####6.5.0.xml",
  "devices": ["^R7[FK]A2T1"],
  "fosc": "iclk_display",
  "inputs": {
    "xtal_freq": {"label": "XTAL frequency", "default": 16000000, "max": 20000000, "min": 1}
  },
  "settings": [],
  "nodes": [
    {
      "id": "xtal_freq",
      "label": "XTAL",
      "kind": "source",
      "x": 0,
      "y": 0,
      "tooltip": "Click to edit the XTAL frequency.",
      "input": "xtal_freq",
      "enable": {"field": "SYSTEM_MOSCCR.MOSTP", "on": "00000000", "off": "00000001", "auto": "both"}
    },
    {
      "id": "hoco_freq",
      "label": "HOCO",
      "kind": "source",
      "x": 0,
      "y": 5,
      "options": [
        {"id": "24m", "label": "HOCO 24MHz", "mul": 24000000, "set": {"SYSTEM_HOCOCR2.HCFRQ1": "00000000"}},
        {"id": "32m", "label": "HOCO 32MHz", "mul": 32000000, "set": {"SYSTEM_HOCOCR2.HCFRQ1": "00000010"}},
        {"id": "48m", "label": "HOCO 48MHz", "mul": 48000000, "set": {"SYSTEM_HOCOCR2.HCFRQ1": "00000020"}},
        {"id": "64m", "label": "HOCO 64MHz", "mul": 64000000, "set": {"SYSTEM_HOCOCR2.HCFRQ1": "00000028"}}
      ],
      "default": "48m",
      "enable": {"field": "SYSTEM_HOCOCR.HCSTP", "on": "00000000", "off": "00000001", "auto": "on"}
    },
    {
      "id": "loco_freq",
      "label": "LOCO 32768Hz",
      "kind": "source",
      "x": 0,
      "y": 1,
      "options": [
        {"id": "32768", "label": "LOCO 32768Hz", "mul": 32768}
      ],
      "default": "32768",
      "enable": {"field": "SYSTEM_LOCOCR.LCSTP", "on": "00000000", "off": "00000001", "auto": "on"}
    },
    {
      "id": "moco_freq",
      "label": "MOCO 8MHz",
      "kind": "source",
      "x": 0,
      "y": 2,
      "options": [
        {"id": "8m", "label": "MOCO 8MHz", "mul": 8000000}
      ],
      "default": "8m",
      "enable": {"field": "SYSTEM_MOCOCR.MCSTP", "on": "00000000", "off": "00000001", "auto": "on"}
    },
    {
      "id": "clock_source",
      "label": "Clock source",
      "kind": "mux",
      "x": 2,
      "y": 2,
      "options": [
        {"id": "hoco", "label": "HOCO", "from": "hoco_freq", "set": {"SYSTEM_SCKSCR.CKSEL": "00000000"}},
        {"id": "moco", "label": "MOCO", "from": "moco_freq", "set": {"SYSTEM_SCKSCR.CKSEL": "00000001"}},
        {"id": "loco", "label": "LOCO", "from": "loco_freq", "set": {"SYSTEM_SCKSCR.CKSEL": "00000002"}},
        {"id": "xtal", "label": "XTAL", "from": "xtal_freq", "set": {"SYSTEM_SCKSCR.CKSEL": "00000003"}}
      ],
      "default": "hoco"
    },
    {
      "id": "iclk_div",
      "label": "ICLK divider",
      "kind": "divider",
      "x": 3,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "clock_source", "div": 1, "set": {"SYSTEM_SCKDIVCR.ICK": "00000000"}},
        {"id": "2", "label": "/2", "from": "clock_source", "div": 2, "set": {"SYSTEM_SCKDIVCR.ICK": "01000000"}},
        {"id": "4", "label": "/4", "from": "clock_source", "div": 4, "set": {"SYSTEM_SCKDIVCR.ICK": "02000000"}},
        {"id": "8", "label": "/8", "from": "clock_source", "div": 8, "set": {"SYSTEM_SCKDIVCR.ICK": "03000000"}},
        {"id": "16", "label": "/16", "from": "clock_source", "div": 16, "set": {"SYSTEM_SCKDIVCR.ICK": "04000000"}},
        {"id": "32", "label": "/32", "from": "clock_source", "div": 32, "set": {"SYSTEM_SCKDIVCR.ICK": "05000000"}},
        {"id": "64", "label": "/64", "from": "clock_source", "div": 64, "set": {"SYSTEM_SCKDIVCR.ICK": "06000000"}}
      ],
      "default": "1"
    },
    {
      "id": "iclk_display",
      "label": "ICLK",
      "kind": "output",
      "x": 4,
      "y": 0,
      "tooltip": "The system clock (ICLK) is used as the operating clock of the CPU, DTC, ROM and RAM. \nIt should not exceed 64 MHz.",
      "max": 64000000,
      "options": [
        {"id": "value", "label": "ICLK ${value}Hz", "from": "iclk_div"}
      ],
      "consumer": true
    },
    {
      "id": "pclkb_div",
      "label": "PCLKB divider",
      "kind": "divider",
      "x": 3,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "clock_source", "div": 1, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000000"}},
        {"id": "2", "label": "/2", "from": "clock_source", "div": 2, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000100"}},
        {"id": "4", "label": "/4", "from": "clock_source", "div": 4, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000200"}},
        {"id": "8", "label": "/8", "from": "clock_source", "div": 8, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000300"}},
        {"id": "16", "label": "/16", "from": "clock_source", "div": 16, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000400"}},
        {"id": "32", "label": "/32", "from": "clock_source", "div": 32, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000500"}},
        {"id": "64", "label": "/64", "from": "clock_source", "div": 64, "set": {"SYSTEM_SCKDIVCR.PCKB": "00000600"}}
      ],
      "default": "2"
    },
    {
      "id": "pclkb_display",
      "label": "PCLKB",
      "kind": "output",
      "x": 4,
      "y": 1,
      "tooltip": "The Peripheral clock B (PCLKB) is used as the operating clock for CAC, ELC, I/OPorts, KINT, POEG, GPT, AGTW, ACMPHS, WDT, IWDT, SCI, IIC, SPI, CRC, ADC12 and DOC. \nIt should not exceed 32 MHz.",
      "max": 32000000,
      "options": [
        {"id": "value", "label": "PCLKB ${value}Hz", "from": "pclkb_div"}
      ],
      "consumer": true
    },
    {
      "id": "pclkd_div",
      "label": "PCLKD divider",
      "kind": "divider",
      "x": 3,
      "y": 2,
      "options": [
        {"id": "1", "label": "/1", "from": "clock_source", "div": 1, "set": {"SYSTEM_SCKDIVCR.PCKD": "00000000"}},
        {"id": "2", "label": "/2", "from": "clock_source", "div": 2, "set": {"SYSTEM_SCKDIVCR.PCKD": "00000001"}},
        {"id": "4", "label": "/4", "from": "clock_source", "div": 4, "set": {"SYSTEM_SCKDIVCR.PCKD": "00000002"}},
        {"id": "8", "label": "/8", "from": "clock_source", "div": 8, "set": {"SYSTEM_SCKDIVCR.PCKD": "00000003"}},
        {"id": "16", "label": "/16", "from": "clock_source", "div": 16, "set": {"SYSTEM_SCKDIVCR.PCKD": "00000004"}},
        {"id": "32", "label": "/32", "from": "clock_source", "div": 32, "set": {"SYSTEM_SCKDIVCR.PCKD": "00000005"}},
        {"id": "64", "label": "/64", "from": "clock_source", "div": 64, "set": {"SYSTEM_SCKDIVCR.PCKD": "00000006"}}
      ],
      "default": "1"
    },
    {
      "id": "pclkd_display",
      "label": "PCLKD",
      "kind": "output",
      "x": 4,
      "y": 2,
      "tooltip": "The Peripheral clock D (PCLKD) is used as the operating clock for the GPT (count clock) module and ADC12.\nWhen ADC12 is not used PCLKD cannot exceed 64MHz. When ADC12 is used PCLKD must be at least 1MHz and cannot exceed 64MHz.",
      "max": 64000000,
      "options": [
        {"id": "value", "label": "PCLKD ${value}Hz", "from": "pclkd_div"}
      ],
      "consumer": true
    },
    {
      "id": "clkout_source",
      "label": "CLKOUT source",
      "kind": "mux",
      "x": 2,
      "y": 6,
      "options": [
        {"id": "disabled", "label": "Disabled", "mul": 0, "set": {"SYSTEM_CKOCR.CKOEN": "00000000"}},
        {"id": "hoco", "label": "HOCO", "from": "hoco_freq", "set": {"SYSTEM_CKOCR.CKOSEL": "00000000", "SYSTEM_CKOCR.CKOEN": "00000080"}},
        {"id": "moco", "label": "MOCO", "from": "moco_freq", "set": {"SYSTEM_CKOCR.CKOSEL": "00000001", "SYSTEM_CKOCR.CKOEN": "00000080"}},
        {"id": "loco", "label": "LOCO", "from": "loco_freq", "set": {"SYSTEM_CKOCR.CKOSEL": "00000002", "SYSTEM_CKOCR.CKOEN": "00000080"}},
        {"id": "xtal", "label": "XTAL", "from": "xtal_freq", "set": {"SYSTEM_CKOCR.CKOSEL": "00000003", "SYSTEM_CKOCR.CKOEN": "00000080"}}
      ],
      "default": "disabled"
    },
    {
      "id": "clkout_div",
      "label": "CLKOUT divider",
      "kind": "divider",
      "x": 3,
      "y": 6,
      "options": [
        {"id": "1", "label": "/1", "from": "clkout_source", "div": 1, "set": {"SYSTEM_CKOCR.CKODIV": "00000000"}},
        {"id": "2", "label": "/2", "from": "clkout_source", "div": 2, "set": {"SYSTEM_CKOCR.CKODIV": "00000010"}},
        {"id": "4", "label": "/4", "from": "clkout_source", "div": 4, "set": {"SYSTEM_CKOCR.CKODIV": "00000020"}},
        {"id": "8", "label": "/8", "from": "clkout_source", "div": 8, "set": {"SYSTEM_CKOCR.CKODIV": "00000030"}},
        {"id": "16", "label": "/16", "from": "clkout_source", "div": 16, "set": {"SYSTEM_CKOCR.CKODIV": "00000040"}},
        {"id": "32", "label": "/32", "from": "clkout_source", "div": 32, "set": {"SYSTEM_CKOCR.CKODIV": "00000050"}},
        {"id": "64", "label": "/64", "from": "clkout_source", "div": 64, "set": {"SYSTEM_CKOCR.CKODIV": "00000060"}},
        {"id": "128", "label": "/128", "from": "clkout_source", "div": 128, "set": {"SYSTEM_CKOCR.CKODIV": "00000070"}}
      ],
      "default": "1"
    },
    {
      "id": "clkout_display",
      "label": "CLKOUT",
      "kind": "output",
      "x": 4,
      "y": 6,
      "tooltip": "Frequency output on the CLKOUT pin if CLKOUT is enabled. Maximum frequency is 16MHz.",
      "max": 16000000,
      "options": [
        {"id": "value", "label": "CLKOUT ${value}Hz", "from": "clkout_div"}
      ],
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "f.iclk_display > 0", "message": "The system clock source must be greater than 0."},
    {"expr": "(f.iclk_display >= f.pclkb_display)", "message": "ICLK must not be less than PCLKB"},
    {"expr": "(f.pclkd_display >= f.pclkb_display)", "message": "PCLKD must not be less than PCLKB"},
    {"expr": "(f.clkout_display == 4000000) || (f.clkout_source != 8000000)", "message": "CLKOUT divider must be 2 if MOCO is selected as the CLKOUT source"},
    {"expr": "(f.xtal_freq <= 20000000)", "message": "Maximum allowed XTAL frequency for RA2T1 is 20MHz"}
  ]
}
