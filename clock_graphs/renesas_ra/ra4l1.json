    {"expr": "f.iclk_display > 0", "message": "The system clock source must be greater than 0."},
    {"expr": "(f.iclk_display >= f.pclka_display) && (f.iclk_display >= f.pclkb_display)", "message": "ICLK must not be less than PCLKA or PCLKB"},
    {"expr": "(f.iclk_display >= f.fclk_display)", "message": "ICLK must not be less than FCLK"},
    {"expr": "(f.pclka_display >= f.pclkb_display)", "message": "PCLKA must not be less than PCLKB"},
    {"expr": "(f.pclkd_display >= f.pclka_display) && (f.pclkd_display >= f.pclkb_display)", "message": "PCLKD must not be less than PCLKA or PCLKB"},
    {"expr": "((f.pclkc_display / f.pclkb_display) <= 4) && ((f.pclkb_display / f.pclkc_display) <= 8)", "message": "If the ADC is used, PCLKB:PCLKC ratio must equal 1:1, 1:2, 1:4, 2:1, 4:1, or 8:1"},
    {"expr": "((f.pclkc_display / f.pclka_display) <= 4) && ((f.pclka_display / f.pclkc_display) <= 8)", "message": "If the ADC is used, PCLKA:PCLKC ratio must equal 1:1, 1:2, 1:4, 2:1, 4:1, or 8:1"},
    {"expr": "((f.i3cclk_display / 2) <= f.pclka_display && f.pclka_display <= f.i3cclk_display) || f.i3cclk_display == 0", "message": "The I3CCLK frequency must meet the following constraint: I3CCLK / 2 <= PCLKA <= I3CCLK"},
    {"expr": "(f.xtal_freq <= 20000000)", "message": "Maximum allowed XTAL frequency for RA4L1 is 20MHz"},
    {"expr": "('disabled' == sel.pll_source) || ((f.pll_display > 0) && ((f.pll_div >= 4000000) && (f.pll_div <= 12500000)))", "message": "PLL Reference Clock after divider must be between 4 and 12.5 MHz"}
  ]
