{
  "schema": 1,
  "id": "avr_attiny2313",
  "title": "AVR clock fuses (ATTINY2313, ATTINY2313A, ATTINY4313)",
  "vendor": "Microchip",
  "source": "NECTO mikroC AVR definitions (LOW.SUT_CKSEL, CKDIV8), AVR datasheets",
  "devices": ["^ATTINY2313$", "^ATTINY2313A$", "^ATTINY4313$"],
  "fosc": "cpu",
  "inputs": {
    "ext": {"label": "External frequency", "default": 8000000, "min": 1, "max": 20000000}
  },
  "settings": [],
  "nodes": [
    {
      "id": "ext",
      "label": "External clock / crystal",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext",
      "tooltip": "Frequency of the external clock, crystal, resonator or RC network."
    },
    {
      "id": "source",
      "label": "Clock source (SUT_CKSEL)",
      "kind": "mux",
      "x": 1,
      "y": 0,
      "options": [
        {"id": "ext_clock", "label": "Ext. Clock", "set": {"LOW.SUT_CKSEL": "00000000/0000000F"}, "from": "ext"},
        {"id": "int_rc_osc_4_mhz", "label": "Int. RC Osc. 4 MHz", "set": {"LOW.SUT_CKSEL": "00000002/0000000F"}, "mul": 4000000},
        {"id": "int_rc_osc_8_mhz", "label": "Int. RC Osc. 8 MHz", "set": {"LOW.SUT_CKSEL": "00000004/0000000F"}, "mul": 8000000},
        {"id": "int_rc_osc_128_khz", "label": "Int. RC Osc. 128 kHz", "set": {"LOW.SUT_CKSEL": "00000006/0000000F"}, "mul": 128000},
        {"id": "ext_crystal_osc_0_4_0_9_mhz", "label": "Ext. Crystal Osc. 0.4-0.9 MHz", "set": {"LOW.SUT_CKSEL": "00000008/0000000E"}, "from": "ext"},
        {"id": "ext_crystal_osc_0_9_3_0_mhz", "label": "Ext. Crystal Osc. 0.9-3.0 MHz", "set": {"LOW.SUT_CKSEL": "0000000A/0000000E"}, "from": "ext"},
        {"id": "ext_crystal_osc_3_0_8_0_mhz", "label": "Ext. Crystal Osc. 3.0-8.0 MHz", "set": {"LOW.SUT_CKSEL": "0000000C/0000000E"}, "from": "ext"},
        {"id": "ext_crystal_osc_8_0_mhz", "label": "Ext. Crystal Osc. 8.0-    MHz", "set": {"LOW.SUT_CKSEL": "0000000E/0000000E"}, "from": "ext"}
      ]
    },
    {
      "id": "cpu",
      "label": "CPU clock (CKDIV8)",
      "kind": "divider",
      "x": 2,
      "y": 0,
      "max": 20000000,
      "consumer": true,
      "options": [
        {"id": "1", "label": "/1", "from": "source", "set": {"LOW.CKDIV8": "00000080"}},
        {"id": "8", "label": "/8", "from": "source", "div": 8, "set": {"LOW.CKDIV8": "00000000"}}
      ]
    }
  ],
  "constraints": [
    {"expr": "sel.source != 'ext_crystal_osc_0_4_0_9_mhz' || (in.ext >= 400000 && in.ext <= 900000)", "message": "Ext. Crystal Osc. 0.4-0.9 MHz: the external frequency must be 0.4-0.9 MHz."},
    {"expr": "sel.source != 'ext_crystal_osc_0_9_3_0_mhz' || (in.ext >= 900000 && in.ext <= 3000000)", "message": "Ext. Crystal Osc. 0.9-3.0 MHz: the external frequency must be 0.9-3 MHz."},
    {"expr": "sel.source != 'ext_crystal_osc_3_0_8_0_mhz' || (in.ext >= 3000000 && in.ext <= 8000000)", "message": "Ext. Crystal Osc. 3.0-8.0 MHz: the external frequency must be 3-8 MHz."},
    {"expr": "sel.source != 'ext_crystal_osc_8_0_mhz' || (in.ext >= 8000000)", "message": "Ext. Crystal Osc. 8.0-    MHz: the external frequency must be 8-20 MHz."}
  ]
}
