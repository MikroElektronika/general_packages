{
  "schema": 1,
  "id": "pic32mz",
  "title": "PIC32MZ clock tree (configuration fuses)",
  "vendor": "Microchip",
  "source": "PIC32MZ family reference manual, section 42 Oscillators with Enhanced PLL (DS60001250)",
  "devices": ["^PIC32MZ"],
  "fosc": "sysclk",
  "inputs": {
    "posc": {"label": "POSC frequency", "default": 24000000, "min": 4000000, "max": 64000000}
  },
  "settings": [],
  "nodes": [
    {
      "id": "frc",
      "label": "FRC 8 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "FRC 8 MHz", "mul": 8000000}
      ]
    },
    {
      "id": "posc",
      "label": "Primary oscillator (POSC)",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "posc",
      "tooltip": "Crystal (XT up to 10 MHz, HS above) or external clock (EC); POSCMOD follows."
    },
    {
      "id": "poscmode",
      "label": "POSC type",
      "kind": "mux",
      "x": 0,
      "y": 2,
      "default": "crystal",
      "options": [
        {"id": "crystal", "label": "Crystal (XT/HS)", "mul": 1},
        {"id": "ec", "label": "External clock (EC)", "mul": 1}
      ]
    },
    {
      "id": "sosc",
      "label": "SOSC 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 3,
      "options": [
        {"id": "on", "label": "SOSC 32.768 kHz", "mul": 32768}
      ],
      "enable": {"field": "DEVCFG1.FSOSCEN", "on": "00000040", "off": "00000000", "auto": "both"}
    },
    {
      "id": "lprc",
      "label": "LPRC 32 kHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "LPRC 32 kHz", "mul": 32000}
      ]
    },
    {
      "id": "pllin",
      "label": "PLL input (FPLLICLK)",
      "kind": "mux",
      "x": 1,
      "y": 0,
      "options": [
        {"id": "posc", "label": "POSC", "from": "posc", "set": {"DEVCFG2.FPLLICLK": "00000000"}},
        {"id": "frc", "label": "FRC", "from": "frc", "set": {"DEVCFG2.FPLLICLK": "00000080"}}
      ]
    },
    {
      "id": "pllidiv",
      "label": "PLL /FPLLIDIV",
      "kind": "divider",
      "x": 2,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "pllin", "set": {"DEVCFG2.FPLLIDIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "pllin", "set": {"DEVCFG2.FPLLIDIV": "00000001"}, "div": 2},
        {"id": "3", "label": "/3", "from": "pllin", "set": {"DEVCFG2.FPLLIDIV": "00000002"}, "div": 3},
        {"id": "4", "label": "/4", "from": "pllin", "set": {"DEVCFG2.FPLLIDIV": "00000003"}, "div": 4},
        {"id": "5", "label": "/5", "from": "pllin", "set": {"DEVCFG2.FPLLIDIV": "00000004"}, "div": 5},
        {"id": "6", "label": "/6", "from": "pllin", "set": {"DEVCFG2.FPLLIDIV": "00000005"}, "div": 6},
        {"id": "7", "label": "/7", "from": "pllin", "set": {"DEVCFG2.FPLLIDIV": "00000006"}, "div": 7},
        {"id": "8", "label": "/8", "from": "pllin", "set": {"DEVCFG2.FPLLIDIV": "00000007"}, "div": 8}
      ],
      "min": 5000000,
      "max": 64000000,
      "tooltip": "PLL input: 5-64 MHz; FPLLRNG follows it."
    },
    {
      "id": "vco",
      "label": "PLL xFPLLMULT (VCO)",
      "kind": "multiplier",
      "x": 3,
      "y": 0,
      "min": 350000000,
      "max": 700000000,
      "range": {"from": "pllidiv", "op": "mul", "min": 1, "max": 128, "field": "DEVCFG2.FPLLMULT", "lsb": 8, "scale": 1, "offset": -1}
    },
    {
      "id": "spll",
      "label": "SPLL /FPLLODIV",
      "kind": "divider",
      "x": 4,
      "y": 0,
      "options": [
        {"id": "2", "label": "/2", "from": "vco", "set": {"DEVCFG2.FPLLODIV": "00010000"}, "div": 2},
        {"id": "4", "label": "/4", "from": "vco", "set": {"DEVCFG2.FPLLODIV": "00020000"}, "div": 4},
        {"id": "8", "label": "/8", "from": "vco", "set": {"DEVCFG2.FPLLODIV": "00030000"}, "div": 8},
        {"id": "16", "label": "/16", "from": "vco", "set": {"DEVCFG2.FPLLODIV": "00040000"}, "div": 16},
        {"id": "32", "label": "/32", "from": "vco", "set": {"DEVCFG2.FPLLODIV": "00070000"}, "div": 32}
      ]
    },
    {
      "id": "sysclk",
      "label": "SYSCLK (FNOSC)",
      "kind": "mux",
      "x": 5,
      "y": 1,
      "options": [
        {"id": "spll", "label": "SPLL", "from": "spll", "set": {"DEVCFG1.FNOSC": "00000001"}},
        {"id": "posc", "label": "POSC", "from": "posc", "set": {"DEVCFG1.FNOSC": "00000002"}},
        {"id": "sosc", "label": "SOSC", "from": "sosc", "set": {"DEVCFG1.FNOSC": "00000004"}},
        {"id": "lprc", "label": "LPRC", "from": "lprc", "set": {"DEVCFG1.FNOSC": "00000005"}},
        {"id": "frcdiv", "label": "FRC/FRCDIV (reset 1:1)", "from": "frc", "set": {"DEVCFG1.FNOSC": "00000007"}}
      ],
      "max": 200000000,
      "consumer": true
    }
  ],
  "derive": [
    {"field": "DEVCFG1.POSCMOD", "cases": [{"when": "!(sel.sysclk == 'posc' || (sel.sysclk == 'spll' && sel.pllin == 'posc'))", "value": "00000300"}, {"when": "sel.poscmode == 'ec'", "value": "00000000"}], "default": "00000200"},
    {"field": "DEVCFG2.FPLLRNG", "cases": [{"when": "f.pllidiv <= 10000000", "value": "00000010"}, {"when": "f.pllidiv <= 16000000", "value": "00000020"}, {"when": "f.pllidiv <= 26000000", "value": "00000030"}, {"when": "f.pllidiv <= 42000000", "value": "00000040"}, {"when": "f.pllidiv <= 68000000", "value": "00000050"}], "default": "00000050"}
  ],
  "variants": [
    {"devices": ["^PIC32MZ2048EFH064$", "^PIC32MZ2048EFH100$", "^PIC32MZ2048EFH144$"], "limits": {"sysclk": {"max": 252000000}}}
  ],
  "symbols": {
    "DEVCFG1.FNOSC": {"SPLL": "00000001", "POSC": "00000002", "SOSC": "00000004", "LPRC": "00000005", "FRCDIV": "00000007"},
    "DEVCFG1.POSCMOD": {"EC": "00000000", "HS": "00000200", "OFF": "00000300"},
    "DEVCFG1.FSOSCEN": {"OFF": "00000000", "ON": "00000040"},
    "DEVCFG2.FPLLICLK": {"PLL_POSC": "00000000", "PLL_FRC": "00000080"},
