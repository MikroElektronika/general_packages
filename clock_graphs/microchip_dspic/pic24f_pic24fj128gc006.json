{
  "schema": 1,
  "id": "pic24f_pic24fj128gc006",
  "title": "PIC24F clock tree (PIC24FJ128GC006, PIC24FJ128GC010, PIC24FJ64GC006 and 1 more)",
  "vendor": "Microchip",
  "source": "dsPIC30F/dsPIC33/PIC24 family reference manuals (Oscillator sections) and data sheets; fuse values from the Microchip DFP EDC files",
  "devices": ["^PIC24FJ128GC006$", "^PIC24FJ128GC010$", "^PIC24FJ64GC006$", "^PIC24FJ64GC010$"],
  "fosc": "sysclk",
  "inputs": {
    "posc": {"label": "POSC frequency", "default": 8000000, "min": 1, "max": 32000000}
  },
  "settings": ["CONFIG3.SOSCSEL", "CONFIG2.FCKSM", "CONFIG2.IESO"],
  "nodes": [
    {
      "id": "frc",
      "label": "FRC 8 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "FRC 8 MHz", "mul": 8000000}
      ]
    },
    {
      "id": "posc",
      "label": "Primary oscillator (POSC)",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "posc",
      "tooltip": "Crystal (XT up to 10 MHz, HS above) or external clock (EC); POSCMD follows."
    },
    {
      "id": "poscmode",
      "label": "POSC type",
      "kind": "mux",
      "x": 0,
      "y": 2,
      "default": "crystal",
      "options": [
        {"id": "crystal", "label": "Crystal (XT/HS)", "mul": 1},
        {"id": "ec", "label": "External clock (EC)", "mul": 1}
      ]
    },
    {
      "id": "sosc",
      "label": "SOSC 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 3,
      "options": [
        {"id": "on", "label": "SOSC 32.768 kHz", "mul": 32768}
      ]
    },
    {
      "id": "lprc",
      "label": "LPRC 31 kHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "LPRC 31 kHz", "mul": 31000}
      ]
    },
    {
      "id": "frcdiv",
      "label": "RCDIV (your code)",
      "kind": "divider",
      "x": 1,
      "y": 6,
      "default": "2",
      "tooltip": "CLKDIV.RCDIV postscaler, reset 1:2 (4 MHz).",
      "options": [
        {"id": "1", "label": "/1", "from": "frc", "div": 1},
        {"id": "2", "label": "/2", "from": "frc", "div": 2},
        {"id": "4", "label": "/4", "from": "frc", "div": 4},
        {"id": "8", "label": "/8", "from": "frc", "div": 8},
        {"id": "16", "label": "/16", "from": "frc", "div": 16},
        {"id": "32", "label": "/32", "from": "frc", "div": 32},
        {"id": "64", "label": "/64", "from": "frc", "div": 64},
        {"id": "256", "label": "/256", "from": "frc", "div": 256}
      ]
    },
    {
      "id": "pllin",
      "label": "PLL input",
      "kind": "mux",
      "x": 1,
      "y": 0,
      "tooltip": "FRCPLL: FRC (through the RCDIV postscaler on parts whose 4x/6x/8x PLL follows it); PRIPLL: POSC.",
      "options": [
        {"id": "frc", "label": "FRC", "from": "frc", "when": "sel.sysclk != 'pripll'"},
        {"id": "posc", "label": "POSC", "from": "posc", "when": "sel.sysclk == 'pripll'"}
      ]
    },
    {
      "id": "pll",
      "label": "PLL (PLLDIV)",
      "kind": "multiplier",
      "x": 2,
      "y": 0,
      "options": [
        {"id": "off", "label": "PLL disabled", "mul": 0, "set": {"CONFIG4.PLLDIV": "00003C00"}},
        {"id": "usb12", "label": "/12 -> 96 MHz PLL /3", "from": "pllin", "mul": 8, "div": 12, "set": {"CONFIG4.PLLDIV": "00001C00"}},
        {"id": "usb2", "label": "/2 -> 96 MHz PLL /3", "from": "pllin", "mul": 8, "div": 2, "set": {"CONFIG4.PLLDIV": "00000400"}},
        {"id": "usb3", "label": "/3 -> 96 MHz PLL /3", "from": "pllin", "mul": 8, "div": 3, "set": {"CONFIG4.PLLDIV": "00000800"}},
        {"id": "usb4", "label": "/4 -> 96 MHz PLL /3", "from": "pllin", "mul": 8, "div": 4, "set": {"CONFIG4.PLLDIV": "00000C00"}},
        {"id": "usb5", "label": "/5 -> 96 MHz PLL /3", "from": "pllin", "mul": 8, "div": 5, "set": {"CONFIG4.PLLDIV": "00001000"}},
        {"id": "usb6", "label": "/6 -> 96 MHz PLL /3", "from": "pllin", "mul": 8, "div": 6, "set": {"CONFIG4.PLLDIV": "00001400"}},
        {"id": "usb8", "label": "/8 -> 96 MHz PLL /3", "from": "pllin", "mul": 8, "div": 8, "set": {"CONFIG4.PLLDIV": "00001800"}},
        {"id": "usb1", "label": "/1 -> 96 MHz PLL /3", "from": "pllin", "mul": 8, "div": 1, "set": {"CONFIG4.PLLDIV": "00000000"}}
      ],
      "tooltip": "96 MHz PLL: prescaler to 4 MHz, Fosc = 96 MHz / 3 / CPDIV (reset 1:1). 4x/6x/8x PLL: input times the factor."
    },
    {
      "id": "sysclk",
      "label": "Fosc (FNOSC)",
      "kind": "mux",
      "x": 3,
      "y": 1,
      "max": 32000000,
      "consumer": true,
      "options": [
        {"id": "frc", "label": "FRC (FRC)", "from": "frc", "set": {"CONFIG2.FNOSC": "00000000"}},
        {"id": "frcpll", "label": "FRC + PLL (FRCPLL)", "from": "pll", "set": {"CONFIG2.FNOSC": "00000100"}},
        {"id": "pri", "label": "POSC (PRI)", "from": "posc", "set": {"CONFIG2.FNOSC": "00000200"}},
        {"id": "pripll", "label": "POSC + PLL (PRIPLL)", "from": "pll", "set": {"CONFIG2.FNOSC": "00000300"}},
        {"id": "sosc", "label": "SOSC (SOSC)", "from": "sosc", "set": {"CONFIG2.FNOSC": "00000400"}},
        {"id": "lprc", "label": "LPRC (LPRC)", "from": "lprc", "set": {"CONFIG2.FNOSC": "00000500"}},
        {"id": "frcdiv", "label": "FRC/RCDIV (FRCDIV)", "from": "frcdiv", "set": {"CONFIG2.FNOSC": "00000700"}}
      ]
    },
    {
      "id": "fcy",
      "label": "Fcy (Fosc/2)",
      "kind": "output",
      "x": 4,
      "y": 1,
      "options": [
        {"id": "2", "label": "/2", "from": "sysclk", "div": 2}
      ]
    }
  ],
  "derive": [
    {"field": "CONFIG2.POSCMD", "cases": [{"when": "!(sel.sysclk == 'pri' || sel.sysclk == 'pripll')", "value": "00000003"}, {"when": "sel.poscmode == 'ec'", "value": "00000000"}, {"when": "in.posc <= 10000000", "value": "00000001"}], "default": "00000002"}
  ],
  "constraints": [
    {"expr": "!(sel.sysclk == 'pri' || sel.sysclk == 'pripll') || sel.poscmode == 'ec' || (in.posc >= 3500000 && in.posc <= 32000000)", "message": "A primary crystal must be 3.5 MHz - 32 MHz."},
    {"expr": "sel.pll != 'usb12' || !(sel.sysclk == 'frcpll' || sel.sysclk == 'pripll') || (f.pllin >= 47880000 && f.pllin <= 48120000)", "message": "The 96 MHz PLL needs 4 MHz after the prescaler: PLL input / 12 must be 4 MHz."},
    {"expr": "sel.pll != 'usb2' || !(sel.sysclk == 'frcpll' || sel.sysclk == 'pripll') || (f.pllin >= 7980000 && f.pllin <= 8020000)", "message": "The 96 MHz PLL needs 4 MHz after the prescaler: PLL input / 2 must be 4 MHz."},
    {"expr": "sel.pll != 'usb3' || !(sel.sysclk == 'frcpll' || sel.sysclk == 'pripll') || (f.pllin >= 11970000 && f.pllin <= 12030000)", "message": "The 96 MHz PLL needs 4 MHz after the prescaler: PLL input / 3 must be 4 MHz."},
    {"expr": "sel.pll != 'usb4' || !(sel.sysclk == 'frcpll' || sel.sysclk == 'pripll') || (f.pllin >= 15960000 && f.pllin <= 16040000)", "message": "The 96 MHz PLL needs 4 MHz after the prescaler: PLL input / 4 must be 4 MHz."},
    {"expr": "sel.pll != 'usb5' || !(sel.sysclk == 'frcpll' || sel.sysclk == 'pripll') || (f.pllin >= 19950000 && f.pllin <= 20050000)", "message": "The 96 MHz PLL needs 4 MHz after the prescaler: PLL input / 5 must be 4 MHz."},
    {"expr": "sel.pll != 'usb6' || !(sel.sysclk == 'frcpll' || sel.sysclk == 'pripll') || (f.pllin >= 23940000 && f.pllin <= 24060000)", "message": "The 96 MHz PLL needs 4 MHz after the prescaler: PLL input / 6 must be 4 MHz."},
    {"expr": "sel.pll != 'usb8' || !(sel.sysclk == 'frcpll' || sel.sysclk == 'pripll') || (f.pllin >= 31920000 && f.pllin <= 32080000)", "message": "The 96 MHz PLL needs 4 MHz after the prescaler: PLL input / 8 must be 4 MHz."},
    {"expr": "sel.pll != 'usb1' || !(sel.sysclk == 'frcpll' || sel.sysclk == 'pripll') || (f.pllin >= 3990000 && f.pllin <= 4010000)", "message": "The 96 MHz PLL needs 4 MHz after the prescaler: PLL input / 1 must be 4 MHz."}
  ],
  "symbols": {
    "CONFIG2.FNOSC": {"FRC": "00000000", "FRCDIV": "00000700", "FRCPLL": "00000100", "LPRC": "00000500", "PRI": "00000200", "PRIPLL": "00000300", "SOSC": "00000400"},
    "CONFIG2.POSCMD": {"EC": "00000000", "HS": "00000002", "NONE": "00000003", "XT": "00000001"},
    "CONFIG4.PLLDIV": {"DIS": "00003C00", "DIV12": "00001C00", "DIV2": "00000400", "DIV3": "00000800", "DIV4": "00000C00", "DIV5": "00001000", "DIV6": "00001400", "DIV8": "00001800", "NODIV": "00000000"}
  }
}
