{
  "schema": 1,
  "id": "dspic33f_lp_dspic33fj16gp101",
  "title": "dsPIC33FJ/PIC24FJ 16 MIPS clock tree (DSPIC33FJ16GP101, DSPIC33FJ16GP102, DSPIC33FJ16MC101 and 12 more)",
  "vendor": "Microchip",
  "source": "dsPIC30F/dsPIC33/PIC24 family reference manuals (Oscillator sections) and data sheets; fuse values from the Microchip DFP EDC files",
  "devices": ["^DSPIC33FJ16GP101$", "^DSPIC33FJ16GP102$", "^DSPIC33FJ16MC101$", "^DSPIC33FJ16MC102$", "^DSPIC33FJ32GP101$", "^DSPIC33FJ32GP102$", "^DSPIC33FJ32GP104$", "^DSPIC33FJ32MC101$", "^DSPIC33FJ32MC102$", "^DSPIC33FJ32MC104$", "^PIC24FJ16MC101$", "^PIC24FJ16MC102$", "^PIC24FJ32MC101$", "^PIC24FJ32MC102$", "^PIC24FJ32MC104$"],
  "fosc": "sysclk",
  "inputs": {
    "posc": {"label": "POSC frequency", "default": 8000000, "min": 1, "max": 32000000},
    "pll": {"label": "PLL output (Fosc) set by your code", "default": 32000000, "min": 12500000, "max": 32000000}
  },
  "settings": ["CONFIG2.OSCIOFNC", "CONFIG2.FCKSM", "CONFIG2.IESO", "CONFIG1.PLLKEN"],
  "nodes": [
    {
      "id": "frc",
      "label": "FRC 7.37 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "FRC 7.37 MHz", "mul": 7370000}
      ]
    },
    {
      "id": "posc",
      "label": "Primary oscillator (POSC)",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "posc",
      "tooltip": "Crystal (XT up to 10 MHz, HS above) or external clock (EC); POSCMD follows."
    },
    {
      "id": "poscmode",
      "label": "POSC type",
      "kind": "mux",
      "x": 0,
      "y": 2,
      "default": "crystal",
      "options": [
        {"id": "crystal", "label": "Crystal (XT/HS)", "mul": 1},
        {"id": "ec", "label": "External clock (EC)", "mul": 1}
      ]
    },
    {
      "id": "sosc",
      "label": "SOSC 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 3,
      "options": [
        {"id": "on", "label": "SOSC 32.768 kHz", "mul": 32768}
      ]
    },
    {
      "id": "lprc",
      "label": "LPRC 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "LPRC 32.768 kHz", "mul": 32768}
      ]
    },
    {
      "id": "pll",
      "label": "PLL output (your code)",
      "kind": "source",
      "x": 2,
      "y": 0,
      "input": "pll",
      "min": 12500000,
      "max": 32000000,
      "tooltip": "Fosc = Fin x M / (N1 x N2), programmed at runtime (CLKDIV.PLLPRE = N1, PLLFBD = M, CLKDIV.PLLPOST = N2). Keep Fin / N1 at 0.8-8 MHz and the VCO (Fin x M / N1) in its data sheet range."
    },
    {
      "id": "frcdivn",
      "label": "FRCDIV (your code)",
      "kind": "divider",
      "x": 1,
      "y": 6,
      "default": "1",
      "tooltip": "CLKDIV.FRCDIV postscaler, reset 1:1.",
      "options": [
        {"id": "1", "label": "/1", "from": "frc", "div": 1},
        {"id": "2", "label": "/2", "from": "frc", "div": 2},
        {"id": "4", "label": "/4", "from": "frc", "div": 4},
        {"id": "8", "label": "/8", "from": "frc", "div": 8},
        {"id": "16", "label": "/16", "from": "frc", "div": 16},
        {"id": "32", "label": "/32", "from": "frc", "div": 32},
        {"id": "64", "label": "/64", "from": "frc", "div": 64},
        {"id": "256", "label": "/256", "from": "frc", "div": 256}
      ]
    },
    {
      "id": "sysclk",
      "label": "Fosc (FNOSC)",
      "kind": "mux",
      "x": 3,
      "y": 1,
      "max": 32000000,
      "consumer": true,
      "options": [
        {"id": "frc", "label": "FRC (FRC)", "from": "frc", "set": {"CONFIG2.FNOSC": "00000000"}},
        {"id": "frcpll", "label": "FRC + PLL (FRCPLL)", "from": "pll", "set": {"CONFIG2.FNOSC": "00000100"}, "keeps": ["frc"]},
        {"id": "pri", "label": "POSC (PRI)", "from": "posc", "set": {"CONFIG2.FNOSC": "00000200"}},
        {"id": "pripll", "label": "POSC + PLL (PRIPLL)", "from": "pll", "set": {"CONFIG2.FNOSC": "00000300"}, "keeps": ["posc"]},
        {"id": "sosc", "label": "SOSC (SOSC)", "from": "sosc", "set": {"CONFIG2.FNOSC": "00000400"}},
        {"id": "lprc", "label": "LPRC (LPRC)", "from": "lprc", "set": {"CONFIG2.FNOSC": "00000500"}},
        {"id": "frcdivn", "label": "FRC/FRCDIV (FRCDIVN)", "from": "frcdivn", "set": {"CONFIG2.FNOSC": "00000700"}}
      ]
    },
    {
      "id": "fcy",
      "label": "Fcy (Fosc/2)",
      "kind": "output",
      "x": 4,
      "y": 1,
      "options": [
        {"id": "2", "label": "/2", "from": "sysclk", "div": 2}
      ]
    }
  ],
  "derive": [
    {"field": "CONFIG2.POSCMOD", "cases": [{"when": "!(sel.sysclk == 'pri' || sel.sysclk == 'pripll')", "value": "00000003"}, {"when": "sel.poscmode == 'ec'", "value": "00000000"}, {"when": "in.posc <= 10000000", "value": "00000001"}], "default": "00000002"}
  ],
  "constraints": [
    {"expr": "!(sel.sysclk == 'pri' || sel.sysclk == 'pripll') || sel.poscmode == 'ec' || (in.posc >= 3500000 && in.posc <= 32000000)", "message": "A primary crystal must be 3.5 MHz - 32 MHz."},
    {"expr": "sel.sysclk != 'pripll' || in.posc >= 1600000", "message": "The PLL needs at least 1.6 MHz at its input (0.8 MHz after N1 = 2)."}
  ],
  "symbols": {
    "CONFIG2.FNOSC": {"FRC": "00000000", "FRCDIVN": "00000700", "FRCPLL": "00000100", "LPRC": "00000500", "PRI": "00000200", "PRIPLL": "00000300", "SOSC": "00000400"},
    "CONFIG2.POSCMOD": {"EC": "00000000", "HS": "00000002", "MS": "00000001", "NONE": "00000003"}
  }
}
