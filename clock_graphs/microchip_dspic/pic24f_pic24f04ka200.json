{
  "schema": 1,
  "id": "pic24f_pic24f04ka200",
  "title": "PIC24F clock tree (PIC24F04KA200, PIC24F04KA201, PIC24F08KA101 and 3 more)",
  "vendor": "Microchip",
  "source": "dsPIC30F/dsPIC33/PIC24 family reference manuals (Oscillator sections) and data sheets; fuse values from the Microchip DFP EDC files",
  "devices": ["^PIC24F04KA200$", "^PIC24F04KA201$", "^PIC24F08KA101$", "^PIC24F08KA102$", "^PIC24F16KA101$", "^PIC24F16KA102$"],
  "fosc": "sysclk",
  "inputs": {
    "posc": {"label": "POSC frequency", "default": 8000000, "min": 1, "max": 32000000}
  },
  "settings": ["FOSCSEL.IESO", "FOSC.OSCIOFNC", "FOSC.SOSCSEL", "FOSC.FCKSM"],
  "nodes": [
    {
      "id": "frc",
      "label": "FRC 8 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "FRC 8 MHz", "mul": 8000000}
      ]
    },
    {
      "id": "posc",
      "label": "Primary oscillator (POSC)",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "posc",
      "tooltip": "Crystal (XT up to 10 MHz, HS above) or external clock (EC); POSCMD follows."
    },
    {
      "id": "poscmode",
      "label": "POSC type",
      "kind": "mux",
      "x": 0,
      "y": 2,
      "default": "crystal",
      "options": [
        {"id": "crystal", "label": "Crystal (XT/HS)", "mul": 1},
        {"id": "ec", "label": "External clock (EC)", "mul": 1}
      ]
    },
    {
      "id": "sosc",
      "label": "SOSC 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 3,
      "options": [
        {"id": "on", "label": "SOSC 32.768 kHz", "mul": 32768}
      ]
    },
    {
      "id": "lprc",
      "label": "LPRC 31 kHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "LPRC 31 kHz", "mul": 31000}
      ]
    },
    {
      "id": "lpfrc",
      "label": "LPFRC 500 kHz",
      "kind": "source",
      "x": 0,
      "y": 5,
      "options": [
        {"id": "on", "label": "LPFRC 500 kHz", "mul": 500000}
      ]
    },
    {
      "id": "frcdiv",
      "label": "RCDIV (your code)",
      "kind": "divider",
      "x": 1,
      "y": 6,
      "default": "2",
      "tooltip": "CLKDIV.RCDIV postscaler, reset 1:2 (4 MHz).",
      "options": [
        {"id": "1", "label": "/1", "from": "frc", "div": 1},
        {"id": "2", "label": "/2", "from": "frc", "div": 2},
        {"id": "4", "label": "/4", "from": "frc", "div": 4},
        {"id": "8", "label": "/8", "from": "frc", "div": 8},
        {"id": "16", "label": "/16", "from": "frc", "div": 16},
        {"id": "32", "label": "/32", "from": "frc", "div": 32},
        {"id": "64", "label": "/64", "from": "frc", "div": 64},
        {"id": "256", "label": "/256", "from": "frc", "div": 256}
      ]
    },
    {
      "id": "lpfrcdiv",
      "label": "RCDIV (your code)",
      "kind": "divider",
      "x": 1,
      "y": 5,
      "default": "2",
      "tooltip": "CLKDIV.RCDIV postscaler, reset 1:2.",
      "options": [
        {"id": "1", "label": "/1", "from": "lpfrc", "div": 1},
        {"id": "2", "label": "/2", "from": "lpfrc", "div": 2},
        {"id": "4", "label": "/4", "from": "lpfrc", "div": 4},
        {"id": "8", "label": "/8", "from": "lpfrc", "div": 8},
        {"id": "16", "label": "/16", "from": "lpfrc", "div": 16},
        {"id": "32", "label": "/32", "from": "lpfrc", "div": 32},
        {"id": "64", "label": "/64", "from": "lpfrc", "div": 64},
        {"id": "256", "label": "/256", "from": "lpfrc", "div": 256}
      ]
    },
    {
      "id": "pllin",
      "label": "PLL input",
      "kind": "mux",
      "x": 1,
      "y": 0,
      "tooltip": "FRCPLL: FRC (through the RCDIV postscaler on parts whose 4x/6x/8x PLL follows it); PRIPLL: POSC.",
      "options": [
        {"id": "frc", "label": "FRC", "from": "frc", "when": "sel.sysclk != 'pripll' && !(1)"},
        {"id": "frcdiv", "label": "FRC/RCDIV", "from": "frcdiv", "when": "sel.sysclk != 'pripll' && (1)"},
        {"id": "posc", "label": "POSC", "from": "posc", "when": "sel.sysclk == 'pripll'"}
      ],
      "min": 4000000,
      "max": 8000000
    },
    {
      "id": "pll",
      "label": "4x PLL",
      "kind": "multiplier",
      "x": 2,
      "y": 0,
      "options": [
        {"id": "4", "label": "x4", "from": "pllin", "mul": 4}
      ]
    },
    {
      "id": "sysclk",
      "label": "Fosc (FNOSC)",
      "kind": "mux",
      "x": 3,
      "y": 1,
      "max": 32000000,
      "consumer": true,
      "options": [
        {"id": "frc", "label": "FRC (FRC)", "from": "frc", "set": {"FOSCSEL.FNOSC": "00000000"}},
        {"id": "frcpll", "label": "FRC + PLL (FRCPLL)", "from": "pll", "set": {"FOSCSEL.FNOSC": "00000001"}},
        {"id": "pri", "label": "POSC (PRI)", "from": "posc", "set": {"FOSCSEL.FNOSC": "00000002"}},
        {"id": "pripll", "label": "POSC + PLL (PRIPLL)", "from": "pll", "set": {"FOSCSEL.FNOSC": "00000003"}},
        {"id": "sosc", "label": "SOSC (SOSC)", "from": "sosc", "set": {"FOSCSEL.FNOSC": "00000004"}},
        {"id": "lprc", "label": "LPRC (LPRC)", "from": "lprc", "set": {"FOSCSEL.FNOSC": "00000005"}},
        {"id": "lpfrc", "label": "LPFRC/RCDIV (LPFRC)", "from": "lpfrcdiv", "set": {"FOSCSEL.FNOSC": "00000006"}},
        {"id": "frcdiv", "label": "FRC/RCDIV (FRCDIV)", "from": "frcdiv", "set": {"FOSCSEL.FNOSC": "00000007"}}
      ]
    },
    {
      "id": "fcy",
      "label": "Fcy (Fosc/2)",
      "kind": "output",
      "x": 4,
      "y": 1,
      "options": [
        {"id": "2", "label": "/2", "from": "sysclk", "div": 2}
      ]
    }
  ],
  "derive": [
    {"field": "FOSC.POSCMOD", "cases": [{"when": "!(sel.sysclk == 'pri' || sel.sysclk == 'pripll')", "value": "00000003"}, {"when": "sel.poscmode == 'ec'", "value": "00000000"}, {"when": "in.posc <= 10000000", "value": "00000001"}], "default": "00000002"},
    {"field": "FOSC.POSCFREQ", "cases": [{"when": "in.posc <= 100000", "value": "00000008"}, {"when": "in.posc <= 8000000", "value": "00000010"}], "default": "00000018"}
  ],
  "constraints": [
    {"expr": "!(sel.sysclk == 'pri' || sel.sysclk == 'pripll') || sel.poscmode == 'ec' || (in.posc >= 3500000 && in.posc <= 32000000)", "message": "A primary crystal must be 3.5 MHz - 32 MHz."}
  ],
  "symbols": {
    "FOSC.POSCFREQ": {"HS": "00000018", "LS": "00000008", "MS": "00000010"},
    "FOSC.POSCMOD": {"EC": "00000000", "HS": "00000002", "NONE": "00000003", "XT": "00000001"},
    "FOSCSEL.FNOSC": {"FRC": "00000000", "FRCDIV": "00000007", "FRCPLL": "00000001", "LPFRC": "00000006", "LPRC": "00000005", "PRI": "00000002", "PRIPLL": "00000003", "SOSC": "00000004"}
  }
}
