{
  "schema": 1,
  "id": "stm32f0",
  "title": "STM32F0 system clock tree",
  "vendor": "STMicroelectronics",
  "source": "RM0360, RM0091, DS9773",
  "devices": ["^STM32F0"],
  "fosc": "hclk",
  "inputs": {
    "hse": {"label": "HSE frequency", "default": 8000000, "min": 4000000, "max": 32000000}
  },
  "settings": ["RCC_CR.HSEBYP"],
  "nodes": [
    {
      "id": "hsi",
      "label": "HSI 8 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "HSI 8 MHz", "mul": 8000000}
      ],
      "enable": {"field": "RCC_CR.HSION", "on": "00000001", "off": "00000000", "auto": "on"}
    },
    {
      "id": "hsi_div2",
      "label": "HSI/2",
      "kind": "divider",
      "x": 1,
      "y": 0,
      "options": [
        {"id": "2", "label": "/2", "from": "hsi", "div": 2}
      ]
    },
    {
      "id": "hse",
      "label": "HSE",
      "kind": "source",
      "x": 0,
      "y": 2,
      "input": "hse",
      "enable": {"field": "RCC_CR.HSEON", "on": "00010000", "off": "00000000", "auto": "both"}
    },
    {
      "id": "hsi48",
      "label": "HSI48 48 MHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "HSI48 48 MHz", "mul": 48000000}
      ],
      "enable": {"field": "RCC_CR2.HSI48ON", "on": "00010000", "off": "00000000", "auto": "both"}
    },
    {
      "id": "pllsrc",
      "label": "PLL source",
      "kind": "mux",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "hsi2", "label": "HSI/2", "from": "hsi_div2", "set": {"RCC_CFGR.PLLSRC": "00000000"}},
        {"id": "hsi", "label": "HSI", "from": "hsi", "set": {"RCC_CFGR.PLLSRC": "00008000"}},
        {"id": "hse", "label": "HSE", "from": "hse", "set": {"RCC_CFGR.PLLSRC": "00010000"}},
        {"id": "hsi48", "label": "HSI48", "from": "hsi48", "set": {"RCC_CFGR.PLLSRC": "00018000"}}
      ]
    },
    {
      "id": "prediv",
      "label": "PREDIV",
      "kind": "divider",
      "x": 3,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000001"}, "div": 2},
        {"id": "3", "label": "/3", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000002"}, "div": 3},
        {"id": "4", "label": "/4", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000003"}, "div": 4},
        {"id": "5", "label": "/5", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000004"}, "div": 5},
        {"id": "6", "label": "/6", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000005"}, "div": 6},
        {"id": "7", "label": "/7", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000006"}, "div": 7},
        {"id": "8", "label": "/8", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000007"}, "div": 8},
        {"id": "9", "label": "/9", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000008"}, "div": 9},
        {"id": "10", "label": "/10", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "00000009"}, "div": 10},
        {"id": "11", "label": "/11", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "0000000A"}, "div": 11},
        {"id": "12", "label": "/12", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "0000000B"}, "div": 12},
        {"id": "13", "label": "/13", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "0000000C"}, "div": 13},
        {"id": "14", "label": "/14", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "0000000D"}, "div": 14},
        {"id": "15", "label": "/15", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "0000000E"}, "div": 15},
        {"id": "16", "label": "/16", "from": "pllsrc", "set": {"RCC_CFGR2.PREDIV": "0000000F"}, "div": 16}
      ],
      "bypass": "sel.pllsrc == 'hsi2'",
      "tooltip": "Not used with HSI/2."
    },
    {
      "id": "pllmul",
      "label": "PLLMUL",
      "kind": "multiplier",
      "x": 4,
      "y": 1,
      "options": [
        {"id": "2", "label": "x2", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00000000"}, "mul": 2},
        {"id": "3", "label": "x3", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00040000"}, "mul": 3},
        {"id": "4", "label": "x4", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00080000"}, "mul": 4},
        {"id": "5", "label": "x5", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "000C0000"}, "mul": 5},
        {"id": "6", "label": "x6", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00100000"}, "mul": 6},
        {"id": "7", "label": "x7", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00140000"}, "mul": 7},
        {"id": "8", "label": "x8", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00180000"}, "mul": 8},
        {"id": "9", "label": "x9", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "001C0000"}, "mul": 9},
        {"id": "10", "label": "x10", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00200000"}, "mul": 10},
        {"id": "11", "label": "x11", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00240000"}, "mul": 11},
        {"id": "12", "label": "x12", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00280000"}, "mul": 12},
        {"id": "13", "label": "x13", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "002C0000"}, "mul": 13},
        {"id": "14", "label": "x14", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00300000"}, "mul": 14},
        {"id": "15", "label": "x15", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00340000"}, "mul": 15},
        {"id": "16", "label": "x16", "from": "prediv", "set": {"RCC_CFGR.PLLMUL": "00380000"}, "mul": 16}
      ],
      "min": 16000000,
      "max": 48000000,
      "enable": {"field": "RCC_CR.PLLON", "on": "01000000", "off": "00000000", "auto": "both"}
    },
    {
      "id": "sysclk",
      "label": "SYSCLK",
      "kind": "mux",
      "x": 5,
      "y": 0,
      "options": [
        {"id": "hsi", "label": "HSI", "from": "hsi", "set": {"RCC_CFGR.SW": "00000000"}},
        {"id": "hse", "label": "HSE", "from": "hse", "set": {"RCC_CFGR.SW": "00000001"}},
        {"id": "pll", "label": "PLL", "from": "pllmul", "set": {"RCC_CFGR.SW": "00000002"}},
        {"id": "hsi48", "label": "HSI48", "from": "hsi48", "set": {"RCC_CFGR.SW": "00000003"}}
      ],
      "max": 48000000
    },
    {
      "id": "hclk",
      "label": "HCLK (AHB)",
      "kind": "divider",
      "x": 6,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000080"}, "div": 2},
        {"id": "4", "label": "/4", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000090"}, "div": 4},
        {"id": "8", "label": "/8", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "000000A0"}, "div": 8},
        {"id": "16", "label": "/16", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "000000B0"}, "div": 16},
        {"id": "64", "label": "/64", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "000000C0"}, "div": 64},
        {"id": "128", "label": "/128", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "000000D0"}, "div": 128},
        {"id": "256", "label": "/256", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "000000E0"}, "div": 256},
        {"id": "512", "label": "/512", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "000000F0"}, "div": 512}
      ],
      "max": 48000000,
      "consumer": true
    },
    {
      "id": "pclk",
      "label": "PCLK (APB)",
      "kind": "divider",
      "x": 7,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00000400"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00000500"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00000600"}, "div": 8},
        {"id": "16", "label": "/16", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00000700"}, "div": 16}
      ],
      "max": 48000000,
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "sel.sysclk != 'pll' || (f.prediv >= 1000000 && f.prediv <= 24000000)", "message": "PLL input must be 1-24 MHz."}
  ]
}
