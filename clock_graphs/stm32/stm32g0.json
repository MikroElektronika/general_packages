{
  "schema": 1,
  "id": "stm32g0",
  "title": "STM32G0 system clock tree",
  "vendor": "STMicroelectronics",
  "source": "RM0444, RM0454",
  "devices": ["^STM32G0"],
  "fosc": "hclk",
  "inputs": {
    "hse": {"label": "HSE frequency", "default": 8000000, "min": 4000000, "max": 48000000}
  },
  "settings": ["RCC_CR.HSEBYP", "PWR_CR1.VCORE"],
  "nodes": [
    {
      "id": "hsi16",
      "label": "HSI16 16 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "HSI16 16 MHz", "mul": 16000000}
      ],
      "enable": {"field": "RCC_CR.HSION", "on": "00000100", "off": "00000000", "auto": "on"}
    },
    {
      "id": "hsisys",
      "label": "HSIDIV",
      "kind": "divider",
      "x": 1,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "hsi16", "set": {"RCC_CR.HSIDIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hsi16", "set": {"RCC_CR.HSIDIV": "00000800"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hsi16", "set": {"RCC_CR.HSIDIV": "00001000"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hsi16", "set": {"RCC_CR.HSIDIV": "00001800"}, "div": 8},
        {"id": "16", "label": "/16", "from": "hsi16", "set": {"RCC_CR.HSIDIV": "00002000"}, "div": 16},
        {"id": "32", "label": "/32", "from": "hsi16", "set": {"RCC_CR.HSIDIV": "00002800"}, "div": 32},
        {"id": "64", "label": "/64", "from": "hsi16", "set": {"RCC_CR.HSIDIV": "00003000"}, "div": 64},
        {"id": "128", "label": "/128", "from": "hsi16", "set": {"RCC_CR.HSIDIV": "00003800"}, "div": 128}
      ]
    },
    {
      "id": "hse",
      "label": "HSE",
      "kind": "source",
      "x": 0,
      "y": 2,
      "input": "hse",
      "enable": {"field": "RCC_CR.HSEON", "on": "00010000", "off": "00000000", "auto": "both"}
    },
    {
      "id": "lsi",
      "label": "LSI 32 kHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "LSI 32 kHz", "mul": 32000}
      ],
      "enable": {"field": "RCC_CSR.LSION", "on": "00000001", "off": "00000000", "auto": "both"}
    },
    {
      "id": "lse",
      "label": "LSE 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 5,
      "options": [
        {"id": "on", "label": "LSE 32.768 kHz", "mul": 32768}
      ],
      "enable": {"field": "RCC_BDCR.LSEON", "on": "00000001", "off": "00000000", "auto": "both"}
    },
    {
      "id": "pllsrc",
      "label": "PLL source",
      "kind": "mux",
      "x": 1,
      "y": 2,
      "options": [
        {"id": "hsi16", "label": "HSI16", "from": "hsi16", "set": {"RCC_PLLSYSCFGR.PLLSRC|RCC_PLLCFGR.PLLSRC": "00000002"}},
        {"id": "hse", "label": "HSE", "from": "hse", "set": {"RCC_PLLSYSCFGR.PLLSRC|RCC_PLLCFGR.PLLSRC": "00000003"}}
      ]
    },
    {
      "id": "pllm",
      "label": "/M",
      "kind": "divider",
      "x": 2,
      "y": 2,
      "options": [
        {"id": "1", "label": "/1", "from": "pllsrc", "set": {"RCC_PLLSYSCFGR.PLLM|RCC_PLLCFGR.PLLM": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "pllsrc", "set": {"RCC_PLLSYSCFGR.PLLM|RCC_PLLCFGR.PLLM": "00000010"}, "div": 2},
        {"id": "3", "label": "/3", "from": "pllsrc", "set": {"RCC_PLLSYSCFGR.PLLM|RCC_PLLCFGR.PLLM": "00000020"}, "div": 3},
        {"id": "4", "label": "/4", "from": "pllsrc", "set": {"RCC_PLLSYSCFGR.PLLM|RCC_PLLCFGR.PLLM": "00000030"}, "div": 4},
        {"id": "5", "label": "/5", "from": "pllsrc", "set": {"RCC_PLLSYSCFGR.PLLM|RCC_PLLCFGR.PLLM": "00000040"}, "div": 5},
        {"id": "6", "label": "/6", "from": "pllsrc", "set": {"RCC_PLLSYSCFGR.PLLM|RCC_PLLCFGR.PLLM": "00000050"}, "div": 6},
        {"id": "7", "label": "/7", "from": "pllsrc", "set": {"RCC_PLLSYSCFGR.PLLM|RCC_PLLCFGR.PLLM": "00000060"}, "div": 7},
        {"id": "8", "label": "/8", "from": "pllsrc", "set": {"RCC_PLLSYSCFGR.PLLM|RCC_PLLCFGR.PLLM": "00000070"}, "div": 8}
      ],
      "min": 2660000,
      "max": 16000000,
      "tooltip": "VCO input: 2.66-16 MHz."
    },
    {
      "id": "plln",
      "label": "xN",
      "kind": "multiplier",
      "x": 3,
      "y": 2,
      "range": {"from": "pllm", "op": "mul", "min": 8, "max": 86, "field": "RCC_PLLSYSCFGR.PLLN|RCC_PLLCFGR.PLLN", "lsb": 8, "scale": 1, "offset": 0},
      "min": 64000000,
      "max": 344000000,
      "enable": {"field": "RCC_CR.PLLON", "on": "01000000", "off": "00000000", "auto": "both"}
    },
    {
      "id": "pllr",
      "label": "/R",
      "kind": "divider",
      "x": 4,
      "y": 2,
      "options": [
        {"id": "2", "label": "/2", "from": "plln", "set": {"RCC_PLLSYSCFGR.PLLR|RCC_PLLCFGR.PLLR": "20000000"}, "div": 2},
        {"id": "3", "label": "/3", "from": "plln", "set": {"RCC_PLLSYSCFGR.PLLR|RCC_PLLCFGR.PLLR": "40000000"}, "div": 3},
        {"id": "4", "label": "/4", "from": "plln", "set": {"RCC_PLLSYSCFGR.PLLR|RCC_PLLCFGR.PLLR": "60000000"}, "div": 4},
        {"id": "5", "label": "/5", "from": "plln", "set": {"RCC_PLLSYSCFGR.PLLR|RCC_PLLCFGR.PLLR": "80000000"}, "div": 5},
        {"id": "6", "label": "/6", "from": "plln", "set": {"RCC_PLLSYSCFGR.PLLR|RCC_PLLCFGR.PLLR": "A0000000"}, "div": 6},
        {"id": "7", "label": "/7", "from": "plln", "set": {"RCC_PLLSYSCFGR.PLLR|RCC_PLLCFGR.PLLR": "C0000000"}, "div": 7},
        {"id": "8", "label": "/8", "from": "plln", "set": {"RCC_PLLSYSCFGR.PLLR|RCC_PLLCFGR.PLLR": "E0000000"}, "div": 8}
      ],
      "max": 64000000,
      "enable": {"field": "RCC_PLLSYSCFGR.PLLREN|RCC_PLLCFGR.PLLREN", "on": "10000000", "off": "00000000", "auto": "both"}
    },
    {
      "id": "sysclk",
      "label": "SYSCLK",
      "kind": "mux",
      "x": 5,
      "y": 0,
      "options": [
        {"id": "hsisys", "label": "HSISYS", "from": "hsisys", "set": {"RCC_CFGR.SW": "00000000"}},
        {"id": "hse", "label": "HSE", "from": "hse", "set": {"RCC_CFGR.SW": "00000001"}},
        {"id": "pll", "label": "PLLRCLK", "from": "pllr", "set": {"RCC_CFGR.SW": "00000002"}},
        {"id": "lsi", "label": "LSI", "from": "lsi", "set": {"RCC_CFGR.SW": "00000003"}},
        {"id": "lse", "label": "LSE", "from": "lse", "set": {"RCC_CFGR.SW": "00000004"}}
      ],
      "max": 64000000
    },
    {
      "id": "hclk",
      "label": "HCLK (AHB)",
      "kind": "divider",
      "x": 6,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000800"}, "div": 2},
        {"id": "4", "label": "/4", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000900"}, "div": 4},
        {"id": "8", "label": "/8", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000A00"}, "div": 8},
        {"id": "16", "label": "/16", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000B00"}, "div": 16},
        {"id": "64", "label": "/64", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000C00"}, "div": 64},
        {"id": "128", "label": "/128", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000D00"}, "div": 128},
        {"id": "256", "label": "/256", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000E00"}, "div": 256},
        {"id": "512", "label": "/512", "from": "sysclk", "set": {"RCC_CFGR.HPRE": "00000F00"}, "div": 512}
      ],
      "max": 64000000,
      "consumer": true
    },
    {
      "id": "pclk",
      "label": "PCLK (APB)",
      "kind": "divider",
      "x": 7,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00004000"}, "div": 2},
        {"id": "4", "label": "/4", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00005000"}, "div": 4},
        {"id": "8", "label": "/8", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00006000"}, "div": 8},
        {"id": "16", "label": "/16", "from": "hclk", "set": {"RCC_CFGR.PPRE": "00007000"}, "div": 16}
      ],
      "max": 64000000,
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "reg(\"PWR_CR1.VCORE\") != 0x400 || f.sysclk <= 16000000", "message": "Voltage range 2 limits SYSCLK to 16 MHz."}
  ]
}
