{
  "schema": 1,
  "id": "pic_pic18f13k22",
  "title": "PIC oscillator fuses (PIC18F13K22, PIC18F14K22, PIC18LF13K22, PIC18LF14K22)",
  "vendor": "Microchip",
  "source": "NECTO mikroC PIC definitions (oscillator configuration fuses), PIC datasheets",
  "devices": ["^PIC18F13K22$", "^PIC18F14K22$", "^PIC18LF13K22$", "^PIC18LF14K22$"],
  "fosc": "pll",
  "inputs": {
    "ext": {"label": "External frequency", "default": 8000000, "min": 1, "max": 64000000},
    "intosc": {"label": "Internal oscillator frequency", "default": 8000000, "min": 31000, "max": 64000000}
  },
  "settings": [],
  "nodes": [
    {
      "id": "ext",
      "label": "External oscillator / clock",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext"
    },
    {
      "id": "intosc",
      "label": "Internal oscillator (set by your code)",
      "kind": "source",
      "x": 0,
      "y": 3,
      "input": "intosc",
      "tooltip": "The internal oscillator frequency is chosen at runtime (OSCCON/OSCFRQ): enter the frequency your code sets."
    },
    {
      "id": "source",
      "label": "Oscillator (FOSC)",
      "kind": "mux",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "ec_low", "label": "EC (low)", "set": {"CONFIG1H.FOSC": "0000000D"}, "from": "ext", "mul": 1},
        {"id": "ec_clkout_function_on_osc2_low", "label": "EC, CLKOUT function on OSC2 (low)", "set": {"CONFIG1H.FOSC": "0000000C"}, "from": "ext", "mul": 1},
        {"id": "ec_medium", "label": "EC (medium)", "set": {"CONFIG1H.FOSC": "0000000B"}, "from": "ext", "mul": 1},
        {"id": "ec_clkout_function_on_osc2_mediu", "label": "EC, CLKOUT function on OSC2 (medium)", "set": {"CONFIG1H.FOSC": "0000000A"}, "from": "ext", "mul": 1},
        {"id": "internal_rc_oscillator_clkout_fu", "label": "Internal RC oscillator, CLKOUT function on OSC2", "set": {"CONFIG1H.FOSC": "00000009"}, "from": "intosc", "mul": 1},
        {"id": "internal_rc_oscillator", "label": "Internal RC oscillator", "set": {"CONFIG1H.FOSC": "00000008"}, "from": "intosc", "mul": 1},
        {"id": "external_rc_oscillator", "label": "External RC oscillator", "set": {"CONFIG1H.FOSC": "00000007"}, "from": "ext", "mul": 1},
        {"id": "ec_high", "label": "EC (high)", "set": {"CONFIG1H.FOSC": "00000005"}, "from": "ext", "mul": 1},
        {"id": "ec_clkout_function_on_osc2_high", "label": "EC, CLKOUT function on OSC2 (high)", "set": {"CONFIG1H.FOSC": "00000004"}, "from": "ext", "mul": 1},
        {"id": "external_rc_oscillator_clkout_fu", "label": "External RC oscillator, CLKOUT function on OSC2", "set": {"CONFIG1H.FOSC": "00000003"}, "from": "ext", "mul": 1},
        {"id": "hs_oscillator", "label": "HS oscillator", "set": {"CONFIG1H.FOSC": "00000002"}, "from": "ext", "mul": 1},
        {"id": "xt_oscillator", "label": "XT oscillator", "set": {"CONFIG1H.FOSC": "00000001"}, "from": "ext", "mul": 1},
        {"id": "lp_oscillator", "label": "LP oscillator", "set": {"CONFIG1H.FOSC": "00000000"}, "mul": 32768}
      ]
    },
    {
      "id": "pll",
      "label": "4x PLL (PLLEN)",
      "kind": "multiplier",
      "x": 3,
      "y": 1,
      "options": [
        {"id": "1", "label": "x1 (PLL off)", "from": "source", "set": {"CONFIG1H.PLLEN": "00000000"}},
        {"id": "4", "label": "x4 (PLL on)", "from": "source", "mul": 4, "set": {"CONFIG1H.PLLEN": "00000010"}}
      ],
      "max": 64000000,
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "sel.source != 'hs_oscillator' || (in.ext >= 4000000)", "message": "HS oscillator: the external frequency must be 4 MHz or more."},
    {"expr": "sel.source != 'xt_oscillator' || (in.ext >= 100000 && in.ext <= 4000000)", "message": "XT oscillator: the external frequency must be 0.1-4 MHz."}
  ],
  "symbols": {
    "CONFIG1H.FOSC": {"ECL": "0000000D", "ECCLKOUTL": "0000000C", "ECM": "0000000B", "ECCLKOUTM": "0000000A", "IRCCLKOUT": "00000009", "IRC": "00000008", "ERC": "00000007", "ECH": "00000005", "ECCLKOUTH": "00000004", "ERCCLKOUT": "0000000E", "HS": "00000002", "XT": "00000001", "LP": "00000000"},
    "CONFIG1H.PLLEN": {"ON": "00000010", "OFF": "00000010"}
  }
}
