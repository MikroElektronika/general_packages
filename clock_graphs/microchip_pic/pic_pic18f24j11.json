    },
    {
      "id": "source",
      "label": "Oscillator (OSC)",
      "kind": "mux",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "ec_pll_clko_ra6", "label": "EC+PLL (CLKO-RA6)", "set": {"CONFIG2L.OSC": "00000007"}, "from": "ext", "mul": 1},
        {"id": "ec_clko_ra6", "label": "EC (CLKO-RA6)", "set": {"CONFIG2L.OSC": "00000006"}, "from": "ext", "mul": 1},
        {"id": "hs_pll", "label": "HS+PLL", "set": {"CONFIG2L.OSC": "00000005"}, "from": "ext", "mul": 1},
        {"id": "hs", "label": "HS", "set": {"CONFIG2L.OSC": "00000004"}, "from": "ext", "mul": 1},
        {"id": "intoscpllo_clko_ra6", "label": "INTOSCPLLO (CLKO-RA6)", "set": {"CONFIG2L.OSC": "00000003"}, "from": "intosc", "mul": 1},
        {"id": "intoscpll", "label": "INTOSCPLL", "set": {"CONFIG2L.OSC": "00000002"}, "from": "intosc", "mul": 1},
        {"id": "intosco_clko_ra6", "label": "INTOSCO (CLKO-RA6)", "set": {"CONFIG2L.OSC": "00000001"}, "from": "intosc", "mul": 1},
