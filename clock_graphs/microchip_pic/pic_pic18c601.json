{
  "schema": 1,
  "id": "pic_pic18c601",
  "title": "PIC oscillator fuses (PIC18C601, PIC18C801)",
  "vendor": "Microchip",
  "source": "NECTO mikroC PIC definitions (oscillator configuration fuses), PIC datasheets",
  "devices": ["^PIC18C601$", "^PIC18C801$"],
  "fosc": "source",
  "inputs": {
    "ext": {"label": "External frequency", "default": 8000000, "min": 1, "max": 25000000},
    "intosc": {"label": "Internal oscillator frequency", "default": 8000000, "min": 31000, "max": 25000000}
  },
  "settings": [],
  "nodes": [
    {
      "id": "ext",
      "label": "External oscillator / clock",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext"
    },
    {
      "id": "intosc",
      "label": "Internal oscillator (set by your code)",
      "kind": "source",
      "x": 0,
      "y": 3,
      "input": "intosc",
      "tooltip": "The internal oscillator frequency is chosen at runtime (OSCCON/OSCFRQ): enter the frequency your code sets."
    },
    {
      "id": "source",
      "label": "Oscillator (OSC)",
      "kind": "mux",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "rc_oscillator", "label": "RC Oscillator", "set": {"CONFIG1H.OSC": "00000003"}, "from": "ext", "mul": 1},
        {"id": "hs_oscillator", "label": "HS Oscillator", "set": {"CONFIG1H.OSC": "00000002"}, "from": "ext", "mul": 1},
        {"id": "ec_oscillator", "label": "EC Oscillator", "set": {"CONFIG1H.OSC": "00000001"}, "from": "ext", "mul": 1},
        {"id": "lp_oscillator", "label": "LP Oscillator", "set": {"CONFIG1H.OSC": "00000000"}, "mul": 32768}
      ],
      "max": 25000000,
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "sel.source != 'hs_oscillator' || (in.ext >= 4000000)", "message": "HS Oscillator: the external frequency must be 4 MHz or more."}
  ],
  "symbols": {
    "CONFIG1H.OSC": {"RC,_RC_OSC_1H": "00000003", "HS,_HS_OSC_1H": "00000002", "EC,_EC_OSC_1H": "00000001", "LP,_LP_OSC_1H": "00000000"}
  }
}
