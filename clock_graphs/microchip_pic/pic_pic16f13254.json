{
  "schema": 1,
  "id": "pic_pic16f13254",
  "title": "PIC oscillator fuses (PIC16F13254, PIC16F13255, PIC16F13256, PIC16F13274 and 2 more)",
  "vendor": "Microchip",
  "source": "NECTO mikroC PIC definitions (oscillator configuration fuses), PIC datasheets; fuse values of XC8-only parts from the Microchip DFP EDC files",
  "devices": ["^PIC16F13254$", "^PIC16F13255$", "^PIC16F13256$", "^PIC16F13274$", "^PIC16F13275$", "^PIC16F13276$"],
  "fosc": "source",
  "inputs": {
    "ext": {"label": "External frequency", "default": 8000000, "min": 1, "max": 32000000},
    "intosc": {"label": "Internal oscillator frequency", "default": 8000000, "min": 31000, "max": 32000000}
  },
  "settings": [],
  "nodes": [
    {
      "id": "ext",
      "label": "External oscillator / clock",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext"
    },
    {
      "id": "intosc",
      "label": "Internal oscillator (set by your code)",
      "kind": "source",
      "x": 0,
      "y": 3,
      "input": "intosc",
      "tooltip": "The internal oscillator frequency is chosen at runtime (OSCCON/OSCFRQ): enter the frequency your code sets."
    },
    {
      "id": "fextosc",
      "label": "External oscillator (FEXTOSC)",
      "kind": "mux",
      "x": 1,
      "y": 1,
      "options": [
        {"id": "ec_external_clock_above_16_mhz", "label": "EC (external clock) above 16 MHz", "set": {"CONFIG1.FEXTOSC": "00000007"}, "from": "ext"},
        {"id": "ec_external_clock_below_16_mhz", "label": "EC (external clock) below 16 MHz", "set": {"CONFIG1.FEXTOSC": "00000005"}, "from": "ext"},
        {"id": "hs_crystal_oscillator_above_4mhz", "label": "HS (crystal oscillator) above 4MHz", "set": {"CONFIG1.FEXTOSC": "00000002"}, "from": "ext"},
        {"id": "xt_crystal_oscillator_above_100k", "label": "XT (crystal oscillator) above 100kHz", "set": {"CONFIG1.FEXTOSC": "00000001"}, "from": "ext"},
        {"id": "lp_crystal_oscillator_optimized_", "label": "LP (crystal oscillator) optimized for 32.768kHz", "set": {"CONFIG1.FEXTOSC": "00000000"}, "mul": 32768}
      ]
    },
    {
      "id": "source",
      "label": "Oscillator (RSTOSC)",
      "kind": "mux",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "extosc_operating_per_fextosc_bit", "label": "EXTOSC operating per FEXTOSC bits", "set": {"CONFIG1.RSTOSC": "00000070"}, "from": "fextosc", "mul": 1},
        {"id": "hfintosc_1mhz", "label": "HFINTOSC (1MHz)", "set": {"CONFIG1.RSTOSC": "00000060"}, "mul": 1000000},
        {"id": "lfintosc", "label": "LFINTOSC", "set": {"CONFIG1.RSTOSC": "00000050"}, "mul": 31000},
        {"id": "sosc", "label": "SOSC", "set": {"CONFIG1.RSTOSC": "00000040"}, "mul": 32768},
        {"id": "extosc_with_4x_pll_with_extosc_o", "label": "EXTOSC with 4x PLL, with EXTOSC operating per FEXTOSC bits", "set": {"CONFIG1.RSTOSC": "00000020"}, "from": "fextosc", "mul": 4},
        {"id": "hfintosc_16_mhz", "label": "HFINTOSC (16 MHz)", "set": {"CONFIG1.RSTOSC": "00000010"}, "mul": 16000000},
        {"id": "hfintosc_32_mhz", "label": "HFINTOSC (32 MHz)", "set": {"CONFIG1.RSTOSC": "00000000"}, "mul": 32000000}
      ],
      "max": 32000000,
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "sel.fextosc != 'ec_external_clock_above_16_mhz' || (in.ext >= 16000000)", "message": "EC (external clock) above 16 MHz: the external frequency must be 16 MHz or more."},
    {"expr": "sel.fextosc != 'ec_external_clock_below_16_mhz' || (in.ext <= 16000000)", "message": "EC (external clock) below 16 MHz: the external frequency must be 0-16 MHz."},
    {"expr": "sel.fextosc != 'hs_crystal_oscillator_above_4mhz' || (in.ext >= 4000000)", "message": "HS (crystal oscillator) above 4MHz: the external frequency must be 4 MHz or more."},
    {"expr": "sel.fextosc != 'xt_crystal_oscillator_above_100k' || (in.ext <= 4000000)", "message": "XT (crystal oscillator) above 100kHz: the external frequency must be 0-4 MHz."}
  ],
  "symbols": {
    "CONFIG1.FEXTOSC": {"ECH": "00000007", "ECL": "00000005", "OFF": "00000004", "HS": "00000002", "XT": "00000001", "LP": "00000000"},
    "CONFIG1.RSTOSC": {"EXTOSC": "00000070", "HFINTOSC_1MHz": "00000060", "LFINTOSC": "00000050", "SOSC": "00000040", "EXTOSC_4PLL": "00000020", "HFINTOSC_16MHz": "00000010", "HFINTOSC_32MHz": "00000000"}
  }
}
