        {"id": "ec_oscillator_clko_function_on_o", "label": "EC oscillator, CLKO function on OSC2", "set": {"CONFIG2L.FOSC": "00000002"}, "from": "ext", "mul": 1},
        {"id": "hs_oscillator_pll_enabled_and_un", "label": "HS oscillator, PLL enabled and under software control", "set": {"CONFIG2L.FOSC": "00000001"}, "from": "ext", "mul": 1},
