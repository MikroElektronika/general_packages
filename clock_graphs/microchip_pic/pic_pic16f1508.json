{
  "schema": 1,
  "id": "pic_pic16f1508",
  "title": "PIC oscillator fuses (PIC16F1508, PIC16F1509, PIC16F1512, PIC16F1513 and 16 more)",
  "vendor": "Microchip",
  "source": "NECTO mikroC PIC definitions (oscillator configuration fuses), PIC datasheets",
  "devices": ["^PIC16F1508$", "^PIC16F1509$", "^PIC16F1512$", "^PIC16F1513$", "^PIC16F1516$", "^PIC16F1517$", "^PIC16F1518$", "^PIC16F1519$", "^PIC16F1526$", "^PIC16F1527$", "^PIC16LF1508$", "^PIC16LF1509$", "^PIC16LF1512$", "^PIC16LF1513$", "^PIC16LF1516$", "^PIC16LF1517$", "^PIC16LF1518$", "^PIC16LF1519$", "^PIC16LF1526$", "^PIC16LF1527$"],
  "fosc": "source",
  "inputs": {
    "ext": {"label": "External frequency", "default": 8000000, "min": 1, "max": 20000000},
    "intosc": {"label": "Internal oscillator frequency", "default": 8000000, "min": 31000, "max": 20000000}
  },
  "settings": [],
  "nodes": [
    {
      "id": "ext",
      "label": "External oscillator / clock",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext"
    },
    {
      "id": "intosc",
      "label": "Internal oscillator (set by your code)",
      "kind": "source",
      "x": 0,
      "y": 3,
      "input": "intosc",
      "tooltip": "The internal oscillator frequency is chosen at runtime (OSCCON/OSCFRQ): enter the frequency your code sets."
    },
    {
      "id": "source",
      "label": "Oscillator (FOSC)",
      "kind": "mux",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "ech_external_clock_high_power_mo", "label": "ECH, External Clock, High Power Mode (4-20 MHz): device cloc", "set": {"CONFIG1.FOSC": "00000007"}, "from": "ext", "mul": 1},
        {"id": "ecm_external_clock_medium_power_", "label": "ECM, External Clock, Medium Power Mode (0.5-4 MHz): device c", "set": {"CONFIG1.FOSC": "00000006"}, "from": "ext", "mul": 1},
        {"id": "ecl_external_clock_low_power_mod", "label": "ECL, External Clock, Low Power Mode (0-0.5 MHz): device cloc", "set": {"CONFIG1.FOSC": "00000005"}, "from": "ext", "mul": 1},
        {"id": "intosc_oscillator_i_o_function_o", "label": "INTOSC oscillator: I/O function on CLKIN pin", "set": {"CONFIG1.FOSC": "00000004"}, "from": "intosc", "mul": 1},
        {"id": "extrc_oscillator_external_rc_cir", "label": "EXTRC oscillator: External RC circuit connected to CLKIN pin", "set": {"CONFIG1.FOSC": "00000003"}, "from": "ext", "mul": 1},
        {"id": "hs_oscillator_high_speed_crystal", "label": "HS Oscillator, High-speed crystal/resonator connected betwee", "set": {"CONFIG1.FOSC": "00000002"}, "from": "ext", "mul": 1},
        {"id": "xt_oscillator_crystal_resonator_", "label": "XT Oscillator, Crystal/resonator connected between OSC1 and ", "set": {"CONFIG1.FOSC": "00000001"}, "from": "ext", "mul": 1},
        {"id": "lp_oscillator_low_power_crystal_", "label": "LP Oscillator, Low-power crystal connected between OSC1 and ", "set": {"CONFIG1.FOSC": "00000000"}, "mul": 32768}
      ],
      "max": 20000000,
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "sel.source != 'ech_external_clock_high_power_mo' || (in.ext >= 4000000 && in.ext <= 20000000)", "message": "ECH: the external frequency must be 4-20 MHz."},
    {"expr": "sel.source != 'ecm_external_clock_medium_power_' || (in.ext >= 500000 && in.ext <= 4000000)", "message": "ECM: the external frequency must be 0.5-4 MHz."},
    {"expr": "sel.source != 'ecl_external_clock_low_power_mod' || (in.ext <= 500000)", "message": "ECL: the external frequency must be 0-0.5 MHz."},
    {"expr": "sel.source != 'hs_oscillator_high_speed_crystal' || (in.ext >= 4000000)", "message": "HS Oscillator: the external frequency must be 4 MHz or more."},
    {"expr": "sel.source != 'xt_oscillator_crystal_resonator_' || (in.ext >= 100000 && in.ext <= 4000000)", "message": "XT Oscillator: the external frequency must be 0.1-4 MHz."}
  ],
  "symbols": {
    "CONFIG1.FOSC": {"ECH": "00000007", "ECM": "00000006", "ECL": "00000005", "INTOSC": "00000004", "EXTRC": "00000003", "HS": "00000002", "XT": "00000001", "LP": "00000000"}
  }
}
