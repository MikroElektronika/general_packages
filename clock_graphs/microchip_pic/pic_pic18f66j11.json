{
  "schema": 1,
  "id": "pic_pic18f66j11",
  "title": "PIC oscillator fuses (PIC18F66J11, PIC18F66J16, PIC18F67J11, PIC18F86J11 and 2 more)",
  "vendor": "Microchip",
  "source": "NECTO mikroC PIC definitions (oscillator configuration fuses), PIC datasheets",
  "devices": ["^PIC18F66J11$", "^PIC18F66J16$", "^PIC18F67J11$", "^PIC18F86J11$", "^PIC18F86J16$", "^PIC18F87J11$"],
  "fosc": "source",
  "inputs": {
    "ext": {"label": "External frequency", "default": 8000000, "min": 1, "max": 48000000},
    "intosc": {"label": "Internal oscillator frequency", "default": 8000000, "min": 31000, "max": 48000000}
  },
  "settings": [],
  "nodes": [
    {
      "id": "ext",
      "label": "External oscillator / clock",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext"
    },
    {
      "id": "intosc",
      "label": "Internal oscillator (set by your code)",
      "kind": "source",
      "x": 0,
      "y": 3,
      "input": "intosc",
      "tooltip": "The internal oscillator frequency is chosen at runtime (OSCCON/OSCFRQ): enter the frequency your code sets."
    },
    {
      "id": "source",
      "label": "Oscillator (FOSC)",
      "kind": "mux",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "ec_oscillator_pll_enabled_clko_o", "label": "EC Oscillator, PLL enabled, CLKO on RA6", "set": {"CONFIG2L.FOSC": "00000007"}, "from": "ext", "mul": 1},
        {"id": "ec_oscillator_clko_on_ra6", "label": "EC Oscillator, CLKO  on RA6", "set": {"CONFIG2L.FOSC": "00000006"}, "from": "ext", "mul": 1},
        {"id": "hs_oscillator_pll_enabled", "label": "HS oscillator, PLL enabled", "set": {"CONFIG2L.FOSC": "00000005"}, "from": "ext", "mul": 1},
        {"id": "hs_oscillator", "label": "HS oscillator", "set": {"CONFIG2L.FOSC": "00000004"}, "from": "ext", "mul": 1},
        {"id": "intosc_with_pll_enabled_clkout_o", "label": "INTOSC with PLL enabled, CLKOUT on RA6 and port function on ", "set": {"CONFIG2L.FOSC": "00000003"}, "from": "intosc", "mul": 1},
        {"id": "intosc_with_pll_enabled_port_fun", "label": "INTOSC with PLL enabled, port function on RA6 and RA7", "set": {"CONFIG2L.FOSC": "00000002"}, "from": "intosc", "mul": 1},
        {"id": "internal_oscillator_clkout_on_ra", "label": "Internal oscillator, CLKOUT on RA6 and port function on RA7", "set": {"CONFIG2L.FOSC": "00000001"}, "from": "intosc", "mul": 1},
        {"id": "internal_oscillator_port_functio", "label": "Internal oscillator, port function on RA6 and RA7", "set": {"CONFIG2L.FOSC": "00000000"}, "from": "intosc", "mul": 1}
      ],
      "max": 48000000,
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "sel.source != 'hs_oscillator_pll_enabled' || (in.ext >= 4000000)", "message": "HS oscillator: the external frequency must be 4 MHz or more."},
    {"expr": "sel.source != 'hs_oscillator' || (in.ext >= 4000000)", "message": "HS oscillator: the external frequency must be 4 MHz or more."}
  ],
  "symbols": {
    "CONFIG2L.FOSC": {"ECPLL": "00000007", "EC": "00000006", "HSPLL": "00000005", "HS": "00000004", "INTOSCPLLO": "00000003", "INTOSCPLL": "00000002", "INTOSCO": "00000001", "INTOSC": "00000000"}
  }
}
