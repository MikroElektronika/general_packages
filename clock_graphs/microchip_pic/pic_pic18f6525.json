{
  "schema": 1,
  "id": "pic_pic18f6525",
  "title": "PIC oscillator fuses (PIC18F6525, PIC18F6585, PIC18F6621, PIC18F6680 and 4 more)",
  "vendor": "Microchip",
  "source": "NECTO mikroC PIC definitions (oscillator configuration fuses), PIC datasheets",
  "devices": ["^PIC18F6525$", "^PIC18F6585$", "^PIC18F6621$", "^PIC18F6680$", "^PIC18F8525$", "^PIC18F8585$", "^PIC18F8621$", "^PIC18F8680$"],
  "fosc": "source",
  "inputs": {
    "ext": {"label": "External frequency", "default": 8000000, "min": 1, "max": 40000000},
    "intosc": {"label": "Internal oscillator frequency", "default": 8000000, "min": 31000, "max": 40000000}
  },
  "settings": [],
  "nodes": [
    {
      "id": "ext",
      "label": "External oscillator / clock",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "ext"
    },
    {
      "id": "intosc",
      "label": "Internal oscillator (set by your code)",
      "kind": "source",
      "x": 0,
      "y": 3,
      "input": "intosc",
      "tooltip": "The internal oscillator frequency is chosen at runtime (OSCCON/OSCFRQ): enter the frequency your code sets."
    },
    {
      "id": "source",
      "label": "Oscillator (OSC)",
      "kind": "mux",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "rc_osc2_as_ra6", "label": "RC-OSC2 as RA6", "set": {"CONFIG1H.OSC": "0000000F"}, "from": "ext", "mul": 1},
        {"id": "hs_oscillator_with_sw_enabled_4x", "label": "HS oscillator with SW enabled 4x PLL", "set": {"CONFIG1H.OSC": "0000000E"}, "from": "ext", "mul": 4},
        {"id": "ec_oscillator_with_osc2_configur", "label": "EC oscillator with OSC2 configured as RA6 and SW enabled 4x ", "set": {"CONFIG1H.OSC": "0000000D"}, "from": "ext", "mul": 4},
        {"id": "ec_oscillator_with_osc2_configur_", "label": "EC oscillator with OSC2 configured as RA6 and HW enabled 4x ", "set": {"CONFIG1H.OSC": "0000000C"}, "from": "ext", "mul": 4},
        {"id": "rc_oscillator_with_osc2_configur", "label": "RC oscillator with OSC2 configured as RA6", "set": {"CONFIG1H.OSC": "00000007"}, "from": "ext", "mul": 1},
        {"id": "hs_oscillator_with_hw_enabled_4x", "label": "HS oscillator with HW enabled 4x PLL", "set": {"CONFIG1H.OSC": "00000006"}, "from": "ext", "mul": 4},
        {"id": "ec_oscillator_with_osc2_configur__", "label": "EC oscillator with OSC2 configured as RA6", "set": {"CONFIG1H.OSC": "00000005"}, "from": "ext", "mul": 1},
        {"id": "ec_oscillator_with_osc2_configur___", "label": "EC oscillator with OSC2 configured as divide by 4 clock outp", "set": {"CONFIG1H.OSC": "00000004"}, "from": "ext", "mul": 1},
        {"id": "rc_oscillator_with_osc2_configur_", "label": "RC oscillator with OSC2 configured as divide by 4 clock outp", "set": {"CONFIG1H.OSC": "00000003"}, "from": "ext", "mul": 1},
        {"id": "hs_oscillator", "label": "HS oscillator", "set": {"CONFIG1H.OSC": "00000002"}, "from": "ext", "mul": 1},
        {"id": "xt_oscillator", "label": "XT oscillator", "set": {"CONFIG1H.OSC": "00000001"}, "from": "ext", "mul": 1},
        {"id": "lp_oscillator", "label": "LP oscillator", "set": {"CONFIG1H.OSC": "00000000"}, "mul": 32768}
      ],
      "max": 40000000,
      "consumer": true
    }
  ],
  "constraints": [
    {"expr": "sel.source != 'hs_oscillator_with_sw_enabled_4x' || (in.ext >= 4000000)", "message": "HS oscillator with SW enabled 4x PLL: the external frequency must be 4 MHz or more."},
    {"expr": "sel.source != 'hs_oscillator_with_hw_enabled_4x' || (in.ext >= 4000000)", "message": "HS oscillator with HW enabled 4x PLL: the external frequency must be 4 MHz or more."},
    {"expr": "sel.source != 'hs_oscillator' || (in.ext >= 4000000)", "message": "HS oscillator: the external frequency must be 4 MHz or more."},
    {"expr": "sel.source != 'xt_oscillator' || (in.ext >= 100000 && in.ext <= 4000000)", "message": "XT oscillator: the external frequency must be 0.1-4 MHz."}
  ],
  "symbols": {
    "CONFIG1H.OSC": {"HSSWPLL": "0000000E", "ECIOSWPLL": "0000000D", "ECIOPLL": "0000000C", "RCIO": "00000007", "HSPLL": "00000006", "ECIO": "00000005", "EC": "00000004", "RC": "00000003", "HS": "00000002", "XT": "00000001", "LP": "00000000"}
  }
}
