{
  "schema": 1,
  "id": "tm4c123",
  "title": "TM4C123 system clock tree",
  "vendor": "Texas Instruments",
  "source": "TM4C123x datasheet SPMS376, System Control (RCC/RCC2)",
  "devices": ["^TM4C123"],
  "fosc": "sysclk",
  "inputs": {
    "mosc": {"label": "Main oscillator (crystal)", "default": 16000000, "min": 4000000, "max": 25000000}
  },
  "settings": ["RCC2.USBPWRDN"],
  "nodes": [
    {
      "id": "mosc",
      "label": "MOSC",
      "kind": "source",
      "x": 0,
      "y": 0,
      "input": "mosc",
      "enable": {"field": "RCC.MOSCDIS", "on": "00000000", "off": "00000001", "auto": "both"},
      "tooltip": "Main oscillator: a 4-25 MHz crystal; RCC.XTAL follows it."
    },
    {
      "id": "piosc",
      "label": "PIOSC 16 MHz",
      "kind": "source",
      "x": 0,
      "y": 1,
      "options": [
        {"id": "on", "label": "PIOSC 16 MHz", "mul": 16000000}
      ],
      "enable": {"field": "RCC.IOSCDIS", "on": "00000000", "off": "00000002", "auto": "on"}
    },
    {
      "id": "piosc4",
      "label": "PIOSC/4",
      "kind": "divider",
      "x": 1,
      "y": 2,
      "options": [
        {"id": "4", "label": "/4", "from": "piosc", "div": 4}
      ]
    },
    {
      "id": "lfiosc",
      "label": "LFIOSC 30 kHz",
      "kind": "source",
      "x": 0,
      "y": 3,
      "options": [
        {"id": "on", "label": "LFIOSC 30 kHz", "mul": 30000}
      ]
    },
    {
      "id": "oscsrc",
      "label": "Oscillator source",
      "kind": "mux",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "mosc", "label": "MOSC", "from": "mosc", "set": {"RCC2.OSCSCR2": "00000000", "RCC.OSCSCR": "00000000"}},
        {"id": "piosc", "label": "PIOSC", "from": "piosc", "set": {"RCC2.OSCSCR2": "00000010", "RCC.OSCSCR": "00000010"}},
        {"id": "piosc4", "label": "PIOSC/4", "from": "piosc4", "set": {"RCC2.OSCSCR2": "00000020", "RCC.OSCSCR": "00000020"}},
        {"id": "lfiosc", "label": "LFIOSC", "from": "lfiosc", "set": {"RCC2.OSCSCR2": "00000030", "RCC.OSCSCR": "00000030"}}
      ]
    },
    {
      "id": "pll",
      "label": "PLL 400 MHz",
      "kind": "source",
      "x": 3,
      "y": 0,
      "enable": {"field": "RCC2.PWRDN2", "on": "00000000", "off": "00002000", "auto": "both"},
      "tooltip": "The PLL runs at 400 MHz from MOSC (5 MHz or more) or PIOSC.",
      "options": [
        {"id": "on", "label": "PLL 400 MHz", "mul": 400000000, "keeps": ["oscsrc"]}
      ]
    },
