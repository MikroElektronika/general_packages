{
  "schema": 1,
  "id": "mspm0c",
  "title": "MSPM0C clock tree",
  "vendor": "Texas Instruments",
  "source": "MSPM0C technical reference manual SLAU893, SYSCTL",
  "devices": ["^MSPM0C110[34]"],
  "fosc": "mclk",
  "inputs": {
    "hfxt": {"label": "HFXT frequency", "default": 40000000, "min": 4000000, "max": 48000000}
  },
  "settings": ["HSCLKEN.USEEXTHFCLK"],
  "nodes": [
    {
      "id": "sysosc",
      "label": "SYSOSC",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "24m", "label": "SYSOSC 24 MHz", "mul": 24000000, "set": {"SYSOSCCFG.FREQ": "00000000"}},
        {"id": "4m", "label": "SYSOSC 4 MHz", "mul": 4000000, "set": {"SYSOSCCFG.FREQ": "00000001"}}
      ]
    },
    {
      "id": "hfxt",
      "label": "HFXT",
      "kind": "source",
      "x": 0,
      "y": 2,
      "input": "hfxt",
      "enable": {"field": "HSCLKEN.HFXTEN", "on": "00000001", "off": "00000000", "auto": "both"},
      "tooltip": "High-frequency crystal, 4-48 MHz (MSPM0G)."
    },
    {
      "id": "lfclk",
      "label": "LFCLK 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "LFCLK 32.768 kHz", "mul": 32768}
      ]
    },
    {
      "id": "pllref",
      "label": "SYSPLL reference",
      "kind": "mux",
      "x": 1,
      "y": 1,
      "options": [
        {"id": "sysosc", "label": "SYSOSC", "from": "sysosc", "set": {"SYSPLLCFG0.SYSPLLREF": "00000000"}},
        {"id": "hfclk", "label": "HFCLK", "from": "hfxt", "set": {"SYSPLLCFG0.SYSPLLREF": "00000001"}}
      ]
    },
    {
      "id": "pdiv",
      "label": "SYSPLL /PDIV",
      "kind": "divider",
      "x": 2,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "pllref", "set": {"SYSPLLCFG1.PDIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "pllref", "set": {"SYSPLLCFG1.PDIV": "00000001"}, "div": 2},
        {"id": "4", "label": "/4", "from": "pllref", "set": {"SYSPLLCFG1.PDIV": "00000002"}, "div": 4},
        {"id": "8", "label": "/8", "from": "pllref", "set": {"SYSPLLCFG1.PDIV": "00000003"}, "div": 8}
      ]
    },
    {
      "id": "vco",
      "label": "SYSPLL xQDIV (VCO)",
      "kind": "multiplier",
      "x": 3,
      "y": 1,
      "range": {"from": "pdiv", "op": "mul", "min": 2, "max": 128, "field": "SYSPLLCFG1.QDIV", "lsb": 8, "scale": 1, "offset": -1},
      "min": 80000000,
      "max": 400000000,
      "enable": {"field": "HSCLKEN.SYSPLLEN", "on": "00000100", "off": "00000000", "auto": "both"},
      "tooltip": "VCO: 80-400 MHz."
    },
    {
      "id": "clk2x",
      "label": "SYSPLLCLK2X",
      "kind": "divider",
      "x": 4,
      "y": 1,
      "enable": {"field": "SYSPLLCFG0.ENABLECLK2X", "on": "00000040", "off": "00000000", "auto": "both"},
      "options": [
        {"id": "1", "label": "x2 /1", "from": "vco", "mul": 2, "div": 1, "set": {"SYSPLLCFG0.RDIVCLK2X": "00000000"}},
        {"id": "2", "label": "x2 /2", "from": "vco", "mul": 2, "div": 2, "set": {"SYSPLLCFG0.RDIVCLK2X": "00010000"}},
        {"id": "3", "label": "x2 /3", "from": "vco", "mul": 2, "div": 3, "set": {"SYSPLLCFG0.RDIVCLK2X": "00020000"}},
        {"id": "4", "label": "x2 /4", "from": "vco", "mul": 2, "div": 4, "set": {"SYSPLLCFG0.RDIVCLK2X": "00030000"}},
        {"id": "5", "label": "x2 /5", "from": "vco", "mul": 2, "div": 5, "set": {"SYSPLLCFG0.RDIVCLK2X": "00040000"}},
        {"id": "6", "label": "x2 /6", "from": "vco", "mul": 2, "div": 6, "set": {"SYSPLLCFG0.RDIVCLK2X": "00050000"}},
        {"id": "7", "label": "x2 /7", "from": "vco", "mul": 2, "div": 7, "set": {"SYSPLLCFG0.RDIVCLK2X": "00060000"}},
        {"id": "8", "label": "x2 /8", "from": "vco", "mul": 2, "div": 8, "set": {"SYSPLLCFG0.RDIVCLK2X": "00070000"}},
        {"id": "9", "label": "x2 /9", "from": "vco", "mul": 2, "div": 9, "set": {"SYSPLLCFG0.RDIVCLK2X": "00080000"}},
        {"id": "10", "label": "x2 /10", "from": "vco", "mul": 2, "div": 10, "set": {"SYSPLLCFG0.RDIVCLK2X": "00090000"}},
        {"id": "11", "label": "x2 /11", "from": "vco", "mul": 2, "div": 11, "set": {"SYSPLLCFG0.RDIVCLK2X": "000A0000"}},
        {"id": "12", "label": "x2 /12", "from": "vco", "mul": 2, "div": 12, "set": {"SYSPLLCFG0.RDIVCLK2X": "000B0000"}},
        {"id": "13", "label": "x2 /13", "from": "vco", "mul": 2, "div": 13, "set": {"SYSPLLCFG0.RDIVCLK2X": "000C0000"}},
        {"id": "14", "label": "x2 /14", "from": "vco", "mul": 2, "div": 14, "set": {"SYSPLLCFG0.RDIVCLK2X": "000D0000"}},
        {"id": "15", "label": "x2 /15", "from": "vco", "mul": 2, "div": 15, "set": {"SYSPLLCFG0.RDIVCLK2X": "000E0000"}},
        {"id": "16", "label": "x2 /16", "from": "vco", "mul": 2, "div": 16, "set": {"SYSPLLCFG0.RDIVCLK2X": "000F0000"}}
      ]
    },
    {
      "id": "clk0",
      "label": "SYSPLLCLK0",
      "kind": "divider",
      "x": 4,
      "y": 2,
      "enable": {"field": "SYSPLLCFG0.ENABLECLK0", "on": "00000010", "off": "00000000", "auto": "both"},
      "options": [
        {"id": "2", "label": "/2", "from": "vco", "div": 2, "set": {"SYSPLLCFG0.RDIVCLK0": "00000000"}},
        {"id": "4", "label": "/4", "from": "vco", "div": 4, "set": {"SYSPLLCFG0.RDIVCLK0": "00000100"}},
        {"id": "6", "label": "/6", "from": "vco", "div": 6, "set": {"SYSPLLCFG0.RDIVCLK0": "00000200"}},
        {"id": "8", "label": "/8", "from": "vco", "div": 8, "set": {"SYSPLLCFG0.RDIVCLK0": "00000300"}},
        {"id": "10", "label": "/10", "from": "vco", "div": 10, "set": {"SYSPLLCFG0.RDIVCLK0": "00000400"}},
        {"id": "12", "label": "/12", "from": "vco", "div": 12, "set": {"SYSPLLCFG0.RDIVCLK0": "00000500"}},
        {"id": "14", "label": "/14", "from": "vco", "div": 14, "set": {"SYSPLLCFG0.RDIVCLK0": "00000600"}},
        {"id": "16", "label": "/16", "from": "vco", "div": 16, "set": {"SYSPLLCFG0.RDIVCLK0": "00000700"}},
        {"id": "18", "label": "/18", "from": "vco", "div": 18, "set": {"SYSPLLCFG0.RDIVCLK0": "00000800"}},
        {"id": "20", "label": "/20", "from": "vco", "div": 20, "set": {"SYSPLLCFG0.RDIVCLK0": "00000900"}},
        {"id": "22", "label": "/22", "from": "vco", "div": 22, "set": {"SYSPLLCFG0.RDIVCLK0": "00000A00"}},
        {"id": "24", "label": "/24", "from": "vco", "div": 24, "set": {"SYSPLLCFG0.RDIVCLK0": "00000B00"}},
        {"id": "26", "label": "/26", "from": "vco", "div": 26, "set": {"SYSPLLCFG0.RDIVCLK0": "00000C00"}},
        {"id": "28", "label": "/28", "from": "vco", "div": 28, "set": {"SYSPLLCFG0.RDIVCLK0": "00000D00"}},
        {"id": "30", "label": "/30", "from": "vco", "div": 30, "set": {"SYSPLLCFG0.RDIVCLK0": "00000E00"}},
        {"id": "32", "label": "/32", "from": "vco", "div": 32, "set": {"SYSPLLCFG0.RDIVCLK0": "00000F00"}}
      ]
    },
    {
      "id": "clk1",
      "label": "SYSPLLCLK1",
      "kind": "divider",
      "x": 4,
      "y": 3,
      "enable": {"field": "SYSPLLCFG0.ENABLECLK1", "on": "00000020", "off": "00000000", "auto": "both"},
      "tooltip": "SYSPLLCLK1 clocks CAN-FD and can be routed to CLK_OUT.",
      "options": [
        {"id": "2", "label": "/2", "from": "vco", "div": 2, "set": {"SYSPLLCFG0.RDIVCLK1": "00000000"}},
        {"id": "4", "label": "/4", "from": "vco", "div": 4, "set": {"SYSPLLCFG0.RDIVCLK1": "00001000"}},
        {"id": "6", "label": "/6", "from": "vco", "div": 6, "set": {"SYSPLLCFG0.RDIVCLK1": "00002000"}},
        {"id": "8", "label": "/8", "from": "vco", "div": 8, "set": {"SYSPLLCFG0.RDIVCLK1": "00003000"}},
        {"id": "10", "label": "/10", "from": "vco", "div": 10, "set": {"SYSPLLCFG0.RDIVCLK1": "00004000"}},
        {"id": "12", "label": "/12", "from": "vco", "div": 12, "set": {"SYSPLLCFG0.RDIVCLK1": "00005000"}},
        {"id": "14", "label": "/14", "from": "vco", "div": 14, "set": {"SYSPLLCFG0.RDIVCLK1": "00006000"}},
        {"id": "16", "label": "/16", "from": "vco", "div": 16, "set": {"SYSPLLCFG0.RDIVCLK1": "00007000"}},
        {"id": "18", "label": "/18", "from": "vco", "div": 18, "set": {"SYSPLLCFG0.RDIVCLK1": "00008000"}},
        {"id": "20", "label": "/20", "from": "vco", "div": 20, "set": {"SYSPLLCFG0.RDIVCLK1": "00009000"}},
        {"id": "22", "label": "/22", "from": "vco", "div": 22, "set": {"SYSPLLCFG0.RDIVCLK1": "0000A000"}},
        {"id": "24", "label": "/24", "from": "vco", "div": 24, "set": {"SYSPLLCFG0.RDIVCLK1": "0000B000"}},
        {"id": "26", "label": "/26", "from": "vco", "div": 26, "set": {"SYSPLLCFG0.RDIVCLK1": "0000C000"}},
        {"id": "28", "label": "/28", "from": "vco", "div": 28, "set": {"SYSPLLCFG0.RDIVCLK1": "0000D000"}},
        {"id": "30", "label": "/30", "from": "vco", "div": 30, "set": {"SYSPLLCFG0.RDIVCLK1": "0000E000"}},
        {"id": "32", "label": "/32", "from": "vco", "div": 32, "set": {"SYSPLLCFG0.RDIVCLK1": "0000F000"}}
      ]
    },
    {
      "id": "pllout",
      "label": "SYSPLL to HSCLK",
      "kind": "mux",
      "x": 5,
      "y": 1,
      "options": [
        {"id": "clk2x", "label": "SYSPLLCLK2X", "from": "clk2x", "set": {"SYSPLLCFG0.MCLK2XVCO": "00000002"}},
        {"id": "clk0", "label": "SYSPLLCLK0", "from": "clk0", "set": {"SYSPLLCFG0.MCLK2XVCO": "00000000"}}
      ]
    },
    {
      "id": "hsclk",
      "label": "HSCLK",
      "kind": "mux",
      "x": 6,
      "y": 1,
      "options": [
        {"id": "syspll", "label": "SYSPLL", "from": "pllout", "set": {"HSCLKCFG.HSCLKSEL": "00000000"}},
        {"id": "hfclk", "label": "HFCLK", "from": "hfxt", "set": {"HSCLKCFG.HSCLKSEL": "00000001"}}
      ]
    },
    {
      "id": "mdiv",
      "label": "SYSOSC /MDIV",
      "kind": "divider",
      "x": 2,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000001"}, "div": 2},
        {"id": "3", "label": "/3", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000002"}, "div": 3},
        {"id": "4", "label": "/4", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000003"}, "div": 4},
        {"id": "5", "label": "/5", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000004"}, "div": 5},
        {"id": "6", "label": "/6", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000005"}, "div": 6},
        {"id": "7", "label": "/7", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000006"}, "div": 7},
        {"id": "8", "label": "/8", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000007"}, "div": 8},
        {"id": "9", "label": "/9", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000008"}, "div": 9},
        {"id": "10", "label": "/10", "from": "sysosc", "set": {"MCLKCFG.MDIV": "00000009"}, "div": 10},
        {"id": "11", "label": "/11", "from": "sysosc", "set": {"MCLKCFG.MDIV": "0000000A"}, "div": 11},
        {"id": "12", "label": "/12", "from": "sysosc", "set": {"MCLKCFG.MDIV": "0000000B"}, "div": 12},
        {"id": "13", "label": "/13", "from": "sysosc", "set": {"MCLKCFG.MDIV": "0000000C"}, "div": 13},
        {"id": "14", "label": "/14", "from": "sysosc", "set": {"MCLKCFG.MDIV": "0000000D"}, "div": 14},
        {"id": "15", "label": "/15", "from": "sysosc", "set": {"MCLKCFG.MDIV": "0000000E"}, "div": 15},
        {"id": "16", "label": "/16", "from": "sysosc", "set": {"MCLKCFG.MDIV": "0000000F"}, "div": 16}
      ],
      "tooltip": "MDIV divides SYSOSC only when MCLK runs from SYSOSC."
    },
    {
      "id": "mclk",
      "label": "MCLK",
      "kind": "mux",
      "x": 7,
      "y": 0,
      "max": 24000000,
      "consumer": true,
      "options": [
        {"id": "sysosc", "label": "SYSOSC", "from": "mdiv", "set": {"?MCLKCFG.USEHSCLK": "00000000", "MCLKCFG.USELFCLK": "00000000"}},
        {"id": "hsclk", "label": "HSCLK", "from": "hsclk", "set": {"MCLKCFG.USEHSCLK": "00010000", "MCLKCFG.USELFCLK": "00000000"}},
        {"id": "lfclk", "label": "LFCLK", "from": "lfclk", "set": {"?MCLKCFG.USEHSCLK": "00000000", "MCLKCFG.USELFCLK": "00100000"}}
      ]
    },
    {
      "id": "ulpclk",
      "label": "ULPCLK (UDIV)",
      "kind": "divider",
      "x": 8,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "mclk", "set": {"MCLKCFG.UDIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "mclk", "set": {"MCLKCFG.UDIV": "00000010"}, "div": 2},
        {"id": "3", "label": "/3", "from": "mclk", "set": {"MCLKCFG.UDIV": "00000020"}, "div": 3}
      ],
      "max": 24000000,
      "consumer": true
    }
  ],
  "derive": [
    {"field": "MCLKCFG.FLASHWAIT", "cases": [{"when": "f.mclk <= 24000000", "value": "00000000"}, {"when": "f.mclk <= 48000000", "value": "00000100"}], "default": "00000200"},
    {"field": "HFCLKCLKCFG.HFXTRSEL", "cases": [{"when": "in.hfxt <= 8000000", "value": "00000000"}, {"when": "in.hfxt <= 16000000", "value": "00001000"}, {"when": "in.hfxt <= 32000000", "value": "00002000"}], "default": "00003000"}
  ]
}
