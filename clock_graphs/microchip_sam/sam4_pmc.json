{
  "schema": 1,
  "id": "sam4_pmc",
  "title": "SAM4E/4N/4S clock tree",
  "vendor": "Microchip",
  "source": "SAM4E DS60001520, SAM4N DS60001523, SAM4S DS60001519, PMC",
  "devices": ["^ATSAM4(E|N|S)"],
  "fosc": "hclk",
  "inputs": {
    "main_xtal": {"label": "Main crystal frequency", "default": 12000000, "min": 3000000, "max": 20000000}
  },
  "settings": ["CKGR_MOR.MOSCXTBY", "CKGR_MOR.CFDEN", "SUPC_MR.OSCBYPASS"],
  "nodes": [
    {
      "id": "main_rc",
      "label": "Main RC",
      "kind": "source",
      "x": 0,
      "y": 0,
      "enable": {"field": "CKGR_MOR.MOSCRCEN", "on": "00000008", "off": "00000000", "auto": "on"},
      "options": [
        {"id": "4", "label": "RC 4 MHz", "mul": 4000000, "set": {"CKGR_MOR.MOSCRCF": "00000000"}},
        {"id": "8", "label": "RC 8 MHz", "mul": 8000000, "set": {"CKGR_MOR.MOSCRCF": "00000010"}},
        {"id": "12", "label": "RC 12 MHz", "mul": 12000000, "set": {"CKGR_MOR.MOSCRCF": "00000020"}}
      ]
    },
    {
      "id": "main_xtal",
      "label": "Main crystal",
      "kind": "source",
      "x": 0,
      "y": 2,
      "input": "main_xtal",
      "enable": {"field": "CKGR_MOR.MOSCXTEN", "on": "00000001", "off": "00000000", "auto": "both"},
      "tooltip": "3-20 MHz crystal (CKGR_MOR.MOSCXTEN)."
    },
    {
      "id": "mainck",
      "label": "MAINCK",
      "kind": "mux",
      "x": 1,
      "y": 1,
      "options": [
        {"id": "rc", "label": "Main RC", "from": "main_rc", "set": {"CKGR_MOR.MOSCSEL": "00000000"}},
        {"id": "xtal", "label": "Main crystal", "from": "main_xtal", "set": {"CKGR_MOR.MOSCSEL": "01000000"}}
      ]
    },
    {
      "id": "slck",
      "label": "Slow clock (SLCK)",
      "kind": "source",
      "x": 0,
      "y": 6,
      "tooltip": "SUPC_CR.XTALSEL switches SLCK to the 32.768 kHz crystal.",
      "options": [
        {"id": "rc", "label": "RC 32 kHz", "mul": 32000, "set": {"SUPC_CR.XTALSEL": "00000000"}},
        {"id": "xtal", "label": "Crystal 32.768 kHz", "mul": 32768, "set": {"SUPC_CR.XTALSEL": "00000008"}}
      ]
    },
    {
      "id": "diva",
      "label": "PLLA /DIVA",
      "kind": "divider",
      "x": 2,
      "y": 1,
      "range": {"from": "mainck", "op": "div", "min": 1, "max": 255, "field": "CKGR_PLLAR.DIVA", "lsb": 0, "scale": 1, "offset": 0},
      "min": 3000000,
      "max": 32000000,
      "tooltip": "PLLA input: 3-32 MHz."
    },
    {
      "id": "mula",
      "label": "PLLA xMULA",
      "kind": "multiplier",
      "x": 3,
      "y": 1,
      "range": {"from": "diva", "op": "mul", "min": 2, "max": 63, "field": "CKGR_PLLAR.MULA", "lsb": 16, "scale": 1, "offset": -1},
      "min": 80000000,
      "max": 240000000,
      "tooltip": "PLLA output: 80-240 MHz."
    },
    {
      "id": "pllack",
      "label": "PLLADIV2",
      "kind": "divider",
      "x": 4,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "mula", "set": {"PMC_MCKR.PLLADIV2": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "mula", "set": {"PMC_MCKR.PLLADIV2": "00001000"}, "div": 2}
      ]
    },
    {
      "id": "divb",
      "label": "PLLB /DIVB",
      "kind": "divider",
      "x": 2,
      "y": 3,
      "range": {"from": "mainck", "op": "div", "min": 1, "max": 255, "field": "CKGR_PLLBR.DIVB", "lsb": 0, "scale": 1, "offset": 0},
      "min": 3000000,
      "max": 32000000,
      "tooltip": "PLLB (SAM4S/4SA/4SD) input: 3-32 MHz."
    },
    {
      "id": "mulb",
      "label": "PLLB xMULB",
      "kind": "multiplier",
      "x": 3,
      "y": 3,
      "range": {"from": "divb", "op": "mul", "min": 2, "max": 63, "field": "CKGR_PLLBR.MULB", "lsb": 16, "scale": 1, "offset": -1},
      "min": 80000000,
      "max": 240000000,
      "tooltip": "PLLB output: 80-240 MHz. 96 MHz gives the 48 MHz USB clock with USBDIV /2."
    },
    {
      "id": "pllbck",
      "label": "PLLBDIV2",
      "kind": "divider",
      "x": 4,
      "y": 3,
      "options": [
        {"id": "1", "label": "/1", "from": "mulb", "set": {"PMC_MCKR.PLLBDIV2": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "mulb", "set": {"PMC_MCKR.PLLBDIV2": "00002000"}, "div": 2}
      ]
    },
    {
      "id": "css",
      "label": "Master clock source",
      "kind": "mux",
      "x": 5,
      "y": 1,
      "options": [
        {"id": "slck", "label": "SLCK", "from": "slck", "set": {"PMC_MCKR.CSS": "00000000"}},
        {"id": "mainck", "label": "MAINCK", "from": "mainck", "set": {"PMC_MCKR.CSS": "00000001"}},
        {"id": "plla", "label": "PLLA", "from": "pllack", "set": {"PMC_MCKR.CSS": "00000002"}},
        {"id": "pllb", "label": "PLLB", "from": "pllbck", "set": {"PMC_MCKR.CSS": "00000003"}}
      ]
    },
    {
      "id": "hclk",
      "label": "MCK (PRES)",
      "kind": "divider",
      "x": 6,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "css", "set": {"PMC_MCKR.PRES": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "css", "set": {"PMC_MCKR.PRES": "00000010"}, "div": 2},
        {"id": "4", "label": "/4", "from": "css", "set": {"PMC_MCKR.PRES": "00000020"}, "div": 4},
        {"id": "8", "label": "/8", "from": "css", "set": {"PMC_MCKR.PRES": "00000030"}, "div": 8},
        {"id": "16", "label": "/16", "from": "css", "set": {"PMC_MCKR.PRES": "00000040"}, "div": 16},
        {"id": "32", "label": "/32", "from": "css", "set": {"PMC_MCKR.PRES": "00000050"}, "div": 32},
        {"id": "64", "label": "/64", "from": "css", "set": {"PMC_MCKR.PRES": "00000060"}, "div": 64},
        {"id": "3", "label": "/3", "from": "css", "set": {"PMC_MCKR.PRES": "00000070"}, "div": 3}
      ],
      "max": 120000000,
      "consumer": true,
      "tooltip": "Master/processor clock: at most 120 MHz (100 MHz on SAM4N)."
    },
    {
      "id": "usbsrc",
      "label": "USB source",
      "kind": "mux",
      "x": 5,
      "y": 4,
      "options": [
        {"id": "plla", "label": "PLLA", "from": "pllack", "set": {"?PMC_USB.USBS": "00000000"}},
        {"id": "pllb", "label": "PLLB", "from": "pllbck", "set": {"PMC_USB.USBS": "00000001"}}
      ],
      "tooltip": "SAM4E has no USBS: its USB clock always comes from PLLA."
    },
    {
      "id": "usbclk",
      "label": "UDP /USBDIV",
      "kind": "divider",
      "x": 6,
      "y": 4,
      "range": {"from": "usbsrc", "op": "div", "min": 1, "max": 16, "field": "PMC_USB.USBDIV", "lsb": 8, "scale": 1, "offset": -1},
      "max": 48000000,
      "tooltip": "USB device (UDP, SAM4E/4S) needs exactly 48 MHz."
    }
  ],
  "derive": [
    {"field": "EEFC_FMR.FWS", "cases": [{"when": "f.hclk <= 20000000", "value": "00000000"}, {"when": "f.hclk <= 40000000", "value": "00000100"}, {"when": "f.hclk <= 60000000", "value": "00000200"}, {"when": "f.hclk <= 80000000", "value": "00000300"}, {"when": "f.hclk <= 100000000", "value": "00000400"}], "default": "00000500"}
  ],
  "variants": [
    {"devices": ["^ATSAM4N"], "limits": {"hclk": {"max": 100000000}}}
  ]
}
