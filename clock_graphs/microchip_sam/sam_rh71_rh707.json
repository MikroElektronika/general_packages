{
  "schema": 1,
  "id": "sam_rh71_rh707",
  "title": "SAM RH71/RH707 clock tree",
  "vendor": "Microchip",
  "source": "SAMRH71 DS60001593, SAMRH707 datasheet, PMC",
  "devices": ["^ATSAMRH7(1|07)"],
  "fosc": "hclk",
  "inputs": {
    "main_xtal": {"label": "Main crystal frequency", "default": 10000000, "min": 8000000, "max": 20000000}
  },
  "settings": ["CKGR_MOR.CFDEN", "?CKGR_MOR.MOSCXTBY"],
  "nodes": [
    {
      "id": "main_rc",
      "label": "Main RC",
      "kind": "source",
      "x": 0,
      "y": 0,
      "enable": {"field": "CKGR_MOR.MOSCRCEN", "on": "00000008", "off": "00000000", "auto": "on"},
      "options": [
        {"id": "4", "label": "RC 4 MHz", "mul": 4000000, "set": {"CKGR_MOR.MOSCRCF": "00000000"}},
        {"id": "8", "label": "RC 8 MHz", "mul": 8000000, "set": {"CKGR_MOR.MOSCRCF": "00000010"}},
        {"id": "10", "label": "RC 10 MHz", "mul": 10000000, "set": {"CKGR_MOR.MOSCRCF": "00000020"}},
        {"id": "12", "label": "RC 12 MHz", "mul": 12000000, "set": {"CKGR_MOR.MOSCRCF": "00000030"}}
      ]
    },
    {
      "id": "main_xtal",
      "label": "Main crystal",
      "kind": "source",
      "x": 0,
      "y": 2,
      "input": "main_xtal",
      "enable": {"field": "CKGR_MOR.MOSCXTEN", "on": "00000001", "off": "00000000", "auto": "both"},
      "tooltip": "Crystal or external clock on XIN (CKGR_MOR.MOSCXTEN)."
    },
    {
      "id": "mainck",
      "label": "MAINCK",
      "kind": "mux",
      "x": 1,
      "y": 1,
      "options": [
        {"id": "rc", "label": "Main RC", "from": "main_rc", "set": {"CKGR_MOR.MOSCSEL": "00000000"}},
        {"id": "xtal", "label": "Main crystal", "from": "main_xtal", "set": {"CKGR_MOR.MOSCSEL": "01000000"}}
      ]
    },
    {
      "id": "slck",
      "label": "Slow clock (MD_SLCK)",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "rc", "label": "RC 32 kHz", "mul": 32000, "set": {"SUPC_CR.TDXTALSEL": "00000000"}},
        {"id": "xtal", "label": "Crystal 32.768 kHz", "mul": 32768, "set": {"SUPC_CR.TDXTALSEL": "00000008"}}
      ]
    },
    {
      "id": "diva",
      "label": "PLLA /DIVA",
      "kind": "divider",
      "x": 2,
      "y": 1,
      "range": {"from": "mainck", "op": "div", "min": 1, "max": 64, "field": "CKGR_PLLAR.DIVA", "lsb": 0, "scale": 1, "offset": 0},
      "min": 8000000,
      "max": 20000000,
      "tooltip": "PLLA input: 8-20 MHz."
    },
    {
      "id": "mula",
      "label": "PLLA xMULA",
      "kind": "multiplier",
      "x": 3,
      "y": 1,
      "range": {"from": "diva", "op": "mul", "min": 2, "max": 57, "field": "CKGR_PLLAR.MULA", "lsb": 16, "scale": 1, "offset": -1},
      "min": 40000000,
      "max": 200000000,
      "tooltip": "PLLA output: 40-200 MHz; the VCO band (FREQ_VCO) follows it."
    },
    {
      "id": "css",
      "label": "Master clock source",
      "kind": "mux",
      "x": 4,
      "y": 1,
      "options": [
        {"id": "slck", "label": "MD_SLCK", "from": "slck", "set": {"PMC_MCKR.CSS": "00000000"}},
        {"id": "mainck", "label": "MAINCK", "from": "mainck", "set": {"PMC_MCKR.CSS": "00000001"}},
        {"id": "plla", "label": "PLLA", "from": "mula", "set": {"PMC_MCKR.CSS": "00000002"}}
      ]
    },
    {
      "id": "hclk",
      "label": "Processor clock (PRES)",
      "kind": "divider",
      "x": 5,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "css", "set": {"PMC_MCKR.PRES": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "css", "set": {"PMC_MCKR.PRES": "00000010"}, "div": 2},
        {"id": "4", "label": "/4", "from": "css", "set": {"PMC_MCKR.PRES": "00000020"}, "div": 4},
        {"id": "8", "label": "/8", "from": "css", "set": {"PMC_MCKR.PRES": "00000030"}, "div": 8},
        {"id": "16", "label": "/16", "from": "css", "set": {"PMC_MCKR.PRES": "00000040"}, "div": 16},
        {"id": "32", "label": "/32", "from": "css", "set": {"PMC_MCKR.PRES": "00000050"}, "div": 32},
        {"id": "64", "label": "/64", "from": "css", "set": {"PMC_MCKR.PRES": "00000060"}, "div": 64}
      ],
      "max": 100000000,
      "consumer": true,
      "tooltip": "Processor clock: at most 100 MHz (RH71) / 50 MHz (RH707)."
    },
    {
      "id": "mck",
      "label": "MCK (MDIV)",
      "kind": "divider",
      "x": 6,
      "y": 1,
      "options": [
        {"id": "1", "label": "/1", "from": "hclk", "set": {"PMC_MCKR.MDIV": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "hclk", "set": {"PMC_MCKR.MDIV": "00000100"}, "div": 2}
      ],
      "max": 50000000,
      "consumer": true,
      "tooltip": "Master clock for the matrix and peripherals."
    }
  ],
  "derive": [
    {"field": "CKGR_PLLAR.FREQ_VCO", "cases": [{"when": "f.mula < 75000000", "value": "00000000"}, {"when": "f.mula < 140000000", "value": "00004000"}], "default": "00008000"}
  ],
  "variants": [
    {"devices": ["^ATSAMRH707"], "limits": {"hclk": {"max": 50000000}, "mck": {"max": 25000000}}}
  ]
}
