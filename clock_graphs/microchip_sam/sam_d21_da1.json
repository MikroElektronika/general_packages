        {"id": "osc32k", "label": "OSC32K", "from": "osc32k", "set": {"GENCTRL0.SRC": "00000400"}},
        {"id": "osculp32k", "label": "OSCULP32K", "from": "osculp32k", "set": {"GENCTRL0.SRC": "00000300"}},
        {"id": "dfll48m", "label": "DFLL48M", "from": "dfll48m", "set": {"GENCTRL0.SRC": "00000700"}}
      ]
    },
    {
