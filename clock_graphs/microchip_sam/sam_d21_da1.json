        {"id": "64", "label": "/64", "from": "gclk0", "set": {"CPUSEL.CPUDIV": "00000006"}, "div": 64},
        {"id": "128", "label": "/128", "from": "gclk0", "set": {"CPUSEL.CPUDIV": "00000007"}, "div": 128}
