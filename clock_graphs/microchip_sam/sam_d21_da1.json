    {"field": "XOSC.GAIN", "cases": [{"when": "in.xosc <= 2000000", "value": "00000000"}, {"when": "in.xosc <= 4000000", "value": "00000100"}, {"when": "in.xosc <= 8000000", "value": "00000200"}, {"when": "in.xosc <= 16000000", "value": "00000300"}], "default": "00000400"}
