  "fosc": "cpu",
  "inputs": {
    "xosc": {"label": "XOSC frequency", "default": 16000000, "min": 400000, "max": 32000000}
  },
  "settings": ["XOSC.XTALEN", "XOSC32K.XTALEN", "DFLLCTRL.MODE"],
  "nodes": [
    {
      "id": "osc8m",
      "label": "OSC8M 8 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "OSC8M 8 MHz", "mul": 8000000}
      ],
      "enable": {"field": "OSC8M.ENABLE", "on": "00000002", "off": "00000000", "auto": "on"}
    },
    {
      "id": "osc8m_presc",
      "label": "OSC8M prescaler",
      "kind": "divider",
      "x": 1,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "osc8m", "set": {"OSC8M.PRESC": "00000000"}, "div": 1},
        {"id": "2", "label": "/2", "from": "osc8m", "set": {"OSC8M.PRESC": "00000100"}, "div": 2},
        {"id": "4", "label": "/4", "from": "osc8m", "set": {"OSC8M.PRESC": "00000200"}, "div": 4},
        {"id": "8", "label": "/8", "from": "osc8m", "set": {"OSC8M.PRESC": "00000300"}, "div": 8}
      ]
    },
    {
      "id": "xosc",
      "label": "XOSC",
      "kind": "source",
      "x": 0,
      "y": 1,
      "input": "xosc",
      "enable": {"field": "XOSC.ENABLE", "on": "00000002", "off": "00000000", "auto": "both"},
      "tooltip": "External crystal or clock, 0.4-32 MHz."
    },
    {
      "id": "xosc32k",
      "label": "XOSC32K 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 2,
      "options": [
        {"id": "on", "label": "XOSC32K 32.768 kHz", "mul": 32768}
      ],
      "enable": {"field": "XOSC32K.ENABLE", "on": "00000002", "off": "00000000", "auto": "both"}
    },
    {
      "id": "osc32k",
      "label": "OSC32K 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 3,
      "options": [
        {"id": "on", "label": "OSC32K 32.768 kHz", "mul": 32768}
      ],
      "enable": {"field": "OSC32K.ENABLE", "on": "00000002", "off": "00000000", "auto": "both"}
    },
    {
      "id": "osculp32k",
      "label": "OSCULP32K 32.768 kHz",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "OSCULP32K 32.768 kHz", "mul": 32768}
      ]
    },
    {
      "id": "dfll48m",
      "label": "DFLL48M 48 MHz",
      "kind": "source",
      "x": 1,
      "y": 5,
      "options": [
        {"id": "on", "label": "DFLL48M 48 MHz", "mul": 48000000}
      ],
      "enable": {"field": "DFLLCTRL.ENABLE", "on": "00000002", "off": "00000000", "auto": "both"},
      "tooltip": "Open loop on the factory calibration (DFLLVAL 0). Closed-loop operation is set in the register view."
    },
    {
      "id": "gclk0",
      "label": "GCLK0 source",
      "kind": "mux",
      "x": 2,
      "y": 2,
      "options": [
        {"id": "osc8m", "label": "OSC8M", "from": "osc8m_presc", "set": {"GENCTRL0.SRC": "00000600"}},
        {"id": "xosc", "label": "XOSC", "from": "xosc", "set": {"GENCTRL0.SRC": "00000000"}},
