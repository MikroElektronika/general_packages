{
  "schema": 1,
  "id": "sam_d21_da1",
  "title": "SAM D21/DA1 clock tree",
  "vendor": "Microchip",
  "source": "SAM D21/DA1 datasheet DS40001882, SYSCTRL/GCLK/PM",
