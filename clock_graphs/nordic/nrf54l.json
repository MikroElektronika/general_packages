{
  "schema": 1,
  "id": "nrf54l",
  "title": "nRF54L clock tree",
  "vendor": "Nordic Semiconductor",
  "source": "nRF54L05/L10/L15/LM20A/LM20B datasheets, CLOCK and OSCILLATORS",
  "devices": ["^NRF54L"],
  "fosc": "cpu",
  "inputs": {},
  "settings": ["CLOCK_TASKS_LFCLKSTART.TASKS_LFCLKSTART"],
  "nodes": [
    {
      "id": "hfint",
      "label": "HFINT 128 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "HFINT 128 MHz", "mul": 128000000}
      ]
    },
    {
      "id": "hfxo",
      "label": "HFXO 32 MHz crystal",
      "kind": "source",
      "x": 0,
      "y": 1,
      "options": [
        {"id": "on", "label": "HFXO 32 MHz crystal", "mul": 32000000}
      ]
    },
    {
      "id": "pll",
      "label": "PLL 128 MHz (XOSTART)",
      "kind": "mux",
      "x": 1,
      "y": 0,
      "options": [
        {"id": "hfint", "label": "HFINT RC oscillator", "from": "hfint", "set": {"CLOCK_TASKS_XOSTART.TASKS_XOSTART": "00000000"}},
        {"id": "hfxo", "label": "HFXO crystal (x4)", "from": "hfxo", "set": {"CLOCK_TASKS_XOSTART.TASKS_XOSTART": "00000001"}, "mul": 4}
      ]
    },
    {
      "id": "cpu",
      "label": "CPU (PLL.FREQ)",
      "kind": "divider",
      "x": 2,
      "y": 0,
      "options": [
        {"id": "1", "label": "/1", "from": "pll", "set": {"OSCILLATORS_PLL_FREQ.FREQ": "00000001"}, "div": 1},
        {"id": "2", "label": "/2", "from": "pll", "set": {"OSCILLATORS_PLL_FREQ.FREQ": "00000003"}, "div": 2}
      ],
      "consumer": true,
      "max": 128000000
    },
    {
      "id": "lfrc",
      "label": "LFRC 32.768 kHz RC",
      "kind": "source",
      "x": 0,
      "y": 3,
      "options": [
        {"id": "on", "label": "LFRC 32.768 kHz RC", "mul": 32768}
      ]
    },
    {
      "id": "lfxo",
      "label": "LFXO 32.768 kHz crystal",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "LFXO 32.768 kHz crystal", "mul": 32768}
      ],
      "tooltip": "External 32.768 kHz crystal on XL1/XL2."
    },
    {
      "id": "lfclk",
      "label": "LFCLK (32.768 kHz)",
      "kind": "mux",
      "x": 2,
      "y": 3,
      "options": [
        {"id": "lfrc", "label": "LFRC", "from": "lfrc", "set": {"CLOCK_LFCLK_SRC.SRC": "00000000"}},
        {"id": "lfxo", "label": "LFXO", "from": "lfxo", "set": {"CLOCK_LFCLK_SRC.SRC": "00000001"}},
        {"id": "synth", "label": "Synthesized from HFCLK", "from": "pll", "mul": 4, "div": 15625, "set": {"CLOCK_LFCLK_SRC.SRC": "00000002"}}
      ],
      "tooltip": "Low frequency clock for RTC, WDT and timers. It runs only when \"Start LFCLK in SystemInit\" is chosen; the synthesized source is only as accurate as HFCLK, so start the HFXO with it."
    }
  ]
}
