{
  "schema": 1,
  "id": "nrf51",
  "title": "nRF51 clock tree",
  "vendor": "Nordic Semiconductor",
  "source": "nRF51 Series Reference Manual v3.0, CLOCK",
  "devices": ["^NRF51"],
  "fosc": "hfclk",
  "inputs": {},
  "settings": ["CLOCK_TASKS_LFCLKSTART.TASKS_LFCLKSTART"],
  "nodes": [
    {
      "id": "hfint",
      "label": "HFINT 16 MHz RC",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "HFINT 16 MHz RC", "mul": 16000000}
      ]
    },
    {
      "id": "hfxo16",
      "label": "HFXO 16 MHz crystal",
      "kind": "source",
      "x": 0,
      "y": 1,
      "options": [
        {"id": "on", "label": "HFXO 16 MHz crystal", "mul": 16000000}
      ]
    },
    {
      "id": "hfxo32",
      "label": "HFXO 32 MHz crystal",
      "kind": "source",
      "x": 0,
      "y": 2,
      "options": [
        {"id": "on", "label": "HFXO 32 MHz crystal", "mul": 32000000}
      ]
    },
    {
      "id": "hfclk",
      "label": "HFCLK (CPU 16 MHz)",
      "kind": "mux",
      "x": 1,
      "y": 0,
      "options": [
        {"id": "hfint", "label": "HFINT RC oscillator", "from": "hfint", "set": {"CLOCK_TASKS_HFCLKSTART.TASKS_HFCLKSTART": "00000000"}},
        {"id": "hfxo16", "label": "HFXO 16 MHz crystal", "from": "hfxo16", "set": {"CLOCK_TASKS_HFCLKSTART.TASKS_HFCLKSTART": "00000001", "CLOCK_XTALFREQ.XTALFREQ": "000000FF"}},
        {"id": "hfxo32", "label": "HFXO 32 MHz crystal / 2", "from": "hfxo32", "set": {"CLOCK_TASKS_HFCLKSTART.TASKS_HFCLKSTART": "00000001", "CLOCK_XTALFREQ.XTALFREQ": "00000000"}, "div": 2}
      ],
      "consumer": true,
      "max": 16000000,
      "tooltip": "The CPU always runs at 16 MHz; the crystal makes HFCLK accurate (needed by the radio)."
    },
    {
      "id": "lfrc",
      "label": "LFRC 32.768 kHz RC",
      "kind": "source",
      "x": 0,
      "y": 3,
      "options": [
        {"id": "on", "label": "LFRC 32.768 kHz RC", "mul": 32768}
      ]
    },
    {
      "id": "lfxo",
      "label": "LFXO 32.768 kHz crystal",
      "kind": "source",
      "x": 0,
      "y": 4,
      "options": [
        {"id": "on", "label": "LFXO 32.768 kHz crystal", "mul": 32768}
      ],
      "tooltip": "External 32.768 kHz crystal on XL1/XL2."
    },
    {
      "id": "lfclk",
      "label": "LFCLK (32.768 kHz)",
      "kind": "mux",
      "x": 2,
      "y": 3,
      "options": [
        {"id": "lfrc", "label": "LFRC", "from": "lfrc", "set": {"CLOCK_LFCLKSRC.SRC": "00000000"}},
        {"id": "lfxo", "label": "LFXO", "from": "lfxo", "set": {"CLOCK_LFCLKSRC.SRC": "00000001"}},
        {"id": "synth", "label": "Synthesized from HFCLK", "from": "hfclk", "mul": 256, "div": 125000, "set": {"CLOCK_LFCLKSRC.SRC": "00000002"}}
      ],
      "tooltip": "Low frequency clock for RTC, WDT and timers. It runs only when \"Start LFCLK in SystemInit\" is chosen; the synthesized source is only as accurate as HFCLK, so start the HFXO with it."
    }
  ]
}
