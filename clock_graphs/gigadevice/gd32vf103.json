{
  "schema": 1,
  "id": "gd32vf103",
  "title": "GD32VF103 clock tree",
  "vendor": "GigaDevice",
  "source": "GD32VF103 user manual, Reset and clock unit (RCU)",
  "devices": ["^GD32VF103"],
  "fosc": "sysclk",
  "inputs": {
    "hxtal": {"label": "HXTAL frequency", "default": 8000000, "min": 4000000, "max": 32000000}
  },
  "settings": ["RCU_CTL.HXTALBPS", "RCU_CTL.CKMEN"],
  "nodes": [
    {
      "id": "irc8m",
      "label": "IRC8M 8 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "IRC8M 8 MHz", "mul": 8000000}
      ],
      "enable": {"field": "RCU_CTL.IRC8MEN", "on": "00000001", "off": "00000000", "auto": "on"}
    },
    {
      "id": "irc8m_div2",
      "label": "IRC8M/2",
      "kind": "divider",
