{
  "schema": 1,
  "id": "esp32c2",
  "title": "ESP32-C2 clock tree",
  "vendor": "Espressif",
  "source": "ESP32-C2 Technical Reference Manual (Reset and Clock); ESP-IDF rtc_clk.c",
  "devices": ["^ESP8684"],
  "fosc": "cpu",
  "inputs": {},
  "settings": [],
  "nodes": [
    {
      "id": "xtal",
      "label": "XTAL 40 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "XTAL 40 MHz", "mul": 40000000}
      ]
    },
    {
      "id": "pll",
      "label": "PLL 480 MHz",
      "kind": "source",
      "x": 0,
      "y": 1,
      "options": [
        {"id": "on", "label": "PLL 480 MHz", "mul": 480000000}
      ],
      "tooltip": "Powered up and calibrated by SystemInit when the CPU clock uses it."
    },
    {
      "id": "cpu",
      "label": "CPU clock",
      "kind": "mux",
      "x": 2,
      "y": 0,
      "options": [
        {"id": "xtal", "label": "XTAL 40 MHz", "from": "xtal", "set": {"SYSTEM_SYSCLK_CONF.SOC_CLK_SEL": "00000000"}},
        {"id": "pll_80", "label": "PLL 80 MHz", "from": "pll", "set": {"SYSTEM_SYSCLK_CONF.SOC_CLK_SEL": "00000400", "SYSTEM_CPU_PER_CONF.CPUPERIOD_SEL": "00000000"}, "div": 6},
        {"id": "pll_120", "label": "PLL 120 MHz", "from": "pll", "set": {"SYSTEM_SYSCLK_CONF.SOC_CLK_SEL": "00000400", "SYSTEM_CPU_PER_CONF.CPUPERIOD_SEL": "00000001"}, "div": 4}
      ],
      "consumer": true,
      "max": 120000000,
      "tooltip": "CPU frequencies supported by the ESP-IDF clock driver; FOSC_KHZ_VALUE follows this node."
    }
  ]
}
