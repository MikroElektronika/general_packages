{
  "schema": 1,
  "id": "esp32h2",
  "title": "ESP32-H2 clock tree",
  "vendor": "Espressif",
  "source": "ESP32-H2 Technical Reference Manual (Reset and Clock); ESP-IDF rtc_clk.c",
  "devices": ["^ESP32-H2"],
  "fosc": "cpu",
  "inputs": {},
  "settings": [],
  "nodes": [
    {
      "id": "xtal",
      "label": "XTAL 32 MHz",
      "kind": "source",
      "x": 0,
      "y": 0,
      "options": [
        {"id": "on", "label": "XTAL 32 MHz", "mul": 32000000}
      ]
    },
    {
      "id": "pll",
      "label": "PLL 96 MHz",
      "kind": "source",
      "x": 0,
      "y": 1,
      "options": [
        {"id": "on", "label": "PLL 96 MHz", "mul": 96000000}
      ],
      "tooltip": "Powered up and calibrated by SystemInit when the CPU clock uses it."
    },
    {
      "id": "flash_pll",
      "label": "FLASH_PLL 64 MHz",
      "kind": "source",
      "x": 0,
      "y": 2,
      "options": [
        {"id": "on", "label": "FLASH_PLL 64 MHz", "mul": 64000000}
      ],
      "tooltip": "Powered up and calibrated by SystemInit when the CPU clock uses it."
    },
    {
      "id": "cpu",
      "label": "CPU clock",
      "kind": "mux",
      "x": 2,
      "y": 0,
      "options": [
        {"id": "xtal", "label": "XTAL 32 MHz", "from": "xtal", "set": {"PCR_SYSCLK_CONF.SOC_CLK_SEL": "00000000", "PCR_CPU_FREQ_CONF.CPU_DIV_NUM": "00000000"}},
        {"id": "pll_48", "label": "PLL 96 MHz / 2 = 48 MHz", "from": "pll", "set": {"PCR_SYSCLK_CONF.SOC_CLK_SEL": "00010000", "PCR_CPU_FREQ_CONF.CPU_DIV_NUM": "00000001"}, "div": 2},
        {"id": "flash_pll_64", "label": "FLASH_PLL 64 MHz", "from": "flash_pll", "set": {"PCR_SYSCLK_CONF.SOC_CLK_SEL": "00030000", "PCR_CPU_FREQ_CONF.CPU_DIV_NUM": "00000000"}},
        {"id": "pll_96", "label": "PLL 96 MHz", "from": "pll", "set": {"PCR_SYSCLK_CONF.SOC_CLK_SEL": "00010000", "PCR_CPU_FREQ_CONF.CPU_DIV_NUM": "00000000"}}
      ],
      "consumer": true,
      "max": 96000000,
      "tooltip": "CPU frequencies supported by the ESP-IDF clock driver; FOSC_KHZ_VALUE follows this node."
    }
  ]
}
